def get_unique_filename(base_name):
    if not os.path.exists(base_name): return base_name
    filename, ext = os.path.splitext(base_name)
    counter = 1
    new_name = f"{filename}_{counter}{ext}"
    while os.path.exists(new_name):
        counter += 1
        new_name = f"{filename}_{counter}{ext}"
    return new_name

def main():
    warnings.filterwarnings("ignore")
    try: oracledb.init_oracle_client(lib_dir=INSTANT_CLIENT_DIR)
    except: pass

    file_name = get_unique_filename("2026-Medilux_rentabel.xlsx")
    conn = oracledb.connect(user=DB_USER, password=DB_PASS, dsn=DB_DSN)
    
    with pd.ExcelWriter(file_name, engine='xlsxwriter') as writer:
        workbook = writer.book
        money_fmt = workbook.add_format({'num_format': '#,##0.00', 'border': 1, 'align': 'right'})
        text_fmt = workbook.add_format({'border': 1, 'align': 'left'})

        jobs = [
            (SQL_XIDMET, 'Xidmet_2026', {
                "AY": "Ay", "SOBE_ADI": "İcra edən şöbə", "NOVBE": "Növbə tipi", "X_SAYI": "Xəstə sayı", 
                "XID_SAYI": "Xidmət sayı", "ODE_MEB": "Ödənişli məbləğ", "ODE_EDVSIZ": "ƏDV-siz ödənişli",
                "TESK_MEB": "Təşkilat məbləği", "TESK_EDVSIZ": "ƏDV-siz təşkilat"
            }),
            (SQL_DERMAN, 'Derman_2026', {
                "AY": "Ay", "NOVBE": "Növbə tipi", "DEPO_ADI": "Şöbə anbar", "ODE_X_SAYI": "Ödənişli xəstə",
                "SIG_X_SAYI": "Sığortalı xəstə", "TOP_X_SAYI": "Ümumi xəstə", "ODE_MEB": "Ödənişli məbləğ",
                "ODE_ALIS": "Ödənişli alış", "SIG_MEB": "Sığortalı məbləğ", "SIG_ALIS": "Sığortalı alış",
                "TOP_MEB": "Ümumi məbləğ"
            }),
            (SQL_HAKEDIS, 'Hakedis_2026', {
                "AY": "Ay", "NOVBE": "Növbə tipi", "SOBE": "Şöbə adı", "X_SAYI": "Xəstə sayı",
                "TOP_XID_MEB": "Ümumi xidmət məbləği", "ODE_MEB": "Ödənişli məbləğ", 
                "SIG_MEB": "Sığortalı məbləğ", "HK_QAZANC": "Həkim qazancı (ümumi)"
            })
        ]

        for sql, sheet, col_map in jobs:
            df = pd.read_sql(sql, conn)
            df = df.fillna(0)
            df.rename(columns=col_map, inplace=True)
            
            # Məlumatları yazırıq
            df.to_excel(writer, sheet_name=sheet, startrow=1, header=False, index=False)
            
            worksheet = writer.sheets[sheet]
            (max_row, max_col) = df.shape
            
            # Sütun ayarları və SUM funksiyası
            column_settings = []
            for i, col_name in enumerate(df.columns):
                setting = {'header': col_name}
                if i == 0:
                    setting['total_string'] = 'Cəmi' 
                elif i >= 3: 
                    setting['total_function'] = 'sum'
                    setting['format'] = money_fmt
                column_settings.append(setting)

            # Cədvəli yaradırıq
            worksheet.add_table(0, 0, max_row + 1, max_col - 1, {
                'columns': column_settings,
                'style': 'Table Style Medium 9',
                'total_row': True, 
                'name': sheet.replace(" ", "_")
            })

            worksheet.set_column(0, 2, 18, text_fmt)
            worksheet.set_column(3, max_col - 1, 20, money_fmt)
            worksheet.freeze_panes(1, 0)

    conn.close()
    print(f"🚀 Tamamlandı! Fayl: {os.path.abspath(file_name)}")

if __name__ == "__main__":
    main()
