SQL_XIDMET = """
SELECT
  TO_CHAR(T.HI_TARIH, 'YYYY-MM') AS AY,
  T.SR_ADI AS SOBE_ADI,
  CASE 
    WHEN T.HI_ETAR IS NULL THEN 'Bilinmir'
    WHEN TRUNC(T.HI_ETAR) - TRUNC(T.HI_ETAR, 'IW') = 6 THEN 'Növbə'
    WHEN TRUNC(T.HI_ETAR) - TRUNC(T.HI_ETAR, 'IW') = 5 THEN 
      CASE WHEN TO_CHAR(T.HI_ETAR, 'HH24:MI:SS') >= '08:00:00' AND TO_CHAR(T.HI_ETAR, 'HH24:MI:SS') <= '14:00:00' THEN 'Gündüz' ELSE 'Növbə' END
    ELSE 
      CASE WHEN TO_CHAR(T.HI_ETAR, 'HH24:MI:SS') >= '08:00:00' AND TO_CHAR(T.HI_ETAR, 'HH24:MI:SS') <= '17:00:00' THEN 'Gündüz' ELSE 'Növbə' END
  END AS NOVBE,
  COUNT(DISTINCT T.HK_ID) AS X_SAYI,
  SUM(NVL(T.HI_MIKTAR,0)) AS XID_SAYI,
  ROUND(SUM(NVL(T.HI_HTUTAR,0)), 2) AS ODE_MEB,
  ROUND(SUM(NVL(T.HI_HTUTAR,0))/1.18, 2) AS ODE_EDVSIZ,
  ROUND(SUM(NVL(T.HI_KTUTAR,0)), 2) AS TESK_MEB,
  ROUND(SUM(NVL(T.HI_KTUTAR,0))/1.18, 2) AS TESK_EDVSIZ
FROM fonethbys.V_IST_GENEL_HIZMET T
WHERE T.HI_TARIH >= TO_DATE('2026-01-01', 'YYYY-MM-DD') AND T.HI_TARIH <= TO_DATE('2026-12-31', 'YYYY-MM-DD')
GROUP BY TO_CHAR(T.HI_TARIH, 'YYYY-MM'), T.SR_ADI, 
  (CASE WHEN T.HI_ETAR IS NULL THEN 'Bilinmir' WHEN TRUNC(T.HI_ETAR)-TRUNC(T.HI_ETAR,'IW')=6 THEN 'Növbə' WHEN TRUNC(T.HI_ETAR)-TRUNC(T.HI_ETAR,'IW')=5 THEN (CASE WHEN TO_CHAR(T.HI_ETAR,'HH24:MI:SS') BETWEEN '08:00:00' AND '14:00:00' THEN 'Gündüz' ELSE 'Növbə' END) ELSE (CASE WHEN TO_CHAR(T.HI_ETAR,'HH24:MI:SS') BETWEEN '08:00:00' AND '17:00:00' THEN 'Gündüz' ELSE 'Növbə' END) END)
"""

