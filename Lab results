async def send_to_telegram(pdf_path, barkod_id, hasta_adi, branch_name, islemno, retries=3):
    """PDF dosyasını Telegram'a gönderir, Flood Control üçün gözləmə əlavə edilib."""
    # Hər mesaja göndərməzdən əvvəl məcburi 4 saniyə gözləmə (Spam filterinə düşməmək üçün)
    await asyncio.sleep(4) 
    
    for attempt in range(1, retries + 1):
        try:
            bot = telegram.Bot(token=BOT_TOKEN)
            with open(pdf_path, 'rb') as file:
                await bot.send_document(
                    chat_id=CHAT_ID,
                    document=file,
                    caption=f"🏥 Filial: {branch_name}\n🔬 Laboratuvar Sonuçları - Barkod ID: {barkod_id}\n👤 Hasta: {hasta_adi}\n💳 Kart Nömrəsi: {islemno}\n📅 Tarih: {datetime.now().strftime('%d.%m.%Y %H:%M')}"
                )
            print(f"PDF Telegram'a göndərildi ({branch_name} - Barkod ID {barkod_id})")
            return True
        except RetryAfter as e:
            # Əgər Telegram bizi yenə də bloklasa, onun tələb etdiyi saniyə qədər gözləyib yenidən cəhd edirik
            wait_time = int(e.retry_after) + 2
            print(f"Telegram limiti! {wait_time} saniyə gözlənilir...")
            await asyncio.sleep(wait_time)
        except TimedOut as e:
            print(f"Telegram göndərmə zaman aşımı (deneme {attempt}/{retries}, Barkod ID {barkod_id}): {e}")
            if attempt < retries:
                await asyncio.sleep(5)
        except TelegramError as e:
            print(f"Telegram göndərmə xətası (Barkod ID {barkod_id}): {e}")
            return False
        except Exception as e:
            print(f"Beklenmeyen xəta (Barkod ID {barkod_id}): {e}")
            return False
    print(f"Bütün denemeler başarısız oldu. Telegram'a göndərilə bilmədi (Barkod ID {barkod_id}).")
    return False

async def process_all_barkods():
    """Bütün filialları gəzir və nəticələri işləyir."""
    total_success = 0
    total_failure = 0

    for branch in BRANCHES:
        print(f"\n==========================================")
        print(f"🏥 {branch['name']} filialı yoxlanılır...")
        print(f"==========================================")
        
        barkod_ids = fetch_all_barkod_ids(branch["config"], branch["name"])
        if not barkod_ids:
            print(f"[{branch['name']}] filialında onaylanmış heç bir BARKODID tapılmadı.")
            continue

        for barkod_id in barkod_ids:
            try:
                print(f"\nBarkod ID {barkod_id} işlənir...")
                # Verilənləri çək
                data = fetch_lab_results(barkod_id, branch["config"], branch["name"])
                if data:
                    # PDF yarat
                    pdf_path = create_pdf(barkod_id, data)
                    if pdf_path:
                        print(f"PDF uğurla saxlanıldı: {pdf_path} (Barkod ID {barkod_id})")
                        # Telegram'a göndər
                        if await send_to_telegram(pdf_path, barkod_id, data['hasta_adi'], branch['name'], data['islemno']):
                            total_success += 1
                        else:
                            total_failure += 1
                    else:
                        print(f"PDF yaradıla bilmədi (Barkod ID {barkod_id}).")
                        total_failure += 1
                else:
                    print(f"Verilənlər çəkilə bilmədi (Barkod ID {barkod_id}).")
                    total_failure += 1
            except Exception as e:
                print(f"Xəta baş verdi (Barkod ID {barkod_id}): {e}")
                total_failure += 1

    print(f"\n✅ Proses tamamlandı: Cəmi {total_success} uğurlu, {total_failure} uğursuz hesabat göndərildi.")

def main():
    # Bütün filialları işlət
    asyncio.run(process_all_barkods())

if __name__ == "__main__":
    main()
