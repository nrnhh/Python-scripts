def fetch_all_barkod_ids(db_config, branch_name):
    """Bugün onaylanmış bütün BARKODID-ləri çəkir."""
    try:
        connection = oracledb.connect(**db_config)
        cursor = connection.cursor()
        
        cursor.execute("""
            SELECT DISTINCT BARKODID
            FROM fonethbys.V_LIS_PRINT_RAPORSONUC
            WHERE TUPID IN (13, 10, 16)
            AND SONUC IS NOT NULL
            AND TRUNC(ONAY_TAR) = TRUNC(SYSDATE)
        """)
        
        barkod_ids = [row[0] for row in cursor.fetchall()]
        cursor.close()
        connection.close()
        
        print(f"[{branch_name}] Ümumi {len(barkod_ids)} BARKODID tapıldı. Bütün nəticələr işlənəcək.")
        
        return barkod_ids
        
    except oracledb.DatabaseError as e:
        print(f"[{branch_name}] BARKODID-ləri çəkmə xətası: {e}")
        return []

def fetch_lab_results(barkod_id, db_config, branch_name):
    """Veritabanından laboratuvar sonuçlarını ve hasta bilgilerini çeker."""
    try:
        # Veritabanına bağlan
        print(f"[{branch_name}] Barkod ID {barkod_id} üçün verilənlər çəkilir...")
        connection = oracledb.connect(**db_config)
        cursor = connection.cursor()

        # Hasta bilgilerini çek (ISLEMNO əlavə edildi)
        print(f"[{branch_name}] Barkod ID {barkod_id} için hasta bilgileri çekiliyor...")
        try:
            cursor.execute("""
                SELECT ADSOYAD, TCKIMLIKNO, NULL AS HK_TELEFON, YAS, CINSIYET, ISTEM_TARIH, ISLEMNO
                FROM fonethbys.V_LIS_PRINT_RAPORBASLIK
                WHERE BARKODID = :barkod_id
            """, {"barkod_id": barkod_id})
            hasta_bilgileri = cursor.fetchone()
            if not hasta_bilgileri:
                print(f"[{branch_name}] Hata: Barkod ID {barkod_id} için hasta bilgisi bulunamadı.")
                hasta_adi, tckimlik, hasta_telefon, yas, cins, istem_tarih, islemno = "Bilinmiyor", "Bilinmiyor", "Bilinmiyor", "Bilinmiyor", "Bilinmiyor", None, "Bilinmiyor"
            else:
                hasta_adi, tckimlik, hasta_telefon, yas, cins, istem_tarih, islemno = hasta_bilgileri
        except oracledb.DatabaseError as e:
            print(f"[{branch_name}] Hasta bilgisi sorgusu başarısız: {e}. Fallback deneniyor...")
            cursor.execute("""
                SELECT ADSOYAD, TCKIMLIKNO, NULL AS HK_TELEFON, YAS, CINSIYET, ISTEM_TARIH, ISLEMNO
                FROM fonethbys.V_LIS_PRINT_RAPORBASLIK
                WHERE BARKODID = :barkod_id
            """, {"barkod_id": barkod_id})
            hasta_bilgileri = cursor.fetchone()
            if not hasta_bilgileri:
                hasta_adi, tckimlik, hasta_telefon, yas, cins, istem_tarih, islemno = "Bilinmiyor", "Bilinmiyor", "Bilinmiyor", "Bilinmiyor", "Bilinmiyor", None, "Bilinmiyor"
            else:
                hasta_adi, tckimlik, hasta_telefon, yas, cins, istem_tarih, islemno = hasta_bilgileri

        print(f"[{branch_name}] Hasta bulundu: {hasta_adi}, TC: {tckimlik}, Kart No: {islemno}")

        # Laboratuvar sonuçlarını çek ve tüp adına göre grupla
        print(f"[{branch_name}] Barkod ID {barkod_id} üçün laboratuvar nəticələri çəkilir...")
        cursor.execute("""
            SELECT TUPLABADI, TETKIKADI, SONUC AS SONUC1, NDMIN || '-' || NDMAX AS REFERANSDEGER, UNITE, KOHNE_NETICE
            FROM fonethbys.V_LIS_PRINT_RAPORSONUC
            WHERE BARKODID = :barkod_id AND TUPID IN (13, 10, 16)
            ORDER BY TUPLABADI, TETKIKADI
        """, {"barkod_id": barkod_id})
        lab_sonuclar = cursor.fetchall()
        if not lab_sonuclar:
            print(f"[{branch_name}] Uyarı: Barkod ID {barkod_id} üçün laboratuvar nəticəsi tapılmadı.")

        # Tüp adına göre grupla
        grouped_results = {}
        for row in lab_sonuclar:
            tup_adi = row[0] if row[0] else "Bilinmiyor"
            if tup_adi not in grouped_results:
                grouped_results[tup_adi] = []
            grouped_results[tup_adi].append({
                "test_adi": row[1],
                "sonuc": row[2],
                "referans": row[3],
                "birim": row[4],
                "kohne_netice": row[5] if row[5] else "N/A"
            })

        # Rapor başlığını çek
        rapor_tarih = None
        try:
            cursor.execute("""
                SELECT ADSOYAD, ISTEM_TARIH
                FROM fonethbys.V_LIS_PRINT_RAPORBASLIK
                WHERE BARKODID = :barkod_id
            """, {"barkod_id": barkod_id})
            rapor_baslik = cursor.fetchone()
            if rapor_baslik:
                rapor_tarih = rapor_baslik[1]
        except oracledb.DatabaseError as e:
            print(f"[{branch_name}] Rapor başlığı sorgusu başarısız (Barkod ID {barkod_id}): {e}.")

        cursor.close()
        connection.close()
        print(f"[{branch_name}] Veritabanı bağlantısı bağlandı (Barkod ID {barkod_id}).")

        return {
            "hasta_adi": hasta_adi,
            "hasta_telefon": hasta_telefon if hasta_telefon else "Bilinmiyor",
            "tckimlik": tckimlik,
            "yas": yas if yas else "Bilinmiyor",
            "cins": cins if cins else "Bilinmiyor",
            "islemno": islemno if islemno else "Bilinmiyor",
            "istem_tarih": istem_tarih,
            "rapor_tarih": rapor_tarih if rapor_tarih else datetime.now(),
            "grouped_results": grouped_results
        }

    except oracledb.DatabaseError as e:
        print(f"[{branch_name}] Veritabanı xətası (Barkod ID {barkod_id}): {e}")
        return None
    except ValueError as e:
        print(f"[{branch_name}] Xəta (Barkod ID {barkod_id}): {e}")
        return None

