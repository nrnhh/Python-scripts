                                           "HKURUMADI"])
        yrows = pd.DataFrame(yat, columns=["SR_ADI", "QRUP", "HK_ID", "GIRIS", "CIKIS"])
        data[branch] = _demo_aggregate(rows, yrows, cfg, rng)
        status.append({"FILIAL": branch, "OK": True, "SANIYE": 0.0, "XETA": ""})
    return data, status


def _demo_aggregate(rows, yrows, cfg, rng):
    IN = set(all_depts(cfg))
    rows["AMT"] = rows["H"] + rows["K"]
    rows["PAY"] = [pay_class(a, b) for a, b in zip(rows["HSINIFADI"], rows["HKURUMADI"])]
    rows["SIG"] = np.where(rows["PAY"] == "SIG", rows["K"], 0.0)
    rows["ITS"] = np.where(rows["PAY"] == "ITS", rows["K"], 0.0)
    rows["KORP"] = np.where(rows["PAY"] == "KORP", rows["K"], 0.0)
    x = rows[rows["SR_ADI"].isin(IN)].copy()
    # yeni = pasiyentin ilk müraciəti (dövrdən əvvəl tarixçəsi olanların ~45%-i)
    adm = x.groupby("HK_ID").agg(KAY=("HK_KAYITKODU", "first"), DT=("HI_TARIH", "min")).reset_index()
    adm = adm.sort_values(["DT", "HK_ID"])
    prior = set(pd.Series(adm["KAY"].unique()).sample(frac=0.45, random_state=1))
    adm["YENI"] = (~adm["KAY"].duplicated() & ~adm["KAY"].isin(prior)).astype(int)
    x = x.merge(adm[["HK_ID", "YENI"]], on="HK_ID")

    def levels(df, col):
        return pd.concat([df.assign(SEVIYYE="S", OBYEKT=df[col]),
                          df.assign(SEVIYYE="Q", OBYEKT=df["QRUP"]),
                          df.assign(SEVIYYE="F", OBYEKT="ALL", QRUP="ALL")])

    L = levels(x, "SR_ADI")
    L["AMB"] = L["HK_ID"].where(L["HK_HASTATURU"].str.startswith("A"))
    L["STAS"] = L["HK_ID"].where(L["HK_HASTATURU"].str.startswith("Y"))
    L["YID"] = L["HK_ID"].where(L["YENI"] == 1)
    L["TID"] = L["HK_ID"].where(L["YENI"] == 0)
    met = L.groupby(["SEVIYYE", "OBYEKT"]).agg(
        QRUP=("QRUP", "max"), AMB_QEBUL=("AMB", "nunique"), STAS_QEBUL=("STAS", "nunique"),
        CEMI_QEBUL=("HK_ID", "nunique"), YENI_QEBUL=("YID", "nunique"), TEKRAR_QEBUL=("TID", "nunique"),
        UNIKAL_PASIYENT=("HK_KAYITKODU", "nunique"), HEKIM_SAYI=("PERSKODU", "nunique"),
        XIDMET_SATIRI=("HK_ID", "size"), SATIS=("AMT", "sum"), NAGD=("H", "sum"),
        SIGORTA=("SIG", "sum"), ITS=("ITS", "sum"), KORPORATIV=("KORP", "sum")).reset_index()
    Y = levels(yrows, "SR_ADI")
    yk = Y.groupby(["SEVIYYE", "OBYEKT", "HK_ID"]).agg(GIRIS=("GIRIS", "min"), CIKIS=("CIKIS", "max"),
                                                       ACIQ=("CIKIS", lambda s: int(s.isna().any()))).reset_index()
    yk["LOS"] = np.where(yk["ACIQ"] == 0, ((pd.to_datetime(yk["CIKIS"]).dt.normalize()
                                            - pd.to_datetime(yk["GIRIS"]).dt.normalize()).dt.days).clip(lower=1), np.nan)
    ya = yk.groupby(["SEVIYYE", "OBYEKT"]).agg(HOSP_SAYI=("HK_ID", "size"), HELE_YATAN=("ACIQ", "sum"),
                                                ORTA_YATIS=("LOS", "mean")).reset_index()
    ya["TAXIS_SAYI"] = ya["HOSP_SAYI"] - ya["HELE_YATAN"]
    met = met.merge(ya, on=["SEVIYYE", "OBYEKT"], how="left")

    hek = x.groupby(["SR_ADI", "PERSKODU"], dropna=False).agg(
        QRUP=("QRUP", "max"), PERSADI=("PERSADI", "max"), CEMI_QEBUL=("HK_ID", "nunique"),
        UNIKAL_PASIYENT=("HK_KAYITKODU", "nunique"), XIDMET_SATIRI=("HK_ID", "size"), SATIS=("AMT", "sum"),
        NAGD=("H", "sum"), SIGORTA=("SIG", "sum"), ITS=("ITS", "sum"), KORPORATIV=("KORP", "sum")).reset_index()

    x["AY"] = pd.to_datetime(x["HI_TARIH"]).dt.to_period("M").dt.to_timestamp()
    ay = pd.concat([x.groupby(["QRUP", "AY"]).agg(CEMI_QEBUL=("HK_ID", "nunique"), SATIS=("AMT", "sum")).reset_index(),
                    x.groupby("AY").agg(CEMI_QEBUL=("HK_ID", "nunique"), SATIS=("AMT", "sum")).reset_index().assign(QRUP="ALL")])

    o = rows[rows["ISERVIS"].isin(IN) & ~rows["SR_ADI"].isin(IN)].copy()
    o["QRUP"] = o["ISERVIS"].map({d: g for g, ds in cfg["groups"].items() for d in ds})
    geden = o.groupby(["ISERVIS", "SR_ADI", "ITU_ADI", "IT_ADI"]).agg(
        QRUP=("QRUP", "max"), CEMI_QEBUL=("HK_ID", "nunique"), XIDMET_SATIRI=("HK_ID", "size"), SATIS=("AMT", "sum"),
        NAGD=("H", "sum"), SIGORTA=("SIG", "sum"), ITS=("ITS", "sum"), KORPORATIV=("KORP", "sum")).reset_index().rename(
        columns={"ISERVIS": "GONDEREN_SOBE", "SR_ADI": "ICRACI_SOBE"})
    i = x[x["ISERVIS"].notna() & ~x["ISERVIS"].isin(IN)]
    gelen = i.groupby(["ISERVIS", "SR_ADI", "ITU_ADI"]).agg(
        QRUP=("QRUP", "max"), CEMI_QEBUL=("HK_ID", "nunique"), XIDMET_SATIRI=("HK_ID", "size"),
        SATIS=("AMT", "sum")).reset_index().rename(columns={"ISERVIS": "GONDEREN_SOBE", "SR_ADI": "QEBUL_EDEN_SOBE"})
    dq = pd.DataFrame([{
        "SATIR": len(x), "SATIS": x["AMT"].sum(),
        "HEKIMSIZ_SATIR": int(x["PERSKODU"].isna().sum()), "HEKIMSIZ_SATIS": x.loc[x["PERSKODU"].isna(), "AMT"].sum(),
        "ISERVIS_BOS": int(x["ISERVIS"].isna().sum()), "MENFI_SATIR": int((x["AMT"] < 0).sum()),
        "MENFI_MEBLEG": x.loc[x["AMT"] < 0, "AMT"].sum(), "SIFIR_SATIR": int((x["AMT"] == 0).sum()),
        "SON_TARIX": x["HI_TARIH"].max()}])
    missed = pd.DataFrame([{"SR_ADI": "Pediatriya (köhnə)", "CEMI_QEBUL": 14, "SATIS": 612.4}]) \
        if rng.random() < 0.5 else pd.DataFrame(columns=["SR_ADI", "CEMI_QEBUL", "SATIS"])
    drug, drug_hek = _demo_drug(cfg, x, rng)
    ox = x[x["K"] != 0].groupby(["PAY", "HKURUMADI"]).agg(
        CEMI_QEBUL=("HK_ID", "nunique"), UNIKAL_PASIYENT=("HK_KAYITKODU", "nunique"),
        TESKILAT_XIDMET=("K", "sum"), PASIYENT_XIDMET=("H", "sum")).reset_index().rename(columns={"HKURUMADI": "KURUM"})
    klinik = pd.DataFrame({"SR_ADI": sorted(set(rows["SR_ADI"].dropna()) | {"Reanimasiya Şöbəsi"})})
    x["HY"] = x["AMT"] * 0.22
    x["HG"] = np.where(x["ISERVIS"].notna(), x["AMT"] * 0.05, 0.0)
    hak = x.groupby("SR_ADI").agg(HK_YAPAN=("HY", "sum"), HK_GONDEREN=("HG", "sum")).reset_index()
    hak_hek = x[x["PERSKODU"].notna()].groupby(["SR_ADI", "PERSKODU"]).agg(
        HDOKTORADI=("PERSADI", "max"), HK_YAPAN=("HY", "sum"), HK_GONDEREN=("HG", "sum")).reset_index()
    return {"hak": hak, "hak_hekim": hak_hek, "klinik": klinik, "org_xidmet": ox, "met": met, "hekim": hek, "ay": ay, "geden": geden, "gelen": gelen, "dq": dq, "missed": missed,
            "drug": drug, "drug_hekim": drug_hek}


def _demo_drug(cfg, x, rng):
    """Dərman sorğusunun nəticəsini təqlid edir (yalnız --demo)."""
    meds = [("Seftriakson 1q flakon", "flakon", 4.2), ("Natrium xlorid 0.9% 100ml", "şüşə", 1.1),
            ("Parasetamol 120mg/5ml şərbət", "şüşə", 3.5), ("Ampisillin 500mg", "flakon", 2.8),
            ("Kateter periferik 24G", "ədəd", 1.9), ("Surfaktant (Kurosurf) 120mg", "flakon", 410.0),
            ("Kofein sitrat 20mg/ml", "ampul", 9.5), ("Deksametazon 4mg", "ampul", 0.9),
            ("Salbutamol nebula 2.5mg", "ampul", 0.7), ("İnfuziya sistemi", "ədəd", 0.8),
            ("Şpris 5ml", "ədəd", 0.12), ("Əlcək steril", "cüt", 0.35), ("Vankomisin 500mg", "flakon", 14.0),
            ("Meropenem 1q", "flakon", 18.5), ("Qlükoza 10% 250ml", "şüşə", 1.6)]
    vol = defaultdict(lambda: 1.0, {"PED": 1.0, "NEO": 1.6, "TTY": 0.9, "FIZ": 0.05})
    dests = [("Teserrufat Tullanti Anbar", 0.35), ("Derman Tullantı Anbarı", 0.1), ("Xüsusi Layihə X", 0.03),
             ("Müvəqqəti inventar saxlama deposu", 0.25), ("Reanimasiya Şöbəsi", 0.1),
             ("OFİS LƏVAZİMATLARI TULLANTI ANBARI", 0.1), ("Salyan Məntəqə deposu", 0.1)]
    rows = []
    for g, ds in cfg["groups"].items():
        for d in ds:
            for name, unit, price in meds:
                k = vol[g] * rng.uniform(0.3, 1.7)
                q = max(int(rng.poisson(120 * k / max(price, 1) ** 0.5)), 0)
                if q == 0:
                    continue
                maya = round(q * price, 2)
                dep = d if rng.random() > 0.2 else "Poliklinika"          # bəzən ümumi depodan verilir
                rows.append((2, d, dep, None, "Paket Hariç", name, unit, q, q, round(maya * rng.uniform(1.4, 1.8), 2), maya))
                if rng.random() < 0.1:                                      # şöbənin deposu başqa şöbənin pasiyentinə
                    rows.append((2, "Ortopediya və Travmatologiya", d, None, "Paket Hariç", name, unit, q // 2, q // 2,
                                 round(maya * 0.8, 2), round(maya / 2, 2)))
                if rng.random() < 0.5:
                    rows.append((2, d, d, None, "Paket Dahil", name, unit, q // 3, q // 3, 0.0, round(maya / 3, 2)))
            if g in ("PED", "NEO", "TTY") and rng.random() < 0.6:
                for dn, w in dests:
                    if g != "TTY" and "Məntəqə" in dn:
                        continue
                    amt = round(rng.uniform(300, 4000) * w * vol[g], 2)
                    rows.append((3, None, d, dn, "Paket Hariç", "Müxtəlif sərf materialı", "ədəd", 10, 10, amt, amt))
                tot = sum(r[10] for r in rows if r[2] == d)
                rows.append((4, None, "Eczane Anbarı", d, "Paket Hariç", "Dərman təchizatı", "ədəd", 50, 50,
                             round(tot * 0.8, 2), round(tot * 0.8, 2)))
                rows.append((5, None, "Təsərruffat Anbarı", d, "Paket Hariç", "Təsərrüfat təchizatı", "ədəd", 30, 30,
                             round(tot * 0.15, 2), round(tot * 0.15, 2)))
    drug = pd.DataFrame(rows, columns=["FORMTYPE", "HSERVISADI", "DEPOADI", "CIKIS_YERI", "PAKET_DURUMU", "DERMAN_AD",
                                       "BIRIM", "SATIR", "MIQDAR", "SATIS", "MAYA"])
    p2 = drug["FORMTYPE"] == 2
    kind = rng.choice(["NAGD", "SIG", "ITS", "KORP"], p=[0.72, 0.2, 0.04, 0.04], size=len(drug))
    drug["PAY"] = np.where(p2, kind, None)
    drug["KURUM"] = [None if (not f or k == "NAGD") else (rng.choice(DEMO_INSURERS) if k == "SIG" else
                     ("İcbari tibbi sığorta" if k == "ITS" else rng.choice(DEMO_CORPS)))
                     for f, k in zip(p2, kind)]
    # həkim üzrə: dərman gəlirini həkimin xidmət payına görə bölürük
    p2 = drug[drug["FORMTYPE"] == 2].groupby(["HSERVISADI", "PAKET_DURUMU"])[["SATIS", "MAYA"]].sum().reset_index()
    w = x[x["PERSKODU"].notna()].groupby(["SR_ADI", "PERSKODU"]).agg(N=("HK_ID", "size"), AD=("PERSADI", "max")).reset_index()
    w["W"] = w["N"] / w.groupby("SR_ADI")["N"].transform("sum")
    dh = p2.merge(w, left_on="HSERVISADI", right_on="SR_ADI")
    dh["SATIS"] *= dh["W"]; dh["MAYA"] *= dh["W"]
    dh = dh.rename(columns={"AD": "HDOKTORADI"})[["SR_ADI", "PERSKODU", "HDOKTORADI", "PAKET_DURUMU", "SATIS", "MAYA"]]
    return drug, dh


