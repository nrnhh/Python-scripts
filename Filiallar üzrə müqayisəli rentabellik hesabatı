AID_SUBTITLE = "  ·  Dərman aidiyyəti: Panel → D8 seçiminə görə"


def drug_formulas(sheet, info):
    """Dərman sütunları üçün Excel düsturları: seçilmiş aidiyyət qaydasına görə 'Dərman — Məlumat' vərəqindən toplanır."""
    L, r0, r1 = info["letters"], info["r0"], info["r1"]
    D = lambda k: f"'{sheet}'!${L[k]}${r0}:${L[k]}${r1}"
    KEN, DAX = f',{D("PAKET")},"Paketdən kənar"', f',{D("PAKET")},"Paketə daxil"'

    def pick(val, by_i, by_v, extra):
        return (f'IF({AID_NAME}="{AID_OPTIONS[1]}",SUMIFS({D(val)},{D("FILIAL")},{{FILIAL}},{by_v}{extra}),'
                f'SUMIFS({D(val)},{D("FILIAL")},{{FILIAL}},{by_i}{extra}))')

    def family(by_i, by_v):
        f = {"DERMAN_GELIR": "=" + pick("D_SATIS", by_i, by_v, KEN),
             "DERMAN_MAYA": "=" + pick("MAYA", by_i, by_v, KEN),
             "PAKET_MAYA": "=" + pick("MAYA", by_i, by_v, DAX)}
        for k, lab in [("DERMAN_NAGD", "NAGD"), ("DERMAN_SIG", "SIG"), ("DERMAN_ITS", "ITS"), ("DERMAN_KORP", "KORP")]:
            f[k] = "=" + pick("D_SATIS", by_i, by_v, KEN + f',{D("ODENIS_NOVU")},"{PAY_LABEL[lab]}"')
        return f

    crit = '{QRUP_AD}'
    grp_crit = f'IF({crit}="{TOTAL_LABEL}","?*",{crit})'
    grp = family(f'{D("I_QRUP_AD")},{grp_crit}', f'{D("V_QRUP_AD")},{grp_crit}')
    sobe = family(f'{D("ISTEYEN")},{{SR_ADI}}', f'{D("DEPOADI")},{{SR_ADI}}')
    by_name = family(f'{D("ISTEYEN")},{{OBYEKT}}', f'{D("DEPOADI")},{{OBYEKT}}')
    by_grp = family(f'{D("I_QRUP_AD")},{{QRUP_AD}}', f'{D("V_QRUP_AD")},{{QRUP_AD}}')
    comp = {k: f'=IF({{NOV}}="{GROUP_SUBTOTAL}",{by_grp[k][1:]},{by_name[k][1:]})'
            for k in ("DERMAN_GELIR", "DERMAN_MAYA", "PAKET_MAYA")}
    return {"grp": grp, "sobe": sobe, "comp": comp}


