CUSTOM_EXCLUDE = ["KASSA", "VEZNE", "TESERRUF", "TƏSƏRRÜF", "TƏSƏRRUF", "DEPO", "ANBAR", "AMBAR", "TULLANT",
                  "CIHAZ", "ENVANTER", "INVENTAR", "TES."]
CUSTOM_DEPOT_HINT = ["TESERRUF", "TƏSƏRRÜF", "TƏSƏRRUF", "TES.", "DƏRMAN DEPO", "DERMAN DEPO"]
CUSTOM_DEPOT_EXCL = ["CIHAZ", "ENVANTER", "INVENTAR", "TULLANT"]


_FOLD = str.maketrans("ƏəÇçĞğIıİiÖöŞşÜüEe", "EECCGGIIIIOOSSUUEE")


def _fold(x):
    """Yazılış fərqlərinə həssas olmayan müqayisə: Peyvənd = Peyvend = PEYVƏND, Təcili = Tecili."""
    return " ".join(str(x or "").translate(_FOLD).upper().split())


def _set_groups(pairs):
    GROUPS[:] = pairs
    GROUP_LABEL.clear()
    GROUP_LABEL.update(dict(pairs))
    GROUP_ORDER[:] = [c for c, _ in pairs]


def select_standard(tokens):
    """Standart bölmələrdən seçim: kod və ya adın başlanğıcı ilə (məs. 'ped,neo' və ya '1,3')."""
    chosen = []
    for t in [x.strip() for x in re.split(r"[,;]", tokens) if x.strip()]:
        if t.isdigit() and 1 <= int(t) <= len(GROUPS):
            chosen.append(GROUPS[int(t) - 1][0])
            continue
        tn = _fold(t)
        hit = [c for c, lbl in GROUPS if _fold(c).startswith(tn) or _fold(lbl).startswith(tn)]
        if not hit:
            sys.exit(f"Bölmə tapılmadı: '{t}'. Mövcud bölmələr: " + ", ".join(l for _, l in GROUPS))
        chosen += hit
    keep = [c for c in GROUP_ORDER if c in chosen]
    _set_groups([(c, GROUP_LABEL[c]) for c in keep])
    for cfg in BRANCHES.values():
        cfg["groups"] = {g: d for g, d in cfg["groups"].items() if g in keep}
        cfg["depots"] = {g: d for g, d in cfg.get("depots", {}).items() if g in keep}


def select_custom(keywords, names_by_branch):
    """İstənilən şöbə(lər): hər açar söz ayrıca bölmə olur; hər filialda adında həmin söz olan şöbələr
    (kassa/depo/anbar xaric) və həmin şöbənin təsərrüfat/dərman depoları avtomatik tapılır."""
    kws = [k.strip() for k in re.split(r"[;,]", keywords) if k.strip()]
    pairs = [(f"G{i + 1}", k[:1].upper() + k[1:]) for i, k in enumerate(kws)]
    _set_groups(pairs)
    print("\nSeçilmiş şöbələr:")
    for b, cfg in BRANCHES.items():
        names = sorted(set(names_by_branch.get(b, [])))
        groups, depots, used = {}, {}, set()
        for code, kw in pairs:
            k = _fold(kw)
            hits = [n for n in names if k in _fold(n) and n not in used]
            ex = [_fold(x) for x in CUSTOM_EXCLUDE]
            dh, de = [_fold(x) for x in CUSTOM_DEPOT_HINT], [_fold(x) for x in CUSTOM_DEPOT_EXCL]
            groups[code] = [n for n in hits if not any(x in _fold(n) for x in ex)]
            depots[code] = [n for n in hits if any(x in _fold(n) for x in dh) and not any(x in _fold(n) for x in de)]
            used.update(groups[code] + depots[code])
        cfg["groups"], cfg["depots"] = groups, depots
        for code, kw in pairs:
            print(f"  [{b}] {kw}: " + (", ".join(groups[code]) or "— tapılmadı —") +
                  (f"  | depolar: {', '.join(depots[code])}" if depots[code] else ""))
    MISSED_DEPT_PATTERNS[:] = [k.upper() for k in kws]


def drop_empty_branches():
    for b in list(BRANCHES):
        if not all_depts(BRANCHES[b]):
            print(f"  [{b}] seçilmiş şöbə yoxdur — filial hesabata daxil edilmir")
            del BRANCHES[b]
            BRANCH_ORDER.remove(b)
    if not BRANCHES:
        sys.exit("Seçimə uyğun heç bir şöbə tapılmadı.")


def fetch_branch_names(demo):
    """Hər filialın bütün şöbə/depo adları (istənilən şöbə seçimi üçün)."""
    if demo:
        return {b: drug_names(c) + ["Reanimasiya Şöbəsi", "Reanimasiya Teserrufat", "Kassa-1"] for b, c in BRANCHES.items()}
    import oracledb
    oracledb.init_oracle_client(lib_dir=ORACLE_CLIENT_DIR)
    pw = os.environ.get("FONET_DB_PASS") or getpass.getpass(f"{DB_USER} üçün FONET parolu: ")
    os.environ["FONET_DB_PASS"] = pw
    out = {}
    for b, c in BRANCHES.items():
        try:
            with oracledb.connect(user=DB_USER, password=pw, dsn=c["dsn"]) as conn:
                out[b] = list(run_query(conn, "SELECT SR_ADI FROM FONETHBYSADM.H_SERVIS", {})["SR_ADI"].dropna())
        except Exception as e:
            print(f"  [{b}] şöbə siyahısı alınmadı: {str(e).splitlines()[0]}")
            out[b] = []
    return out


def interactive_selection():
    print("\nHesabat hansı şöbələr üzrə qurulsun?")
    print("  1) Standart: " + ", ".join(l for _, l in GROUPS))
    print("  2) Standart bölmələrdən seçim")
    print("  3) İstənilən şöbə(lər) — adını yazın (məs: Reanimasiya; Kardiologiya)")
    ch = input("Seçim [1]: ").strip() or "1"
    if ch == "2":
        for i, (_, l) in enumerate(GROUPS, 1):
            print(f"     {i}) {l}")
        return {"bolme": input("Nömrələr (məs: 1,3): ").strip()}
    if ch == "3":
        return {"sobe": input("Şöbə adları (; ilə ayırın): ").strip()}
    return {}


