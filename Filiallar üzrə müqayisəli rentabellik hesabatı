def write_table(ws, df, keys, title, subtitle, extra_formulas=None, databars=(), scales=(), tab=None,
                total_key="QRUP_AD", freeze_after=None):
    formulas = dict(FORMULAS, **(extra_formulas or {}))
    keys = [k for k in keys if k in df.columns or k in formulas]
    for k in keys:
        SHEET_KEYS.setdefault(k, [])
        if ws.title not in SHEET_KEYS[k]:
            SHEET_KEYS[k].append(ws.title)
        if k in formulas:
            FORMULA_KEYS.add(k)
    n = len(keys)
    last_col = get_column_letter(n)
    band(ws, f"A1:{last_col}1", title, size=14, bg=C_NAVY, height=30)
    ws.merge_cells(f"A2:{last_col}2")
    ws["A2"].value = subtitle
    ws["A2"].font = font(9, italic=True, color=C_MUTED)
    ws["A2"].alignment = Alignment(indent=1)
    hr, r0 = 4, 5
    letters = {k: get_column_letter(i + 1) for i, k in enumerate(keys)}
    r1 = r0 + max(len(df), 1) - 1

    for i, k in enumerate(keys, 1):
        c = ws.cell(row=hr, column=i, value=COLS[k][0])
        c.fill, c.font, c.border = fill(C_NAVY2), font(9, True, "FFFFFF"), BORDER
        c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    ws.row_dimensions[hr].height = 44

    if df.empty:
        ws.cell(row=r0, column=1, value="Bu dövr üçün məlumat yoxdur").font = font(10, italic=True, color=C_MUTED)
        return {"letters": letters, "r0": r0, "r1": r0}

    recs = df.to_dict("records")
    for j, rec in enumerate(recs):
        r = r0 + j
        is_total = rec.get(total_key) in (TOTAL_LABEL, GROUP_SUBTOTAL)
        rowfill = fill(C_TOTAL) if is_total else (fill(C_ZEBRA) if j % 2 else None)
        for i, k in enumerate(keys, 1):
            kind = COLS[k][1]
            if k in formulas and all(t in letters for t in re.findall(r"\{(?:COL:)?([A-Z_]+)\}", formulas[k])):
                f = formulas[k]
                f = re.sub(r"\{COL:([A-Z_]+)\}", lambda mm: f"${letters[mm.group(1)]}${r0}:${letters[mm.group(1)]}${r1}", f)
                f = re.sub(r"\{([A-Z_]+)\}", lambda mm: f"{letters[mm.group(1)]}{r}", f)
                val = f
            else:
                val = _pyval(rec.get(k))
            c = ws.cell(row=r, column=i, value=val)
            c.border = BORDER
            c.font = font(9, bold=is_total)
            if rowfill:
                c.fill = rowfill
            if kind == "auto":
                c.number_format = FMT["money"] if isinstance(val, float) else ("#,##0" if isinstance(val, int) else "@")
                c.alignment = Alignment(horizontal="right")
            elif kind == "text":
                c.alignment = Alignment(vertical="center", wrap_text=k in ("SERH",))
            else:
                c.number_format = FMT[kind]

    # sütun enləri
    for i, k in enumerate(keys, 1):
        L = get_column_letter(i)
        if COLS[k][1] == "text":
            mx = max([len(str(_pyval(v) or "")) for v in df[k]] + [10]) if k in df else 12
            ws.column_dimensions[L].width = min(max(mx + 3, 12), 60 if k == "SERH" else 38)
        else:
            ws.column_dimensions[L].width = 15 if COLS[k][1] in ("money", "auto") else 12.5

    for k in databars:
        if k in letters:
            L = letters[k]
            ws.conditional_formatting.add(f"{L}{r0}:{L}{r1}", DataBarRule(start_type="num", start_value=0,
                                                                          end_type="max", color="7FA7E8"))
    for k in scales:
        if k in letters:
            L = letters[k]
            ws.conditional_formatting.add(f"{L}{r0}:{L}{r1}", ColorScaleRule(
                start_type="min", start_color="F8D7DA", mid_type="percentile", mid_value=50,
                mid_color="FFFFFF", end_type="max", end_color="CDEFD9"))

    ws.auto_filter.ref = f"A{hr}:{last_col}{r1}"
    fa = freeze_after or next((i for i, k in enumerate(keys) if COLS[k][1] != "text"), 1)
    ws.freeze_panes = ws.cell(row=r0, column=fa + 1)
    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 90
    if tab:
        ws.sheet_properties.tabColor = tab
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth, ws.page_setup.fitToHeight = 1, 0
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.print_title_rows = f"{hr}:{hr}"
    ws.oddFooter.left.text = f"Hazırlayan: {PREPARED_BY}"
    ws.oddFooter.right.text = "&P / &N"
    return {"letters": letters, "r0": r0, "r1": r1}


def fmt_az(x, dec=0):
    s = f"{x:,.{dec}f}"
    return s.replace(",", " ").replace(".", ",")


def build_insights(m):
    cmp, met, hek, dq = m["cmp"], m["met"], m["hekim"], m["dq"]
    out = []
    if cmp.empty:
        return ["Məlumat yoxdur."]
    tot = met[met["SEVIYYE"] == "F"]
    T = tot["SATIS"].sum()
    br = tot.sort_values("SATIS", ascending=False)
    out.append(f"Xidmət satışı {fmt_az(T)} AZN. Ən böyük pay — {br.iloc[0]['FILIAL']} filialı "
               f"({br.iloc[0]['SATIS'] / T:.0%}); " +
               ", ".join(f"{r.FILIAL} {r.SATIS / T:.0%}" for r in br.iloc[1:].itertuples()) + ".")
    g = cmp[cmp["SEVIYYE"] == "Q"].sort_values("SATIS", ascending=False)
    top = g.iloc[0]
    out.append(f"Ən yüksək satışlı bölmə: {top['FILIAL']} — {top['QRUP_AD']}: {fmt_az(top['SATIS'])} AZN "
               f"(seçilmiş bölmələrin ümumi satışının {top['SATIS'] / T:.0%}-i).")
    gg = g[g["CEMI_QEBUL"] >= 50]
    if len(gg) > 1:
        hi, lo = gg.sort_values("ORTA_CEK").iloc[-1], gg.sort_values("ORTA_CEK").iloc[0]
        out.append(f"Orta çek: ən yüksək {hi['FILIAL']} — {hi['QRUP_AD']} ({fmt_az(hi['ORTA_CEK'], 2)} AZN), "
                   f"ən aşağı {lo['FILIAL']} — {lo['QRUP_AD']} ({fmt_az(lo['ORTA_CEK'], 2)} AZN); "
                   f"fərq {hi['ORTA_CEK'] / lo['ORTA_CEK']:.1f} dəfə.")
    s = tot.sort_values("SIG_PAY", ascending=False)
    its = ", ".join(f"{r.FILIAL} {r.ITS_PAY:.0%}" for r in tot.itertuples() if r.ITS_PAY >= 0.005)
    out.append("Xidmət satışında sığorta payı: " + ", ".join(f"{r.FILIAL} {r.SIG_PAY:.0%}" for r in s.itertuples()) +
               (f"; İcbari tibbi sığorta: {its}" if its else "") +
               f"; nağd (pasiyent) payı ən yüksək — {tot.sort_values('NAGD_PAY').iloc[-1]['FILIAL']}.")
    y = tot.sort_values("YENI_PAY", ascending=False)
    out.append("Yeni pasiyent payı: " +
               ", ".join(f"{r.FILIAL} {r.YENI_PAY:.0%}" for r in y.itertuples()) + ".")
    if m.get("has_hak") and "DOVRIYYE" in tot:
        CG, DV, HQ = tot["CEMI_GELIR"].sum(), tot["DOVRIYYE"].sum(), tot["HEKIM_QAZANC"].sum()
        out.append(f"Xalis dövriyyə {fmt_az(DV)} AZN — marja {DV / CG:.0%}; həkim qazancı satışın {HQ / CG:.0%}-i "
                   f"({fmt_az(HQ)} AZN). Filiallar üzrə marja: " +
                   ", ".join(f"{r.FILIAL} {r.DOVRIYYE_MARJA:.0%}" for r in tot.sort_values("DOVRIYYE_MARJA", ascending=False).itertuples()) + ".")
        gm = g[(g["CEMI_QEBUL"] >= 50) & (g["CEMI_GELIR"] > 0)].sort_values("DOVRIYYE_MARJA")
        if len(gm) > 1:
            lo, hi = gm.iloc[0], gm.iloc[-1]
            out.append(f"Ən rentabelli bölmə: {hi['FILIAL']} — {hi['QRUP_AD']} (marja {hi['DOVRIYYE_MARJA']:.0%}); "
                       f"ən aşağı: {lo['FILIAL']} — {lo['QRUP_AD']} ({lo['DOVRIYYE_MARJA']:.0%}).")
    if "DERMAN_GELIR" in tot and tot["DERMAN_GELIR"].sum() > 0:
        out.append("Qeyd: bu mətnlər standart 'İstəyən şöbə' qaydası ilə yazılıb; yuxarıdakı kartlar, cədvəllər və "
                   "qrafiklər D8-dəki seçimə görə dəyişir.")
    org = m.get("org", pd.DataFrame())
    if not org.empty:
