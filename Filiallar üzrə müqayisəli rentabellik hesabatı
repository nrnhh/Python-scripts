def font(size=10, bold=False, color="1F2937", italic=False):
    return Font(name=FONT, size=size, bold=bold, color=color, italic=italic)


def band(ws, rng, text, size=11, bg=C_NAVY2, fg="FFFFFF", height=22, align="left"):
    ws.merge_cells(rng)
    c = ws[rng.split(":")[0]]
    c.value = text
    c.fill, c.font = fill(bg), font(size, True, fg)
    c.alignment = Alignment(horizontal=align, vertical="center", indent=1, wrap_text=True)
    ws.row_dimensions[c.row].height = height
    return c


def _pyval(v):
    if v is None or (isinstance(v, float) and np.isnan(v)):
        return None
    if isinstance(v, (np.integer,)):
        return int(v)
    if isinstance(v, (np.floating,)):
        return float(v)
    if isinstance(v, pd.Timestamp):
        return v.to_pydatetime()
    try:
        if pd.isna(v):
            return None
    except (TypeError, ValueError):
        pass
    return v


