def build_workbook(m, start, end_incl, status, path):
    SHEET_KEYS.clear()
    FORMULA_KEYS.clear()
    wb = Workbook()
    S = {"dash": "Rəhbərlik Paneli", "cmp": "Filiallar üzrə Müqayisə", "dept": "Şöbələr üzrə İcmal",
         "rent": "Rentabellik", "drug": "Dərman Sərfi", "drugcomp": "Dərman — Bölmə Tərkibi", "drugtop": "Dərman Reytinqi", "org": "Təşkilatlar üzrə Satış",
         "hek": "Həkimlər üzrə Göstəricilər", "ay": "Aylıq Dinamika", "geden": "Göndərilən Yönləndirmələr",
         "gelen": "Daxil Olan Yönləndirmələr", "notes": "Metodologiya və Qeydlər",
         "drugaid": "Dərman — Aidiyyət", "drugdata": "Dərman — Məlumat"}
    ws_d = wb.active
    ws_d.title = S["dash"]
    for k in ["cmp", "rent", "dept", "drug", "drugcomp", "drugaid", "drugtop", "org", "hek", "ay", "geden", "gelen",
              "drugdata", "notes"]:
        wb.create_sheet(S[k])
    # Dərman aidiyyəti seçimi: Rəhbərlik Panelindəki açılan siyahı (D8) — bütün dərman düsturları ona baxır
    wb.defined_names[AID_NAME] = DefinedName(AID_NAME, attr_text=f"'{S['dash']}'!{AID_CELL_ABS}")
    dr_ = m.get("drug") or {}
    p12 = dr_.get("p12", pd.DataFrame())
    dd_info = write_table(wb[S["drugdata"]], p12, ["FILIAL", "ISTEYEN", "I_QRUP_AD", "DEPOADI", "V_QRUP_AD", "PAKET",
                                                    "ODENIS_NOVU", "SATIR", "D_SATIS", "MAYA"],
                          "DƏRMAN — MƏLUMAT: pasiyentə verilən dərmanlar (hər iki aidiyyət qaydası üçün)",
                          "Hər sətir: hansı şöbə istəyib, hansı depodan verilib. Panel və dərman vərəqlərindəki rəqəmlər "
                          "bu cədvəldən seçilmiş qaydaya görə toplanır. Boş bölmə — şöbə/depo hesabata daxil deyil.",
                          tab="7F8C8D", freeze_after=7, total_key="__yox__")
    DF = drug_formulas(S["drugdata"], dd_info) if not p12.empty else {}
    wb.create_sheet("_qrafik").sheet_state = "hidden"
    period = f"Dövr: {start:%d.%m.%Y} – {end_incl:%d.%m.%Y}  ·  Hazırlayan: {PREPARED_BY}  ·  Rəng şkalası: yaşıl — sütunda yüksək, qırmızı — aşağı göstərici"

    cmp_keys = ["QRUP_AD", "FILIAL", "AMB_QEBUL", "STAS_QEBUL", "CEMI_QEBUL", "UNIKAL_PASIYENT", "YENI_QEBUL",
                "TEKRAR_QEBUL", "YENI_PAY", "HEKIM_SAYI", "SATIS", "NAGD", "SIGORTA", "ITS", "KORPORATIV", "NAGD_PAY",
                "SIG_PAY", "ITS_PAY", "KORP_PAY", "ORTA_CEK", "FILIAL_PAY", "HOSP_SAYI", "HELE_YATAN", "TAXIS_SAYI", "ORTA_YATIS",
                "HEKIM_BASI_QEBUL", "HEKIM_BASI_SATIS",
                "DERMAN_GELIR", "DERMAN_NAGD", "DERMAN_SIG", "DERMAN_ITS", "DERMAN_KORP",
                "DERMAN_MAYA", "DERMAN_MARJA", "PAKET_MAYA", "SERFIYYAT", "DERMAN_XERC", "CEMI_GELIR"]
    if m.get("has_hak"):
        cmp_keys += ["HK_YAPAN", "HK_GONDEREN", "HEKIM_QAZANC", "DOVRIYYE", "DOVRIYYE_MARJA"]
    fil_pay = {"FILIAL_PAY": f'=IFERROR({{SATIS}}/SUMIFS({{COL:SATIS}},{{COL:FILIAL}},{{FILIAL}},{{COL:QRUP_AD}},"{TOTAL_LABEL}"),0)'}
    cmp_info = write_table(wb[S["cmp"]], m["cmp"], cmp_keys, "FİLİALLAR ÜZRƏ MÜQAYİSƏ — Bölmə qrupları", period,
                           extra_formulas={**fil_pay, **DF.get("grp", {})}, databars=["SATIS"], scales=["ORTA_CEK", "YENI_PAY", "HEKIM_BASI_SATIS"],
                           tab="2F5597", freeze_after=2)
    dept_keys = ["FILIAL", "QRUP_AD", "SR_ADI"] + cmp_keys[2:] + ["QEBUL_BASI_DERMAN"]
    # Şöbə vərəqində "Filial cəmi" sətri yoxdur; satış toplanan olduğu üçün filialın şöbələr cəmi = filial cəmi
    dept_fil_pay = {"FILIAL_PAY": "=IFERROR({SATIS}/SUMIFS({COL:SATIS},{COL:FILIAL},{FILIAL}),0)"}
    write_table(wb[S["dept"]], m["dept"], dept_keys, "ŞÖBƏLƏR ÜZRƏ İCMAL", period,
                extra_formulas={**dept_fil_pay, **DF.get("sobe", {})},
                databars=["SATIS"], scales=["ORTA_CEK"], tab="00A3A1", freeze_after=3)
    hek_keys = ["FILIAL", "QRUP_AD", "SR_ADI", "PERSADI", "CEMI_QEBUL", "UNIKAL_PASIYENT", "XIDMET_SATIRI",
                "SATIS", "NAGD", "SIGORTA", "ITS", "KORPORATIV", "ORTA_CEK", "SOBE_PAY", "SOBE_RANK",
                "DERMAN_GELIR", "DERMAN_MAYA", "MARJA_PAY"] + (["HEKIM_QAZANC"] if m.get("has_hak") else [])
    hek_f = {"SOBE_PAY": "=IFERROR({SATIS}/SUMIFS({COL:SATIS},{COL:FILIAL},{FILIAL},{COL:SR_ADI},{SR_ADI}),0)",
             "SOBE_RANK": '=COUNTIFS({COL:FILIAL},{FILIAL},{COL:SR_ADI},{SR_ADI},{COL:SATIS},">"&{SATIS})+1'}
    write_table(wb[S["hek"]], m["hekim"], hek_keys, "HƏKİMLƏR ÜZRƏ GÖSTƏRİCİLƏR", period, extra_formulas=hek_f,
                databars=["SATIS", "CEMI_QEBUL"], scales=["ORTA_CEK"], tab="F28E2B", freeze_after=4)
    drug_keys = ["QRUP_AD", "FILIAL", "CEMI_QEBUL", "HOSP_SAYI", "SATIS", "DERMAN_GELIR", "CEMI_GELIR", "DERMAN_PAY",
                 "DERMAN_NAGD", "DERMAN_SIG", "DERMAN_ITS", "DERMAN_KORP",
                 "DERMAN_NAGD_PAY", "DERMAN_SIG_PAY", "DERMAN_ITS_PAY", "DERMAN_KORP_PAY",
                 "DERMAN_MAYA", "DERMAN_MARJA", "MARJA_PAY", "PAKET_MAYA", "SERFIYYAT", "DERMAN_XERC",
                 "QEBUL_BASI_DERMAN", "TECHIZAT", "KORP_MENTEQE"]
    if m.get("has_hak"):
        write_table(wb[S["rent"]], m["cmp"],
                    ["QRUP_AD", "FILIAL", "CEMI_QEBUL", "SATIS", "DERMAN_GELIR", "CEMI_GELIR", "DERMAN_MAYA",
                     "PAKET_MAYA", "SERFIYYAT", "DERMAN_XERC", "HK_YAPAN", "HK_GONDEREN", "HEKIM_QAZANC", "HEKIM_PAY",
                     "DOVRIYYE", "DOVRIYYE_MARJA", "DOVRIYYE_QEBUL"],
                    "RENTABELLİK — satış, dərman xərci, həkim qazancı və xalis dövriyyə", period + AID_SUBTITLE,
                    extra_formulas=DF.get("grp", {}),
                    databars=["DOVRIYYE"], scales=["DOVRIYYE_MARJA", "DOVRIYYE_QEBUL"], tab="F5B700", freeze_after=2)
    else:
        ws_r = wb[S["rent"]]
        band(ws_r, "A1:H1", "RENTABELLİK", size=14, bg=C_NAVY, height=30)
        ws_r["A3"] = "Həkim qazancı məlumatı alınmadığı üçün bu vərəq boşdur (nəzarət faylına baxın)."
    write_table(wb[S["drug"]], m["cmp"], drug_keys, "DƏRMAN SƏRFİ — satış, ödəniş növü, marja və xərc",
                period + AID_SUBTITLE + "  ·  Bölmələrin tərkibi — 'Dərman — Bölmə Tərkibi', iki qaydanın müqayisəsi — 'Dərman — Aidiyyət' vərəqində",
                extra_formulas=DF.get("grp", {}),
                databars=["DERMAN_XERC"], scales=["MARJA_PAY", "QEBUL_BASI_DERMAN"], tab="DB2777", freeze_after=2)
    write_table(wb[S["drugcomp"]], m.get("drug_comp", pd.DataFrame()),
                ["FILIAL", "QRUP_AD", "OBYEKT", "NOV", "DERMAN_GELIR", "DERMAN_MAYA", "PAKET_MAYA", "SERFIYYAT",
                 "DERMAN_XERC", "QRUP_PAY", "TECHIZAT"],
                "DƏRMAN — BÖLMƏLƏRİN TƏRKİBİ: hər bölməyə hansı şöbə və depolar birləşdirilib",
                period + AID_SUBTITLE + "  ·  'Bölmə cəmi' sətri 'Dərman Sərfi' vərəqindəki həmin bölmənin rəqəminə bərabərdir",
                extra_formulas={**DF.get("comp", {}),
                                "QRUP_PAY": f'=IFERROR({{DERMAN_XERC}}/SUMIFS({{COL:DERMAN_XERC}},{{COL:FILIAL}},{{FILIAL}},'
                                            f'{{COL:QRUP_AD}},{{QRUP_AD}},{{COL:NOV}},"{GROUP_SUBTOTAL}"),0)'},
                tab="DB2777", freeze_after=4, total_key="NOV")
    aid = dr_.get("aid", pd.DataFrame())
    write_table(wb[S["drugaid"]], aid, ["FILIAL", "QRUP_AD", "I_SATIS", "V_SATIS", "FERQ_SATIS", "I_MAYA", "V_MAYA",
                                        "AIDIYYET_IZAH"],
                "DƏRMAN AİDİYYƏTİ — 'İstəyən şöbə' və 'Verən depo' qaydalarının müqayisəsi",
                "İstəyən şöbə: dərman pasiyenti təyin edən şöbəyə yazılır (standart). Verən depo: dərman fiziki olaraq "
                "çıxdığı depoya yazılır. Seçim — 'Rəhbərlik Paneli' vərəqində, D8 xanası.",
                extra_formulas={"FERQ_SATIS": "={V_SATIS}-{I_SATIS}"}, databars=["I_SATIS", "V_SATIS"],
                tab="DB2777", freeze_after=2)
    dtop = (m.get("drug") or {}).get("top", pd.DataFrame())
    write_table(wb[S["drugtop"]], dtop, ["FILIAL", "QRUP_AD", "DERMAN_RANK", "DERMAN_AD", "BIRIM", "MIQDAR",
                                         "DERMAN_GELIR", "DERMAN_XERC", "QRUP_PAY"],
                "DƏRMAN REYTİNQİ — hər bölmədə xərcə görə ilk 15 dərman", period,
