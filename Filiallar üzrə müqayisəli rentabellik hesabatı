def _div(a, b):
    a = pd.to_numeric(a, errors="coerce"); b = pd.to_numeric(b, errors="coerce")
    return (a / b.replace(0, np.nan)).fillna(0.0)


def _derive(df):
    if df.empty:
        return df
    for c in ["SATIS", "NAGD", "SIGORTA", "ITS", "KORPORATIV"]:
        if c in df:
            df[c] = pd.to_numeric(df[c], errors="coerce").fillna(0.0).round(2)
    if "CEMI_QEBUL" in df and "SATIS" in df:
        df["ORTA_CEK"] = _div(df["SATIS"], df["CEMI_QEBUL"])
    if "NAGD" in df:
        df["NAGD_PAY"] = _div(df["NAGD"], df["SATIS"])
        df["SIG_PAY"] = _div(df["SIGORTA"], df["SATIS"])
        if "ITS" in df:
            df["ITS_PAY"] = _div(df["ITS"], df["SATIS"])
        df["KORP_PAY"] = _div(df["KORPORATIV"], df["SATIS"])
    if "YENI_QEBUL" in df:
        df["YENI_PAY"] = _div(df["YENI_QEBUL"], df["CEMI_QEBUL"])
    if "HEKIM_SAYI" in df:
        df["HEKIM_BASI_QEBUL"] = _div(df["CEMI_QEBUL"], df["HEKIM_SAYI"])
        df["HEKIM_BASI_SATIS"] = _div(df["SATIS"], df["HEKIM_SAYI"])
    if "DERMAN_GELIR" in df:
        for c in [x for x in DRUG_MEASURES if x in df]:
            df[c] = pd.to_numeric(df[c], errors="coerce").fillna(0.0).round(2)
        df["DERMAN_MARJA"] = df["DERMAN_GELIR"] - df["DERMAN_MAYA"]
        df["MARJA_PAY"] = _div(df["DERMAN_MARJA"], df["DERMAN_GELIR"])
        for c in ["DERMAN_NAGD", "DERMAN_SIG", "DERMAN_ITS", "DERMAN_KORP"]:
            if c in df:
                df[c + "_PAY"] = _div(df[c], df["DERMAN_GELIR"])
        if "PAKET_MAYA" in df:
            df["DERMAN_XERC"] = df["DERMAN_MAYA"] + df["PAKET_MAYA"] + df.get("SERFIYYAT", 0)
        if "SATIS" in df:
            df["CEMI_GELIR"] = df["SATIS"] + df["DERMAN_GELIR"]
            df["DERMAN_PAY"] = _div(df["DERMAN_GELIR"], df["CEMI_GELIR"])
        if "CEMI_QEBUL" in df and "DERMAN_XERC" in df:
            df["QEBUL_BASI_DERMAN"] = _div(df["DERMAN_XERC"], df["CEMI_QEBUL"])
    if "HK_YAPAN" in df:
        for c in ["HK_YAPAN", "HK_GONDEREN"]:
            df[c] = pd.to_numeric(df[c], errors="coerce").fillna(0.0).round(2)
        df["HEKIM_QAZANC"] = df["HK_YAPAN"] + df["HK_GONDEREN"]
        if "CEMI_GELIR" in df:
            df["HEKIM_PAY"] = _div(df["HEKIM_QAZANC"], df["CEMI_GELIR"])
        if "CEMI_GELIR" in df and "DERMAN_XERC" in df:
            df["DOVRIYYE"] = df["CEMI_GELIR"] - df["DERMAN_XERC"] - df["HEKIM_QAZANC"]
            df["DOVRIYYE_MARJA"] = _div(df["DOVRIYYE"], df["CEMI_GELIR"])
            if "CEMI_QEBUL" in df:
                df["DOVRIYYE_QEBUL"] = _div(df["DOVRIYYE"], df["CEMI_QEBUL"])
    return df


def _qlabel(code):
    return TOTAL_LABEL if code == "ALL" else GROUP_LABEL.get(code, "Təsnifatsız")


def _order(df, by_group_first=True):
    df = df.copy()
    df["_g"] = df["QRUP"].map(lambda c: GROUP_ORDER.index(c) if c in GROUP_ORDER else 99)
    df["_b"] = df["FILIAL"].map(BRANCH_ORDER.index)
    keys = ["_g", "_b"] if by_group_first else ["_b", "_g"]
    return df.sort_values(keys + (["SATIS"] if "SATIS" in df else []),
                          ascending=[True, True] + ([False] if "SATIS" in df else [])).drop(columns=["_g", "_b"])


def month_days(ay, start, end_incl):
    m0 = ay.date().replace(day=1)
    m1 = (pd.Timestamp(m0) + pd.offsets.MonthEnd(0)).date()
    lo, hi = max(m0, start.date()), min(m1, end_incl.date())
    return max((hi - lo).days + 1, 0)


DRUG_MEASURES = ["DERMAN_GELIR", "DERMAN_MAYA", "PAKET_MAYA", "SERFIYYAT", "KORP_MENTEQE", "TECHIZAT", "INV_CIXIS",
                 "OTURME", "TESNIFSIZ", "DERMAN_NAGD", "DERMAN_SIG", "DERMAN_ITS", "DERMAN_KORP"]


def _norm(x):
    return str(x or "").upper().replace("İ", "I")


def classify_dest(dest, clinical=None):
    """Şöbə deposundan 'digər çıxış'ın (növ 3) istiqaməti — hədəf deponun adına və statusuna görə.
    Qayda bütün filiallar üçün eynidir və hər dəfə avtomatik tətbiq olunur:
      1) korporativ məntəqə  2) inventar  3) tullantı/imha -> şöbə sərfiyyatı
      4) hədəf — dövrdə xidməti olan klinik şöbədir və ya depo/anbardır -> ötürmə (xərc deyil)
      5) heç birinə uyğun deyil -> 'Təsnif olunmayıb' (xərcə daxil edilmir, nəzarət faylında ⚠)"""
    u = _norm(dest)
    if any(k in u for k in DRUG_CORP_KEYS):
        return "Korporativ məntəqə"
    if any(k in u for k in DRUG_INV_KEYS):
        return "İnventar yerdəyişməsi"
    if any(k in u for k in DRUG_WASTE_KEYS):
        return "Şöbə sərfiyyatı"
    if clinical is None or dest in clinical or any(k in u for k in DRUG_DEPOT_KEYS):
        return "Şöbələrarası ötürmə"
    return "Təsnif olunmayıb"


def build_drug(data):
    """Dərman çıxışlarını bölmə/şöbəyə bağlayır və göstəricilərə çevirir (bütün məbləğlər toplanandır)."""
    lines, dests, bal, p12_all = [], [], [], []
    for b, d in data.items():
        df = d.get("drug")
        if df is None or df.empty:
            continue
        cfg = BRANCHES[b]
        n2g = name_to_group(cfg)
        df = df.copy()
        for c in ["SATIS", "MAYA", "MIQDAR", "SATIR"]:
            df[c] = pd.to_numeric(df[c], errors="coerce").fillna(0.0)
        df["FORMTYPE"] = pd.to_numeric(df["FORMTYPE"], errors="coerce").fillna(0).astype(int)
        dahil = df["PAKET_DURUMU"].astype(str).str.upper().str.contains("DAH")
        for c in DRUG_MEASURES:
            df[c] = 0.0
        df["OBYEKT"] = None
        df["SINIF"] = None
        # 1-2: pasiyentə — istəyən şöbəyə; istəyən boşdursa, verən depoya
        p = df["FORMTYPE"].isin([1, 2])
        own = df["HSERVISADI"].where(df["HSERVISADI"].isin(n2g.keys()))
        own = own.fillna(df["DEPOADI"].where(df["HSERVISADI"].isna() & df["DEPOADI"].isin(n2g.keys())))
        df.loc[p, "OBYEKT"] = own[p]
        df.loc[p & ~dahil, "DERMAN_GELIR"] = df.loc[p & ~dahil, "SATIS"]
        df.loc[p & ~dahil, "DERMAN_MAYA"] = df.loc[p & ~dahil, "MAYA"]
        df.loc[p & dahil, "PAKET_MAYA"] = df.loc[p & dahil, "MAYA"]
        if "PAY" not in df:
            df["PAY"] = "NAGD"
        if "KURUM" not in df:
            df["KURUM"] = None
        pay = df["PAY"].fillna("KORP")
        for k in ["NAGD", "SIG", "ITS", "KORP"]:
            mk = p & ~dahil & (pay == k)
            df.loc[mk, "DERMAN_" + k] = df.loc[mk, "SATIS"]
        # 3: şöbə deposundan digər çıxış — istiqamətə görə
        t3 = (df["FORMTYPE"] == 3) & df["DEPOADI"].isin(n2g.keys())
        df.loc[t3, "OBYEKT"] = df.loc[t3, "DEPOADI"]
        kl = d.get("klinik")
        clinical = set(kl["SR_ADI"].dropna()) if kl is not None and not kl.empty else None
        df.loc[t3, "SINIF"] = df.loc[t3, "CIKIS_YERI"].map(lambda x: classify_dest(x, clinical))
        col = {"Şöbə sərfiyyatı": "SERFIYYAT", "Korporativ məntəqə": "KORP_MENTEQE",
               "İnventar yerdəyişməsi": "INV_CIXIS", "Şöbələrarası ötürmə": "OTURME", "Təsnif olunmayıb": "TESNIFSIZ"}
        for k, c in col.items():
            mk = t3 & (df["SINIF"] == k)
            df.loc[mk, c] = df.loc[mk, "MAYA"]
        # 4-5: şöbəyə təchizat (məlumat üçün)
        t45 = df["FORMTYPE"].isin([4, 5]) & df["CIKIS_YERI"].isin(n2g.keys())
        df.loc[t45, "OBYEKT"] = df.loc[t45, "CIKIS_YERI"]
        df.loc[t45, "TECHIZAT"] = df.loc[t45, "MAYA"]
        df["QRUP"] = df["OBYEKT"].map(n2g)
        df["FILIAL"] = b
        ours = df[df["OBYEKT"].notna()]
        lines.append(ours)
        # pasiyentə çıxışlar (növ 1-2) — həm istəyən şöbəyə, həm verən depoya görə aidiyyət üçün
        p12 = df[p & (df["HSERVISADI"].isin(n2g.keys()) | df["DEPOADI"].isin(n2g.keys()))].copy()
        if not p12.empty:
            p12["ISTEYEN"] = p12["HSERVISADI"].fillna(p12["DEPOADI"])
            p12["I_QRUP_AD"] = p12["ISTEYEN"].map(n2g).map(lambda c: GROUP_LABEL.get(c) if isinstance(c, str) else None)
            p12["V_QRUP_AD"] = p12["DEPOADI"].map(n2g).map(lambda c: GROUP_LABEL.get(c) if isinstance(c, str) else None)
            p12["PAKET"] = np.where(dahil[p12.index], "Paketə daxil", "Paketdən kənar")
            p12["ODENIS_NOVU"] = np.where(dahil[p12.index], None, p12["PAY"].fillna("KORP").map(PAY_LABEL))
            p12["FILIAL"] = b
            p12_all.append(p12)
        g3 = ours[ours["FORMTYPE"] == 3].groupby(["DEPOADI", "CIKIS_YERI", "SINIF"], dropna=False)["MAYA"].sum().reset_index()
        dests.append(g3.assign(FILIAL=b))
        # depo balansı bölmə üzrə: daxil olan təchizat vs öz depolarından çıxan (pasiyentə + digər çıxış)
        dep_out = df[(df["FORMTYPE"].isin([1, 2, 3])) & df["DEPOADI"].isin(n2g.keys())].copy()
        dep_out["G"] = dep_out["DEPOADI"].map(n2g)
        cross = dep_out[dep_out["FORMTYPE"].isin([1, 2]) & ~dep_out["HSERVISADI"].isin(n2g.keys())
                        & dep_out["HSERVISADI"].notna()]
        sup = df[t45].assign(G=df.loc[t45, "CIKIS_YERI"].map(n2g))
        for g in sorted(set(sup["G"]) | set(dep_out["G"])):
            bal.append({"FILIAL": b, "QRUP": g,
                        "TECHIZAT": float(sup.loc[sup["G"] == g, "MAYA"].sum()),
                        "DEPO_CIXIS": float(dep_out.loc[dep_out["G"] == g, "MAYA"].sum()),
                        "BASQA_SOBEYE": float(cross.loc[cross["DEPOADI"].map(n2g) == g, "MAYA"].sum())})

    if not lines:
        return {}
    L = pd.concat(lines, ignore_index=True)
    lv = pd.concat([L.assign(SEVIYYE="S"),
                    L.assign(SEVIYYE="Q", OBYEKT=L["QRUP"]),
                    L.assign(SEVIYYE="F", OBYEKT="ALL", QRUP="ALL")])
    lvl = lv.groupby(["FILIAL", "SEVIYYE", "OBYEKT"]).agg(
        QRUP_D=("QRUP", "max"), **{c: (c, "sum") for c in DRUG_MEASURES}).reset_index()
    cons = L[L["FORMTYPE"].isin([1, 2, 3])].copy()
    cons["XERC"] = cons["DERMAN_MAYA"] + cons["PAKET_MAYA"] + cons["SERFIYYAT"]
    top = cons.groupby(["FILIAL", "QRUP", "DERMAN_AD", "BIRIM"], dropna=False).agg(
        MIQDAR=("MIQDAR", "sum"), DERMAN_GELIR=("DERMAN_GELIR", "sum"), DERMAN_XERC=("XERC", "sum")).reset_index()
    top = top[top["DERMAN_XERC"] > 0]
    top["QRUP_PAY"] = _div(top["DERMAN_XERC"], top.groupby(["FILIAL", "QRUP"])["DERMAN_XERC"].transform("sum"))
    top["DERMAN_RANK"] = top.groupby(["FILIAL", "QRUP"])["DERMAN_XERC"].rank(ascending=False, method="first").astype(int)
    top = top[top["DERMAN_RANK"] <= 15]
    top["QRUP_AD"] = top["QRUP"].map(_qlabel)
    top["_b"] = top["FILIAL"].map(BRANCH_ORDER.index)
    top["_g"] = top["QRUP"].map(lambda c: GROUP_ORDER.index(c) if c in GROUP_ORDER else 99)
    top = top.sort_values(["_b", "_g", "DERMAN_RANK"]).drop(columns=["_b", "_g"])
    top["DERMAN_AD"] = top["DERMAN_AD"].fillna("—")
    top["BIRIM"] = top["BIRIM"].fillna("—")
    # Mənbə detalları: hər məbləğin hansı şöbə/depodan, hansı çıxış növü ilə gəldiyi
    dl = L.copy()
    dah = dl["PAKET_DURUMU"].astype(str).str.upper().str.contains("DAH")
    dl["TIP"] = np.select(
        [dl["FORMTYPE"].isin([1, 2]) & ~dah, dl["FORMTYPE"].isin([1, 2]) & dah, dl["FORMTYPE"] == 3,
         dl["FORMTYPE"].isin([4, 5])],
        ["Pasiyentə satış (paketdən kənar)", "Paketə daxil (ayrıca satılmır)", dl["SINIF"].fillna("Digər çıxış"),
         "Təchizat (şöbəyə verilən)"], default="Digər")
    dl["XERCE_DAXIL"] = np.where(dl["TIP"].isin(["Pasiyentə satış (paketdən kənar)", "Paketə daxil (ayrıca satılmır)",
                                                 "Şöbə sərfiyyatı"]), "Bəli", "Xeyr")
    dl["D_SATIS"] = np.where(dl["TIP"] == "Pasiyentə satış (paketdən kənar)", dl["SATIS"], 0.0)
    dl["QRUP_AD"] = dl["QRUP"].map(_qlabel)
    dl["ODENIS_NOVU"] = dl["PAY"].map(PAY_LABEL).where(dl["FORMTYPE"].isin([1, 2]) & ~dah)
    dl["ISTEYEN"] = dl["HSERVISADI"]
    tord = {"Pasiyentə satış (paketdən kənar)": 0, "Paketə daxil (ayrıca satılmır)": 1, "Şöbə sərfiyyatı": 2,
            "Korporativ məntəqə": 3, "İnventar yerdəyişməsi": 4, "Şöbələrarası ötürmə": 5, "Təchizat (şöbəyə verilən)": 6}
    dl["_t"] = dl["TIP"].map(tord).fillna(9)
    dl["_b"] = dl["FILIAL"].map(BRANCH_ORDER.index)
    dl["_g"] = dl["QRUP"].map(lambda c: GROUP_ORDER.index(c) if c in GROUP_ORDER else 99)
    summ = dl.groupby(["_b", "_g", "_t", "FILIAL", "QRUP_AD", "OBYEKT", "TIP", "XERCE_DAXIL"], dropna=False).agg(
        SATIR=("SATIR", "sum"), D_SATIS=("D_SATIS", "sum"), MAYA=("MAYA", "sum")).reset_index()
    summ = summ.sort_values(["_b", "_g", "_t", "MAYA"], ascending=[True, True, True, False]).drop(columns=["_b", "_g", "_t"])
    det = dl.sort_values(["_b", "_g", "_t", "MAYA"], ascending=[True, True, True, False])
    det = det[["FILIAL", "QRUP_AD", "OBYEKT", "TIP", "XERCE_DAXIL", "ISTEYEN", "DEPOADI", "CIKIS_YERI", "DERMAN_AD",
               "BIRIM", "ODENIS_NOVU", "KURUM", "MIQDAR", "D_SATIS", "MAYA"]]
    for c in ["ISTEYEN", "DEPOADI", "CIKIS_YERI", "DERMAN_AD", "BIRIM", "ODENIS_NOVU", "KURUM"]:
        det[c] = det[c].fillna("—")
    org = L[(L["DERMAN_GELIR"] != 0) & L["PAY"].isin(["SIG", "ITS", "KORP"])]
    org = org.groupby(["FILIAL", "PAY", "KURUM"], dropna=False)["DERMAN_GELIR"].sum().reset_index().rename(
        columns={"DERMAN_GELIR": "DERMAN_TESKILAT"})
    return {"lvl": lvl, "top": top, "dest": pd.concat(dests, ignore_index=True) if dests else pd.DataFrame(),
            "bal": pd.DataFrame(bal), "lines": L, "org": org, "summ": summ, "det": det,
            "p12": _aidiyyet_data(p12_all), "aid": _aidiyyet_compare(p12_all)}


def _aidiyyet_data(parts):
    """'Dərman — Məlumat' vərəqi: pasiyentə çıxışlar, hər iki aidiyyət qaydası üçün sütunlarla."""
    if not parts:
        return pd.DataFrame()
    d = pd.concat(parts, ignore_index=True)
    keys = ["FILIAL", "ISTEYEN", "I_QRUP_AD", "DEPOADI", "V_QRUP_AD", "PAKET", "ODENIS_NOVU"]
    for k in keys:
        d[k] = d[k].astype(object).where(d[k].notna(), "\x00")
    g = d.groupby(keys).agg(SATIR=("SATIR", "sum"), D_SATIS=("SATIS", "sum"), MAYA=("MAYA", "sum")).reset_index()
    for k in keys:
        g[k] = g[k].replace("\x00", None)
    g["D_SATIS"] = np.where(g["PAKET"] == "Paketə daxil", 0.0, g["D_SATIS"]).round(2)
    g["MAYA"] = g["MAYA"].round(2)
    g["_b"] = g["FILIAL"].map(BRANCH_ORDER.index)
    return g.sort_values(["_b", "I_QRUP_AD", "ISTEYEN", "D_SATIS"], ascending=[True, True, True, False],
                         na_position="last").drop(columns=["_b"])


def _aidiyyet_compare(parts):
    """Hər filial × bölmə üçün iki qaydanın nəticəsi və fərqin hansı şöbə/depo axınlarından yarandığı."""
    if not parts:
        return pd.DataFrame()
    d = pd.concat(parts, ignore_index=True)
    k = d[d["PAKET"] == "Paketdən kənar"]
    rows = []
    for b in BRANCH_ORDER:
        kb, db = k[k["FILIAL"] == b], d[d["FILIAL"] == b]
        for g in GROUP_ORDER:
            lab = GROUP_LABEL[g]
            i_s, v_s = kb.loc[kb["I_QRUP_AD"] == lab, "SATIS"].sum(), kb.loc[kb["V_QRUP_AD"] == lab, "SATIS"].sum()
            i_m, v_m = db.loc[db["I_QRUP_AD"] == lab, "MAYA"].sum(), db.loc[db["V_QRUP_AD"] == lab, "MAYA"].sum()
            if not any([i_s, v_s, i_m, v_m]):
                continue
            out_ = kb[(kb["I_QRUP_AD"] == lab) & (kb["V_QRUP_AD"] != lab)].groupby(["ISTEYEN", "DEPOADI"])["SATIS"].sum()
            in_ = kb[(kb["V_QRUP_AD"] == lab) & (kb["I_QRUP_AD"] != lab)].groupby(["DEPOADI", "ISTEYEN"])["SATIS"].sum()
            txt = []
            for (sh, dp), v in out_.sort_values(ascending=False).head(3).items():
                if v >= 1:
                    txt.append(f"{sh} şöbəsi dərmanı {dp} deposundan alıb ({fmt_az(v)} AZN) — yalnız 'İstəyən şöbə' qaydasında bölməyə düşür")
            for (dp, sh), v in in_.sort_values(ascending=False).head(3).items():
                if v >= 1:
                    txt.append(f"{dp} deposu {sh} şöbəsinin pasiyentlərinə verib ({fmt_az(v)} AZN) — yalnız 'Verən depo' qaydasında bölməyə düşür")
            rows.append({"FILIAL": b, "QRUP_AD": lab, "I_SATIS": round(i_s, 2), "V_SATIS": round(v_s, 2),
                         "I_MAYA": round(i_m, 2), "V_MAYA": round(v_m, 2),
                         "AIDIYYET_IZAH": "; ".join(txt) if txt else "Bütün dərmanlar bölmənin öz depolarından verilib — iki qayda eynidir"})
    return pd.DataFrame(rows)


GROUP_SUBTOTAL = "Bölmə cəmi"


def build_drug_composition(met):
    """Hər bölməyə hansı şöbə və depoların birləşdirildiyini və hər birinin dərman payını göstərir."""
    if met is None or met.empty:
        return pd.DataFrame()
    S = met[met["SEVIYYE"] == "S"].set_index(["FILIAL", "OBYEKT"])
    cols = ["DERMAN_GELIR", "DERMAN_MAYA", "PAKET_MAYA", "SERFIYYAT", "TECHIZAT"]
    rows = []
    for b in BRANCH_ORDER:
        cfg = BRANCHES[b]
        for g in GROUP_ORDER:
            members = [(n, "Şöbə") for n in cfg["groups"].get(g, [])] + \
                      [(n, "Depo") for n in cfg.get("depots", {}).get(g, [])]
            if not members:
                continue
            part = []
            for n, kind in members:
                v = {c: float(S.loc[(b, n), c]) if (b, n) in S.index and c in S else 0.0 for c in cols}
                part.append({"FILIAL": b, "QRUP_AD": GROUP_LABEL[g], "OBYEKT": n, "NOV": kind, **v})
            pdf = pd.DataFrame(part)
            pdf["DERMAN_XERC"] = pdf["DERMAN_MAYA"] + pdf["PAKET_MAYA"] + pdf["SERFIYYAT"]
            tot = pdf["DERMAN_XERC"].sum()
            pdf["QRUP_PAY"] = pdf["DERMAN_XERC"] / tot if tot else 0.0
            pdf = pdf.sort_values(["DERMAN_XERC", "DERMAN_GELIR"], ascending=False)
            sub = {"FILIAL": b, "QRUP_AD": GROUP_LABEL[g], "OBYEKT": f"{GROUP_LABEL[g]} — cəmi ({len(members)} şöbə/depo)",
                   "NOV": GROUP_SUBTOTAL, **{c: pdf[c].sum() for c in cols + ["DERMAN_XERC"]}, "QRUP_PAY": 1.0 if tot else 0.0}
            rows.append(pd.concat([pdf, pd.DataFrame([sub])], ignore_index=True))
    return pd.concat(rows, ignore_index=True) if rows else pd.DataFrame()


def build_model(data, status, start, end_incl):
    def cat(name):
        parts = [d[name].assign(FILIAL=b) for b, d in data.items() if name in d and not d[name].empty]
        return pd.concat(parts, ignore_index=True) if parts else pd.DataFrame()

    m = {}
    met = cat("met")
    if not met.empty:
        for c in ["HOSP_SAYI", "TAXIS_SAYI", "HELE_YATAN", "ORTA_YATIS"]:
            met[c] = pd.to_numeric(met[c], errors="coerce").fillna(0)
    drug = build_drug(data)
    m["drug"] = drug
    # həkim qazancı — şöbə/bölmə/filial səviyyəsində (toplanan göstəricidir)
    hk_parts = []
    for b, d in data.items():
        h = d.get("hak")
        if h is None or h.empty:
            continue
        h = h.copy()
        h["QRUP"] = h["SR_ADI"].map(name_to_group(BRANCHES[b]))
        h = h[h["QRUP"].notna()]
        for c in ["HK_YAPAN", "HK_GONDEREN"]:
            h[c] = pd.to_numeric(h[c], errors="coerce").fillna(0.0)
        hk_parts.append(pd.concat([h.assign(SEVIYYE="S", OBYEKT=h["SR_ADI"]), h.assign(SEVIYYE="Q", OBYEKT=h["QRUP"]),
                                   h.assign(SEVIYYE="F", OBYEKT="ALL", QRUP="ALL")]).assign(FILIAL=b))
    m["has_hak"] = bool(hk_parts)
    if not met.empty:
        if hk_parts:
            hk = pd.concat(hk_parts).groupby(["FILIAL", "SEVIYYE", "OBYEKT"]).agg(
                QRUP_H=("QRUP", "max"), HK_YAPAN=("HK_YAPAN", "sum"), HK_GONDEREN=("HK_GONDEREN", "sum")).reset_index()
            met = met.merge(hk, on=["FILIAL", "SEVIYYE", "OBYEKT"], how="outer")
            met["QRUP"] = met["QRUP"].fillna(met["QRUP_H"])
            met = met.drop(columns=["QRUP_H"])
        for c in ["HK_YAPAN", "HK_GONDEREN"]:
            met[c] = pd.to_numeric(met[c], errors="coerce").fillna(0.0) if c in met else 0.0
    if not met.empty and drug:
        met = met.merge(drug["lvl"], on=["FILIAL", "SEVIYYE", "OBYEKT"], how="outer")
        met["QRUP"] = met["QRUP"].fillna(met["QRUP_D"])
        met = met.drop(columns=["QRUP_D"])
        num = [c for c in met.columns if c not in ("FILIAL", "SEVIYYE", "OBYEKT", "QRUP")]
        met[num] = met[num].apply(pd.to_numeric, errors="coerce").fillna(0.0)
    if not met.empty:
        for c in DRUG_MEASURES:
            if c not in met:
                met[c] = 0.0
        met["QRUP_AD"] = met["QRUP"].map(_qlabel)
        met = _derive(met)
    m["met"] = met
    m["drug_comp"] = build_drug_composition(met)
    m["cmp"] = _order(met[met["SEVIYYE"].isin(["Q", "F"])]) if not met.empty else met
    dept = met[met["SEVIYYE"] == "S"].rename(columns={"OBYEKT": "SR_ADI"}) if not met.empty else met
    m["dept"] = _order(dept, by_group_first=False) if not dept.empty else dept

    hek = cat("hekim")
    if not hek.empty:
        hek["QRUP_AD"] = hek["QRUP"].map(_qlabel)
        hek["PERSADI"] = hek["PERSADI"].fillna("— Həkim qeyd olunmayıb —")
        hek["PERSKODU"] = hek["PERSKODU"].map(lambda v: "—" if pd.isna(v) else str(v).strip())
        dh = cat("drug_hekim")
        if not dh.empty:
            dh["PERSKODU"] = dh["PERSKODU"].map(lambda v: "—" if pd.isna(v) else str(v).strip())
            # ehtiyat üsul: kod yoxdur -> eyni filial və şöbədə həkim adına görə xidmət həkiminin kodu tapılır
            nm = lambda x: " ".join(_norm(x).split())
            lookup = {(r.FILIAL, r.SR_ADI, nm(r.PERSADI)): r.PERSKODU for r in hek.itertuples() if r.PERSKODU != "—"}
            nokod = (dh["PERSKODU"] == "—") & dh["HDOKTORADI"].notna()
            dh.loc[nokod, "PERSKODU"] = [lookup.get((f, sr, nm(a)), "AD:" + nm(a)) for f, sr, a in
                                         dh.loc[nokod, ["FILIAL", "SR_ADI", "HDOKTORADI"]].itertuples(index=False)]
            dah = dh["PAKET_DURUMU"].astype(str).str.upper().str.contains("DAH")
            dh["DERMAN_GELIR"] = pd.to_numeric(dh["SATIS"], errors="coerce").fillna(0).where(~dah, 0.0)
            dh["DERMAN_MAYA"] = pd.to_numeric(dh["MAYA"], errors="coerce").fillna(0).where(~dah, 0.0)
            dh = dh.groupby(["FILIAL", "SR_ADI", "PERSKODU"]).agg(
                HDOKTORADI=("HDOKTORADI", "max"), DERMAN_GELIR=("DERMAN_GELIR", "sum"),
                DERMAN_MAYA=("DERMAN_MAYA", "sum")).reset_index()
            hek = hek.merge(dh, on=["FILIAL", "SR_ADI", "PERSKODU"], how="outer")
            hek["PERSADI"] = hek["PERSADI"].fillna(hek["HDOKTORADI"]).fillna("— Həkim qeyd olunmayıb —")
            n2g = {d: g for b in BRANCHES.values() for g, ds in b["groups"].items() for d in ds}
            hek["QRUP"] = hek["QRUP"].fillna(hek["SR_ADI"].map(n2g))
            hek["QRUP_AD"] = hek["QRUP"].map(_qlabel)
            hek = hek.drop(columns=["HDOKTORADI"])
        hh = cat("hak_hekim")
        if not hh.empty:
            hh["PERSKODU"] = hh["PERSKODU"].map(lambda v: "—" if pd.isna(v) else str(v).strip())
            nm = lambda x: " ".join(_norm(x).split())
            lookup = {(r.FILIAL, r.SR_ADI, nm(r.PERSADI)): r.PERSKODU for r in hek.itertuples() if r.PERSKODU != "—"}
            nokod = (hh["PERSKODU"] == "—") & hh["HDOKTORADI"].notna()
            hh.loc[nokod, "PERSKODU"] = [lookup.get((f, sr, nm(a)), "AD:" + nm(a)) for f, sr, a in
                                         hh.loc[nokod, ["FILIAL", "SR_ADI", "HDOKTORADI"]].itertuples(index=False)]
            for c in ["HK_YAPAN", "HK_GONDEREN"]:
                hh[c] = pd.to_numeric(hh[c], errors="coerce").fillna(0.0)
            hh = hh.groupby(["FILIAL", "SR_ADI", "PERSKODU"]).agg(
                HDOKTORADI=("HDOKTORADI", "max"), HK_YAPAN=("HK_YAPAN", "sum"), HK_GONDEREN=("HK_GONDEREN", "sum")).reset_index()
            hek = hek.merge(hh, on=["FILIAL", "SR_ADI", "PERSKODU"], how="outer")
            hek["PERSADI"] = hek["PERSADI"].fillna(hek["HDOKTORADI"]).fillna("— Həkim qeyd olunmayıb —")
            n2g = {d: g for b in BRANCHES.values() for g, ds in b["groups"].items() for d in ds}
            hek["QRUP"] = hek["QRUP"].fillna(hek["SR_ADI"].map(n2g))
            hek["QRUP_AD"] = hek["QRUP"].map(_qlabel)
            hek = hek.drop(columns=["HDOKTORADI"])
            num = [c for c in hek.columns if c not in ("FILIAL", "SR_ADI", "PERSKODU", "PERSADI", "QRUP", "QRUP_AD")]
            hek[num] = hek[num].apply(pd.to_numeric, errors="coerce").fillna(0)
            for c in ["CEMI_QEBUL", "UNIKAL_PASIYENT", "XIDMET_SATIRI", "SATIS", "NAGD", "SIGORTA", "ITS", "KORPORATIV",
                      "DERMAN_GELIR", "DERMAN_MAYA"]:
                hek[c] = pd.to_numeric(hek[c], errors="coerce").fillna(0)
        hek = _derive(hek)
        hek["_g"] = hek["QRUP"].map(lambda c: GROUP_ORDER.index(c) if c in GROUP_ORDER else 99)
        hek["_b"] = hek["FILIAL"].map(BRANCH_ORDER.index)
        hek = hek.sort_values(["_b", "_g", "SR_ADI", "SATIS"], ascending=[True, True, True, False]).drop(columns=["_g", "_b"])
        hek["SOBE_PAY"] = _div(hek["SATIS"], hek.groupby(["FILIAL", "SR_ADI"])["SATIS"].transform("sum"))
        hek["SOBE_RANK"] = hek.groupby(["FILIAL", "SR_ADI"])["SATIS"].rank(ascending=False, method="min").astype(int)
    m["hekim"] = hek

    ay = cat("ay")
    if not ay.empty:
        ay["AY"] = pd.to_datetime(ay["AY"])
        ay["QRUP_AD"] = ay["QRUP"].map(_qlabel)
        ay["GUN"] = ay["AY"].map(lambda a: month_days(a, start, end_incl))
        ay["AY_AD"] = ay["AY"].map(lambda a: f"{a.year}-{a.month:02d} {AZ_MONTHS[a.month - 1]}")
        ay["SATIS"] = pd.to_numeric(ay["SATIS"]).round(2)
        ay["GUNLUK_SATIS"] = _div(ay["SATIS"], ay["GUN"])
        ay["GUNLUK_QEBUL"] = _div(ay["CEMI_QEBUL"], ay["GUN"])
        ay["ORTA_CEK"] = _div(ay["SATIS"], ay["CEMI_QEBUL"])
        ay["_b"] = ay["FILIAL"].map(BRANCH_ORDER.index)
        ay["_g"] = ay["QRUP"].map(lambda c: GROUP_ORDER.index(c) if c in GROUP_ORDER else 99)
        ay = ay.sort_values(["_b", "_g", "AY"]).drop(columns=["_b", "_g"])
    m["ay"] = ay

    for k in ["geden", "gelen"]:
        df = cat(k)
        if not df.empty:
            df["QRUP_AD"] = df["QRUP"].map(_qlabel)
            df = _derive(df)
            df = df.sort_values(["FILIAL", "SATIS"], ascending=[True, False])
            for c in ["ITU_ADI", "IT_ADI"]:
                if c in df:
                    df[c] = df[c].fillna("—")
        m[k] = df

    ox = cat("org_xidmet")
    od = (drug or {}).get("org", pd.DataFrame())
    org = pd.DataFrame()
    if not ox.empty or not od.empty:
        if not ox.empty:
            ox["KURUM"] = ox["KURUM"].fillna("—")
        if not od.empty:
            od = od.copy(); od["KURUM"] = od["KURUM"].fillna("—")
        org = ox if od.empty else (od if ox.empty else ox.merge(od, on=["FILIAL", "PAY", "KURUM"], how="outer"))
        for c in ["CEMI_QEBUL", "UNIKAL_PASIYENT", "TESKILAT_XIDMET", "PASIYENT_XIDMET", "DERMAN_TESKILAT"]:
            org[c] = pd.to_numeric(org[c], errors="coerce").fillna(0.0) if c in org else 0.0
        org["TESKILAT_CEMI"] = org["TESKILAT_XIDMET"] + org["DERMAN_TESKILAT"]
        org["ORG_PAY"] = _div(org["TESKILAT_CEMI"], org.groupby("FILIAL")["TESKILAT_CEMI"].transform("sum"))
        org["ODENIS_NOVU"] = org["PAY"].map(PAY_LABEL)
        org["_b"] = org["FILIAL"].map(BRANCH_ORDER.index)
        org["_p"] = org["PAY"].map({"SIG": 0, "ITS": 1, "KORP": 2})
        org = org.sort_values(["_b", "_p", "TESKILAT_CEMI"], ascending=[True, True, False]).drop(columns=["_b", "_p"])
    m["org"] = org
    m["dq"] = build_dq(data, status, m, end_incl)
    m["status"] = status
    return m


def build_dq(data, status, m, end_incl):
    OK, WARN, ERR, INFO = "✔ Uğurlu", "⚠ Diqqət", "✖ Xəta", "ℹ Məlumat"
    rows = []

    def add(b, name, exp, fact, res, note=""):
        diff = (fact - exp) if isinstance(exp, (int, float)) and isinstance(fact, (int, float)) else None
        rows.append({"FILIAL": b, "YOXLAMA": name, "GOZLENILEN": exp, "FAKTIKI": fact, "FERQ": diff,
                     "NETICE": res, "SERH": note})

    met, hek = m["met"], m["hekim"]
    for st in status:
        b = st["FILIAL"]
        if not st["OK"]:
            add(b, "Məlumatların alınması", "Alındı", "Alınmadı", ERR, "Filial hesabata daxil DEYİL — səbəb konsol çıxışındadır")
            continue
        add(b, "Məlumatların alınması", "Alındı", "Alındı", OK, f"{st['SANIYE']} san")
        for qn, how in st.get("NOTES", []):
            label = {"drug": "Dərman çıxışı", "drug_hekim": "Həkim üzrə dərman", "missed": "Oxşar adlı şöbə axtarışı",
                     "org_xidmet": "Təşkilatlar üzrə satış", "kurum": "Təşkilat adı",
                     "klinik": "Klinik şöbələr siyahısı", "hak": "Həkim qazancı",
                     "hak_hekim": "Həkim üzrə qazanc", "hak_kod": "Həkim qazancında həkim kodu"}.get(qn, qn)
            if how == "alt":
                txt = {"drug_hekim": "Bu filialın bazasında həkim kodu yoxdur — dərman həkimə ad üzrə bağlanıb",
                       "hak_kod": "Həkim qazancı həkimə ad üzrə bağlanıb (view-da həkim kodu yoxdur)"}.get(
                    qn, "Təşkilat adı sütunu yoxdur — ödəniş növü pasiyent sinfi üzrə təyin olunub")
                add(b, f"{label} məlumatı", "Əsas üsul", "Ehtiyat üsul", INFO, txt)
            else:
                add(b, f"{label} məlumatı", "Alındı", "Alınmadı", WARN,
                    "Bu göstərici filial üzrə boş qalıb — səbəb konsol çıxışındadır")
        mb = met[met["FILIAL"] == b]
        tot = mb[mb["SEVIYYE"] == "F"]
        if tot.empty:
            add(b, "Dövr üzrə məlumat", "> 0 sətir", "0", WARN, "Seçilmiş şöbələrdə xidmət tapılmadı")
            continue
        t = tot.iloc[0]
        S = round(float(t["SATIS"]), 2)
        tol = max(0.05, 0.006 * int((mb["SEVIYYE"] == "S").sum()))  # yuvarlaqlaşdırma payı

        def eq(name, exp, fact, note):
            add(b, name, round(exp, 2), round(fact, 2), OK if abs(fact - exp) <= tol else ERR, note)

        eq("Ödəniş bölgüsü: Nağd + Sığorta + İTS + Korporativ = Xidmət satışı", S,
           float(t["NAGD"] + t["SIGORTA"] + t.get("ITS", 0) + t["KORPORATIV"]), "Hər manat bir ödəniş mənbəyinə aiddir")
        org = m.get("org", pd.DataFrame())
        if not org.empty and "TESKILAT_XIDMET" in org and (org["FILIAL"] == b).any():
            eq("Təşkilatlar cəmi (xidmət) = Sığorta + İTS + Korporativ", float(t["SIGORTA"] + t.get("ITS", 0) + t["KORPORATIV"]),
               float(org.loc[org["FILIAL"] == b, "TESKILAT_XIDMET"].sum()), "Hər təşkilat payı bir ödəniş növünə aiddir")
        add(b, "Yeni + Təkrar = Cəmi qəbul", int(t["CEMI_QEBUL"]), int(t["YENI_QEBUL"] + t["TEKRAR_QEBUL"]),
            OK if int(t["YENI_QEBUL"] + t["TEKRAR_QEBUL"]) == int(t["CEMI_QEBUL"]) else ERR, "Hər qəbul ya yeni, ya təkrardır")
        eq("Şöbələr cəmi satış = Filial cəmi", S, float(mb.loc[mb["SEVIYYE"] == "S", "SATIS"].sum()),
           "Satış toplanan göstəricidir — şöbələr üzrə cəm filial cəminə bərabər olmalıdır")
        eq("Bölmə qrupları cəmi satış = Filial cəmi", S, float(mb.loc[mb["SEVIYYE"] == "Q", "SATIS"].sum()),
           "Hər şöbə yalnız bir qrupa aiddir")
        if not hek.empty:
            eq("Həkimlər vərəqi cəmi = Filial cəmi", S, float(hek.loc[hek["FILIAL"] == b, "SATIS"].sum()),
               "Həkimi qeyd olunmayan sətirlər daxil")
        dq = data[b]["dq"].iloc[0] if not data[b]["dq"].empty else None
        if dq is not None:
            eq("Ayrıca nəzarət hesablaması ilə satış uyğunluğu", S, float(dq["SATIS"] or 0),
               "Müstəqil hesablama eyni məbləği verməlidir")
        dif = int(t["CEMI_QEBUL"] - t["AMB_QEBUL"] - t["STAS_QEBUL"])
        add(b, "Ambulator + Stasionar = Cəmi qəbul", int(t["CEMI_QEBUL"]), int(t["AMB_QEBUL"] + t["STAS_QEBUL"]),
            OK if dif == 0 else WARN, "" if dif == 0 else f"{dif} qəbulun xəstə tipi (ambulator/stasionar) təyin olunmayıb")
        if dq is not None:
            sh = float(dq["HEKIMSIZ_SATIS"] or 0) / S if S else 0
            add(b, "Həkimi qeyd olunmayan satış payı", "≤ 5%", f"{sh:.1%}", OK if sh <= 0.05 else WARN,
                f"{fmt_az(int(dq['HEKIMSIZ_SATIR'] or 0))} sətir, {fmt_az(float(dq['HEKIMSIZ_SATIS'] or 0), 2)} AZN")
            sh2 = float(dq["ISERVIS_BOS"] or 0) / float(dq["SATIR"] or 1)
            add(b, "Göndərən şöbəsi boş xidmətlər", "—", f"{sh2:.1%}", INFO,
                "Birbaşa müraciət; 'Daxil olan yönləndirmələr'ə daxil edilmir")
            mn = int(dq["MENFI_SATIR"] or 0)
            add(b, "Mənfi məbləğli (storno/qaytarma) sətirlər", 0, mn, OK if mn == 0 else WARN,
                f"Cəmi {fmt_az(float(dq['MENFI_MEBLEG'] or 0), 2)} AZN — satışdan çıxılıb" if mn else "")
            son = pd.to_datetime(dq["SON_TARIX"])
            add(b, "Son xidmət tarixi (aktuallıq)", end_incl.strftime("%d.%m.%Y"),
                son.strftime("%d.%m.%Y %H:%M") if pd.notna(son) else "—",
                OK if pd.notna(son) and son.date() >= end_incl.date() else WARN,
                "Dövrün son günü üzrə məlumat var" if pd.notna(son) and son.date() >= end_incl.date() else "Son gün(lər) üzrə məlumat yoxdur")
        found = set(mb.loc[mb["SEVIYYE"] == "S", "OBYEKT"])
        miss = [d for d in all_depts(BRANCHES[b]) if d not in found]
        add(b, "Konfiqurasiyadakı şöbələrin məlumatda tapılması", len(all_depts(BRANCHES[b])), len(found),
            OK if not miss else INFO, ("Dövrdə xidməti olmayan: " + ", ".join(miss)) if miss else "Bütün şöbələr tapıldı")
        ms = data[b].get("missed")
        if ms is not None and not ms.empty:
            ms = ms.sort_values("SATIS", ascending=False)
            txt = "; ".join(f"{r.SR_ADI} ({fmt_az(float(r.SATIS))} AZN)" for r in ms.head(8).itertuples())
            add(b, "Hesabata daxil edilməyən oxşar adlı şöbələr", 0, len(ms), WARN, txt + " — daxil edilməli olub-olmadığını yoxlayın")
        else:
            add(b, "Hesabata daxil edilməyən oxşar adlı şöbələr", 0, 0, OK, "Tapılmadı")
        add(b, "Hələ stasionarda olan pasiyentlər", "—", int(t["HELE_YATAN"]), INFO,
            "Orta yatış müddətinə daxil edilməyib (müalicə davam edir)")
