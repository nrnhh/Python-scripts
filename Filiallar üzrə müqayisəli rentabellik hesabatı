    if m.get("has_hak"):
        row += 1
        t4 = matrix(row, 2, "XALİS DÖVRİYYƏ, AZN  —  filial × bölmə", "DOVRIYYE", FMT["money0"], with_share=True)
        matrix(row, 10, "DÖVRİYYƏ MARJASI", ("DOVRIYYE", "CEMI_GELIR"), FMT["pct"], kind="ratio")
        row = t4 + 1
    ws.merge_cells(f"B{row}:O{row}")
    text(f"B{row}", "Qızılı xana — həmin bölmədə ən yüksək göstəriciyə malik filial.   ·   Bir müraciət bir neçə bölməni "
                    "əhatə edə bildiyi üçün qəbul sayında 'Filial cəmi' hər pasiyent müraciətini bir dəfə sayır.",
         8, color=MUTED, italic=True)
    ws.row_dimensions[row].height = 26
    row += 2

    # --- Əsas müşahidələr: tünd kart ---
    ws.merge_cells(f"B{row}:O{row}")
    text(f"B{row}", "ƏSAS MÜŞAHİDƏLƏR", 11, True, GOLD)
    ws.row_dimensions[row].height = 22
    for txt in build_insights(m):
        row += 1
        ws.merge_cells(f"B{row}:O{row}")
        for cc in range(2, 16):
            ws.cell(row=row, column=cc).fill = fill(CARD)
        text(f"B{row}", "◆   " + txt, 10, color=TXT, indent=1)
        ws.row_dimensions[row].height = 22
    row += 2

    ws.row_breaks.append(Break(id=row - 1))
    ws.merge_cells(f"B{row}:O{row}")
    text(f"B{row}", "QRAFİKLƏR", 11, True, GOLD)
    ws.row_dimensions[row].height = 22
    n_charts = add_charts(wb, ws, m, row + 1)
    end = row + 2 + ((n_charts + 1) // 2) * 19
    ws.merge_cells(f"B{end}:O{end}")
    text(f"B{end}", f"Hazırlayan: {PREPARED_BY}   ·   Bütün rəqəmlər '{S['cmp']}' vərəqindən canlı düsturla hesablanır; "
                    f"metodologiya — '{S['notes']}' vərəqində.", 8, color=MUTED, italic=True)

    # kətandan kənarı gizlət: ekranda yalnız panel görünür
    ws.column_dimensions.group("Q", "XFD", hidden=True)
    for rr in range(1, end + 3):
        if ws.row_dimensions[rr].height is None:
            ws.row_dimensions[rr].height = 15
    ws.sheet_format.zeroHeight = True

    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth, ws.page_setup.fitToHeight = 1, 0
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.print_area = f"A1:P{end + 1}"
    ws.oddFooter.left.text = f"Hazırlayan: {PREPARED_BY}"
    ws.oddFooter.right.text = "&P / &N"


def add_charts(wb, ws, m, top):
    cd = wb["_qrafik"]
    cmp, ay, hek = m["cmp"], m["ay"], m["hekim"]
    q = cmp[cmp["SEVIYYE"] == "Q"] if not cmp.empty else cmp
    f = cmp[cmp["SEVIYYE"] == "F"] if not cmp.empty else cmp
    r = 1

    def block(header, rows):
        nonlocal r
        start = r
        cd.append(header)
        for rw in rows:
            cd.append([_pyval(v) for v in rw])
        r = start + len(rows) + 2
        cd.append([])
        return start, start + len(rows)

    charts = []
    branches = [b for b in BRANCH_ORDER if not q.empty and b in set(q["FILIAL"])]
    if branches:
        piv = q.pivot_table(index="QRUP", columns="FILIAL", values="SATIS", aggfunc="sum").reindex(GROUP_ORDER).fillna(0)
        s0, s1 = block(["Bölmə"] + branches, [[GROUP_LABEL[g]] + [piv.loc[g].get(b, 0) for b in branches] for g in GROUP_ORDER])
        ch = style_chart(BarChart(), "Satış (AZN): bölmələr üzrə filial müqayisəsi")
        ch.type, ch.grouping, ch.gapWidth = "col", "clustered", 60
        ch.add_data(Reference(cd, min_col=2, max_col=1 + len(branches), min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        color_series(ch, [BRANCH_COLORS[b] for b in branches])
        charts.append(ch)

        fb = f.set_index("FILIAL").reindex(branches)
        RR = m.get("_R")
        TL = f'"{TOTAL_LABEL}"'
        tot = (lambda k, b: f'=SUMIFS({RR(k)},{RR("QRUP_AD")},{TL},{RR("FILIAL")},"{b}")') if RR else None
        two = (lambda k1, k2, b: tot(k1, b) + "+" + tot(k2, b)[1:]) if RR else None
        s0, s1 = block(["Filial", "Nağd", "Sığorta", "İTS", "Korporativ"],
                       [[b, two("NAGD", "DERMAN_NAGD", b), two("SIGORTA", "DERMAN_SIG", b),
                         two("ITS", "DERMAN_ITS", b), two("KORPORATIV", "DERMAN_KORP", b)] if RR else
                        [b, fb.loc[b, "NAGD"] + fb.loc[b, "DERMAN_NAGD"], fb.loc[b, "SIGORTA"] + fb.loc[b, "DERMAN_SIG"],
                         fb.loc[b, "ITS"] + fb.loc[b, "DERMAN_ITS"], fb.loc[b, "KORPORATIV"] + fb.loc[b, "DERMAN_KORP"]]
                        for b in branches])
        ch = style_chart(BarChart(), "Ödəniş strukturu (xidmət + dərman)", fmt="0%")
        ch.type, ch.grouping, ch.overlap, ch.gapWidth = "bar", "percentStacked", 100, 50
        ch.add_data(Reference(cd, min_col=2, max_col=5, min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        color_series(ch, PAY_COLORS)
        charts.append(ch)

    if not ay.empty:
        a = ay[ay["QRUP"] == "ALL"]
        months = sorted(a["AY"].unique())
        piv = a.pivot_table(index="AY", columns="FILIAL", values="GUNLUK_SATIS", aggfunc="sum").reindex(months).fillna(0)
        lab = a.drop_duplicates("AY").set_index("AY")["AY_AD"]
        s0, s1 = block(["Ay"] + branches, [[lab[mo]] + [piv.loc[mo].get(b, 0) for b in branches] for mo in months])
        ch = style_chart(LineChart(), "Gündəlik orta satış (AZN/gün) — aylar üzrə")
        ch.add_data(Reference(cd, min_col=2, max_col=1 + len(branches), min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        for s, b in zip(ch.series, branches):
            s.graphicalProperties.line.solidFill = BRANCH_COLORS[b]
            s.graphicalProperties.line.width = 28000
            s.smooth = False
            s.marker.symbol = "circle"
            s.marker.size = 7
            s.marker.graphicalProperties.solidFill = BRANCH_COLORS[b]
            s.marker.graphicalProperties.line.solidFill = BRANCH_COLORS[b]
        charts.append(ch)

    if branches:
        piv = q.pivot_table(index="QRUP", columns="FILIAL", values="ORTA_CEK", aggfunc="sum").reindex(GROUP_ORDER).fillna(0)
        s0, s1 = block(["Bölmə"] + branches, [[GROUP_LABEL[g]] + [piv.loc[g].get(b, 0) for b in branches] for g in GROUP_ORDER])
        ch = style_chart(BarChart(), "Orta çek (AZN): bölmələr üzrə", fmt="#,##0")
        ch.type, ch.grouping, ch.gapWidth = "col", "clustered", 60
        ch.add_data(Reference(cd, min_col=2, max_col=1 + len(branches), min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        color_series(ch, [BRANCH_COLORS[b] for b in branches])
        charts.append(ch)

        s0, s1 = block(["Filial", "Yeni müraciət", "Təkrar müraciət"],
                       [[b, fb.loc[b, "YENI_QEBUL"], fb.loc[b, "TEKRAR_QEBUL"]] for b in branches])
        ch = style_chart(BarChart(), "Qəbul strukturu: yeni və təkrar müraciət")
        ch.type, ch.grouping, ch.overlap, ch.gapWidth = "col", "stacked", 100, 55
        ch.add_data(Reference(cd, min_col=2, max_col=3, min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        color_series(ch, [C_ACCENT, "A9C4EB"])
        charts.append(ch)

    if not hek.empty:
        t10 = hek[hek["PERSKODU"] != "—"].sort_values("SATIS", ascending=False).head(10)
        s0, s1 = block(["Həkim", "Satış"], [[f"{r_.PERSADI} ({r_.FILIAL})", r_.SATIS] for r_ in t10.itertuples()])
        ch = style_chart(BarChart(), "Top-10 həkim: satış məbləği (AZN)")
        ch.type, ch.gapWidth = "bar", 40
        ch.add_data(Reference(cd, min_col=2, min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        ch.x_axis.scaling.orientation = "maxMin"
        ch.legend = None
        ch.dataLabels = DataLabelList()
        ch.dataLabels.showVal = True
        ch.dataLabels.showSerName = ch.dataLabels.showCatName = False
        ch.dataLabels.showLegendKey = ch.dataLabels.showPercent = False
        ch.dataLabels.numFmt = "#,##0"
        color_series(ch, [C_NAVY2])
        charts.append(ch)

    if branches and m.get("has_hak") and "DOVRIYYE" in q:
        RR = m.get("_R")
        if RR:
            s0, s1 = block(["Bölmə"] + branches, [[GROUP_LABEL[g]] + [
                f'=SUMIFS({RR("DOVRIYYE")},{RR("QRUP_AD")},"{GROUP_LABEL[g]}",{RR("FILIAL")},"{b}")' for b in branches]
                for g in GROUP_ORDER])
        else:
            piv = q.pivot_table(index="QRUP", columns="FILIAL", values="DOVRIYYE", aggfunc="sum").reindex(GROUP_ORDER).fillna(0)
            s0, s1 = block(["Bölmə"] + branches, [[GROUP_LABEL[g]] + [piv.loc[g].get(b, 0) for b in branches] for g in GROUP_ORDER])
        ch = style_chart(BarChart(), "Xalis dövriyyə (AZN): bölmələr üzrə")
        ch.type, ch.grouping, ch.gapWidth = "col", "clustered", 60
        ch.add_data(Reference(cd, min_col=2, max_col=1 + len(branches), min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        color_series(ch, [BRANCH_COLORS.get(b, C_ACCENT) for b in branches])
        charts.append(ch)
    if branches and "DERMAN_GELIR" in f:
        RR = m.get("_R")
        TL = f'"{TOTAL_LABEL}"'
        s0, s1 = block(["Filial", "Xidmət satışı", "Dərman satışı"],
                       [[b, f'=SUMIFS({RR("SATIS")},{RR("QRUP_AD")},{TL},{RR("FILIAL")},"{b}")',
                         f'=SUMIFS({RR("DERMAN_GELIR")},{RR("QRUP_AD")},{TL},{RR("FILIAL")},"{b}")'] if RR else
                        [b, fb.loc[b, "SATIS"], fb.loc[b, "DERMAN_GELIR"]] for b in branches])
        ch = style_chart(BarChart(), "Satış strukturu: xidmət və dərman (AZN)")
        ch.type, ch.grouping, ch.overlap, ch.gapWidth = "col", "stacked", 100, 55
        ch.add_data(Reference(cd, min_col=2, max_col=3, min_row=s0, max_row=s1), titles_from_data=True)
        ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
        color_series(ch, [C_NAVY2, "DB2777"])
        charts.append(ch)
    dtop = (m.get("drug") or {}).get("lines")
    if dtop is not None and not dtop.empty:
        c = dtop[dtop["FORMTYPE"].isin([1, 2, 3])].copy()
        c["X"] = c["DERMAN_MAYA"] + c["PAKET_MAYA"] + c["SERFIYYAT"]
        t10 = c.groupby(["DERMAN_AD", "FILIAL"])["X"].sum().sort_values(ascending=False).head(10).reset_index()
        if not t10.empty:
            s0, s1 = block(["Dərman", "Xərc"], [[f"{str(r_.DERMAN_AD)[:38]} ({r_.FILIAL})", r_.X] for r_ in t10.itertuples()])
            ch = style_chart(BarChart(), "Top-10 dərman: xərc (AZN)")
            ch.type, ch.gapWidth = "bar", 40
            ch.add_data(Reference(cd, min_col=2, min_row=s0, max_row=s1), titles_from_data=True)
            ch.set_categories(Reference(cd, min_col=1, min_row=s0 + 1, max_row=s1))
            ch.x_axis.scaling.orientation = "maxMin"
            ch.legend = None
            ch.dataLabels = DataLabelList()
            ch.dataLabels.showVal = True
            ch.dataLabels.showSerName = ch.dataLabels.showCatName = False
            ch.dataLabels.showLegendKey = ch.dataLabels.showPercent = False
            ch.dataLabels.numFmt = "#,##0"
            color_series(ch, ["DB2777"])
            charts.append(ch)

    for i, ch in enumerate(charts):
        anchor = f"{'B' if i % 2 == 0 else 'I'}{top + 1 + (i // 2) * 19}"
        ws.add_chart(ch, anchor)
    return len(charts)


def build_notes(ws, m, start, end_incl, status):
    ws.sheet_view.showGridLines = False
    ws.sheet_properties.tabColor = "7F8C8D"
    for col, w in zip("ABCD", (26, 34, 40, 80)):
        ws.column_dimensions[col].width = w
    band(ws, "A1:D1", "METODOLOGİYA VƏ İZAHAT QEYDLƏRİ", size=14, bg=C_NAVY, height=32)
    r = 3
    days = (end_incl - start).days + 1
    meta = [
        ("Hesabat dövrü", f"{start:%d.%m.%Y} – {end_incl:%d.%m.%Y} (hər iki gün daxil, {days} gün)"),
        ("Hazırlanma tarixi", f"{datetime.now():%d.%m.%Y %H:%M}"),
        ("Məlumat mənbəyi", "FONET klinika idarəetmə sistemi — xidmət, pasiyent qeydiyyatı və stasionar jurnalı"),
        ("Əhatə olunan filiallar", "; ".join(f"{s['FILIAL']}: {'daxildir' if s['OK'] else 'məlumat alınmadı — daxil deyil'}" for s in status)),
        ("Hazırlayan", PREPARED_BY),
    ]
    for lbl, val in meta:
        ws.cell(row=r, column=1, value=lbl).font = font(10, True)
        ws.merge_cells(start_row=r, start_column=2, end_row=r, end_column=4)
        ws.cell(row=r, column=2, value=val).font = font(10)
        for c in range(1, 5):
            ws.cell(row=r, column=c).border = BORDER
            ws.cell(row=r, column=c).fill = fill(C_ZEBRA)
        r += 1
    r += 1

    def section(title, headers, rows_, heights=None):
        nonlocal r
        band(ws, f"A{r}:D{r}", title, size=11, bg="DCE6F5", fg=C_NAVY, height=24)
        r += 1
        if headers:
            for i, h in enumerate(headers, 1):
                c = ws.cell(row=r, column=i, value=h)
                c.fill, c.font, c.border = fill(C_NAVY2), font(9, True, "FFFFFF"), BORDER
                c.alignment = Alignment(horizontal="center", vertical="center")
            r += 1
        for rw in rows_:
            if len(rw) == 2:
                ws.merge_cells(start_row=r, start_column=2, end_row=r, end_column=4)
            for i, v in enumerate(rw, 1):
                c = ws.cell(row=r, column=i, value=v)
                c.font = font(9, bold=(i == 1 or (len(rw) == 4 and i == 2)))
                c.alignment = Alignment(vertical="center", wrap_text=True)
            for i in range(1, 5):
                ws.cell(row=r, column=i).border = BORDER
            longest = max(len(str(v)) for v in rw[1:])
            ws.row_dimensions[r].height = max(30, min(15 * (longest // 85 + 1 + str(rw[-1]).count("\n")), 120))
            r += 1
        r += 1

    section("1. VƏRƏQLƏR", ["Vərəq", "Bəndlər", "Nə göstərir", "Səviyyə"], [
        ("Rəhbərlik Paneli", "Xülasə", "Əsas göstəricilər, Filial × Bölmə matrisləri, avtomatik müşahidələr və qrafiklər. Bütün rəqəmlər 'Filiallar üzrə Müqayisə' vərəqindən canlı düsturla götürülür.", "Filial + Bölmə"),
        ("Filiallar üzrə Müqayisə", "Bənd 12", "Eyni profilli bölmələrin filiallar üzrə müqayisəsi + hər filialın cəmi. Unikal saylar bu səviyyədə ayrıca hesablanır (şöbələrin toplanması deyil).", "Filial + Bölmə"),
        ("Rentabellik", "Bənd 16–17", "Bölmələr üzrə cəmi satış, dərman xərci, həkim qazancı, xalis dövriyyə və marja.", "Filial + Bölmə"),
        ("Dərman Sərfi", "Bənd 13–15", "Bölmələr üzrə dərman satışı və onun ödəniş növləri, maya dəyəri, marja, paketə daxil və şöbə daxili sərfiyyat, qəbul başına dərman xərci.", "Filial + Bölmə"),
        ("Dərman Reytinqi", "Bənd 15", "Hər bölmədə xərcə görə ən çox istifadə olunan 15 dərman.", "Filial + Bölmə + Dərman"),
        ("Təşkilatlar üzrə Satış", "Bənd 6", "Dövrdə satışı olmuş bütün sığorta, İcbari tibbi sığorta və korporativ təşkilatlar: xidmət və dərman üzrə təşkilatın payı.", "Filial + Təşkilat"),
        ("Şöbələr üzrə İcmal", "Bənd 1–3, 5–8, 11", "Hər şöbə üzrə qəbul, yeni/təkrar müraciət, satış bölgüsü, hospitalizasiya və həkim məhsuldarlığı.", "Filial + Şöbə"),
        ("Həkimlər üzrə Göstəricilər", "Bənd 4, 5", "Həkim üzrə qəbul, xidmət, satış, ödəniş mənbəyi, şöbə daxilində pay və yer.", "Filial + Şöbə + Həkim"),
        ("Aylıq Dinamika", "Trend", "Ay üzrə satış və qəbul; natamam aylar üçün gündəlik orta göstəricilər müqayisəni düzgün edir.", "Filial + Bölmə + Ay"),
        ("Göndərilən Yönləndirmələr", "Bənd 9, 10", "Bu bölmələrdən hesabatdan kənar şöbələrə (Laboratoriya, Radiologiya, digər) göndərilən xidmətlər.", "Göndərən → İcraçı"),
        ("Daxil Olan Yönləndirmələr", "Bənd 10", "Digər şöbələrdən bu bölmələrə göndərilən xidmətlər (göndərəni qeyd olunmuş).", "Göndərən → Qəbul edən"),
    ])

    section("2. GÖSTƏRİCİLƏR NECƏ HESABLANIR", ["Bənd", "Göstərici", "Mənbə", "Hesablama qaydası"], [
        ("Bənd 1", "Ambulator, stasionar və cəmi qəbul", "Xidmət qeydləri", "Hər pasiyent müraciəti bir dəfə sayılır — müraciətdə neçə xidmət göstərilməsindən asılı olmayaraq. Bir müraciət eyni bölmənin bir neçə şöbəsini (məs. Pediatriya və Peyvənd) əhatə edirsə, bölmə cəmində bir dəfə sayılır."),
        ("Bənd 1", "Pasiyent sayı", "Pasiyent qeydiyyatı", "Dövrdə müraciət etmiş fərqli şəxslərin sayı. Qəbul sayı ÷ pasiyent sayı = bir pasiyentin orta gəliş sayı."),
        ("Bənd 2", "Yeni pasiyent və təkrar müraciət", "Pasiyent qeydiyyatı", "Müraciət pasiyentin həmin filiala İLK müraciətidirsə — 'Yeni pasiyent', əks halda — 'Təkrar müraciət'. Dövrdə 3 dəfə gələn yeni pasiyent: 1 yeni + 2 təkrar. Yeni + Təkrar = Cəmi qəbul."),
        ("Bənd 3", "Aktiv həkim sayı", "Xidmət qeydləri", "Dövrdə ən azı bir xidmət göstərmiş həkimlər. Bir neçə şöbədə çalışan həkim bölmə və filial cəmində bir dəfə sayılır."),
        ("Bənd 4–5", "Xidmət satışı", "Xidmət qeydləri", "Göstərilmiş bütün xidmətlər üzrə pasiyentin ödədiyi hissə + qurumun (sığorta, korporativ) ödədiyi hissə. Geri qaytarılmış xidmətlər məbləğdən çıxılıb."),
        ("Bənd 6", "Ödəniş bölgüsü", "Xidmət və dərman qeydləri", "• Nağd — pasiyentin özünün ödədiyi hissə (sığortalı pasiyentin franşiza/fərq ödənişi də daxil).\n• Sığorta — könüllü tibbi sığorta şirkətlərinin ödədiyi hissə.\n• İcbari tibbi sığorta (İTS) — dövlət icbari sığortasının ödədiyi hissə.\n• Korporativ / digər — müqaviləli təşkilatların ödədiyi hissə.\nÖdəniş növü pasiyentin sinfinə və təşkilatın adına görə təyin olunur (filiallarda sinif adları fərqli olduğu üçün hər filialda eyni qayda tətbiq edilir). İcbari tibbi sığorta bəzi filiallarda ayrıca xəstə növü (Mərkəz), digərlərində sığorta xəstəsinin təşkilatı kimi qeyd olunur — hər iki halda eyni 'İTS' sütununa düşür, ona görə filiallar müqayisə oluna bilir. Dərmanda pasiyentə ödənişli yazılan dərman — nağd, təşkilat hesabına yazılan — təşkilatın növünə görə.\nNağd + Sığorta + İTS + Korporativ = Satış (xidmət və dərman üçün ayrıca)."),
