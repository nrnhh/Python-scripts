AMT = "(NVL(T.HI_HTUTAR, 0) + NVL(T.HI_KTUTAR, 0))"
NAGD = "NVL(T.HI_HTUTAR, 0)"


def pay_case(sinif_col, kurum_col=None):
    """SQL: qurum payının növü — 'ITS' / 'SIG' / 'KORP' (sinif və ya təşkilat adı üzrə)."""
    cols = [c for c in (sinif_col, kurum_col) if c]
    like = lambda keys: " OR ".join(f"UPPER(NVL({c}, '-')) LIKE '%{k}%'" for c in cols for k in keys)
    return f"(CASE WHEN {like(PAY_ITS_KEYS)} THEN 'ITS' WHEN {like(PAY_SIG_KEYS)} THEN 'SIG' ELSE 'KORP' END)"


def pay_class(sinif, kurum=None):
    """Python ekvivalenti (demo və yoxlama üçün)."""
    u = (str(sinif or "-") + "|" + str(kurum or "-")).upper()
    if any(k in u for k in PAY_ITS_KEYS):
        return "ITS"
    if any(k in u for k in PAY_SIG_KEYS):
        return "SIG"
    return "KORP"
PERIOD_T = f"T.HI_TARIH >= :start_dt AND T.HI_TARIH < :end_dt {EXTRA_HIZMET_FILTER}"


def sql_list(names):
    return ", ".join("'" + n.replace("'", "''") + "'" for n in names)


def all_depts(cfg):
    return [d for ds in cfg["groups"].values() for d in ds]


def drug_names(cfg):
    return all_depts(cfg) + [d for ds in cfg.get("depots", {}).values() for d in ds]


def name_to_group(cfg):
    m = {d: g for g, ds in cfg["groups"].items() for d in ds}
    m.update({d: g for g, ds in cfg.get("depots", {}).items() for d in ds})
    return m


def group_case(col, cfg):
    whens = " ".join(f"WHEN {col} IN ({sql_list(ds)}) THEN '{g}'" for g, ds in cfg["groups"].items() if ds)
    return f"CAST(CASE {whens} ELSE 'XXX' END AS VARCHAR2(10))"


