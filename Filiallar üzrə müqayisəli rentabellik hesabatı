        dr = m.get("drug") or {}
        if not dr:
            add(b, "Dərman çıxışı məlumatı", "> 0", 0, WARN, "Dərman sorğusu nəticə qaytarmadı")
            continue
        eq("Dərman: şöbələr cəmi xərc = Filial cəmi", float(t["DERMAN_XERC"]),
           float(mb.loc[mb["SEVIYYE"] == "S", "DERMAN_XERC"].sum()), "Dərman xərci toplanan göstəricidir")
        eq("Dərman: bölmələr cəmi satış = Filial cəmi", float(t["DERMAN_GELIR"]),
           float(mb.loc[mb["SEVIYYE"] == "Q", "DERMAN_GELIR"].sum()), "Hər şöbə/depo yalnız bir bölməyə aiddir")
        dc = m.get("drug_comp", pd.DataFrame())
        if not dc.empty:
            eq("Dərman bölmə tərkibi cəmi = Filial dərman xərci", float(t["DERMAN_XERC"]),
               float(dc.loc[(dc["FILIAL"] == b) & (dc["NOV"] == GROUP_SUBTOTAL), "DERMAN_XERC"].sum()),
               "Bölmələrə daxil edilən şöbə/depo siyahısı xərcin hamısını izah edir")
        if m.get("has_hak"):
            eq("Həkim qazancı: şöbələr cəmi = Filial cəmi", float(t["HEKIM_QAZANC"]),
               float(mb.loc[mb["SEVIYYE"] == "S", "HEKIM_QAZANC"].sum()), "Həkim qazancı toplanan göstəricidir")
        p12 = dr.get("p12", pd.DataFrame())
        if not p12.empty:
            pb = p12[(p12["FILIAL"] == b) & (p12["PAKET"] == "Paketdən kənar") & p12["I_QRUP_AD"].notna()]
            eq("'Dərman — Məlumat' vərəqi (istəyən şöbə qaydası) = Dərman satışı", float(t["DERMAN_GELIR"]),
               float(pb["D_SATIS"].sum()), "Excel-dəki seçim düsturları modellə eyni nəticəni verir")
        sm = dr.get("summ", pd.DataFrame())
        if not sm.empty:
            eq("Dərman sərfi mənbə cədvəli (xərcə daxil) = Cəmi dərman xərci", float(t["DERMAN_XERC"]),
               float(sm.loc[(sm["FILIAL"] == b) & (sm["XERCE_DAXIL"] == "Bəli"), "MAYA"].sum()),
               "'Dərman sərfi — mənbə' vərəqi paneldəki rəqəmi tam izah edir")
        eq("Dərman ödəniş bölgüsü: Nağd + Sığorta + İTS + Korporativ = Dərman satışı", float(t["DERMAN_GELIR"]),
           float(t["DERMAN_NAGD"] + t["DERMAN_SIG"] + t["DERMAN_ITS"] + t["DERMAN_KORP"]), "")
        if float(t["DERMAN_GELIR"]) > 0 and float(t["MARJA_PAY"]) < 0:
            add(b, "Dərman marjası", "≥ 0%", f"{float(t['MARJA_PAY']):.1%}", WARN, "Satış qiyməti maya dəyərindən aşağıdır")
        bl = dr["bal"][dr["bal"]["FILIAL"] == b] if not dr["bal"].empty else dr["bal"]
        for r_ in bl.itertuples():
            tc, dc, cr = r_.TECHIZAT, r_.DEPO_CIXIS, r_.BASQA_SOBEYE
            ratio = dc / tc if tc else None
            low = tc >= 1000 and ratio is not None and ratio < 0.5
            note = (f"Depoya verilənin {ratio:.0%}-i çıxılıb" if ratio is not None else "Dövrdə təchizat olmayıb")
            if low:
                note += " — qalan ya depoda stok kimi qalıb, ya da çıxış FONET-də vaxtında rəsmiləşdirilməyib"
            if cr > 0:
                note += f"; depodan başqa şöbələrin pasiyentlərinə {fmt_az(cr, 2)} AZN verilib (onların xərcinə yazılıb)"
            add(b, f"Dərman depo balansı — {_qlabel(r_.QRUP)}: təchizat vs çıxış", round(tc, 2), round(dc, 2),
                WARN if low else INFO, note)
        tf = float(t.get("TESNIFSIZ", 0))
        if tf:
            dd = dr["dest"]
            names = (dd[(dd["FILIAL"] == b) & (dd["SINIF"] == "Təsnif olunmayıb")].groupby("CIKIS_YERI")["MAYA"].sum()
                     .sort_values(ascending=False).reset_index())
            add(b, "Dərman: təsnif olunmayan çıxış istiqamətləri", 0, round(tf, 2), WARN,
                "Xərcə daxil edilməyib: " + "; ".join(f"{r_.CIKIS_YERI} ({fmt_az(r_.MAYA)} AZN)" for r_ in names.head(6).itertuples())
                + " — lazım olsa açar sözü skriptdə DRUG_*_KEYS siyahısına əlavə edin")
        for k, c in [("İnventar yerdəyişməsi (xərcə daxil deyil)", "INV_CIXIS"),
                     ("Şöbələrarası ötürmə (xərcə daxil deyil)", "OTURME"),
                     ("Korporativ məntəqələrə çıxış (ayrıca göstərilir)", "KORP_MENTEQE")]:
            add(b, "Dərman: " + k, "—", round(float(t[c]), 2), INFO, "İstiqamətlər — 'Dərman istiqamətləri' vərəqində")
    return pd.DataFrame(rows)


