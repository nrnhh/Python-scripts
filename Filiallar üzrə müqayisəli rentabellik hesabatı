    first = ["Aysel", "Rəşad", "Günel", "Elvin", "Nigar", "Tural", "Ləman", "Orxan", "Səbinə", "Fərid",
             "Kamran", "Aytən", "Vüsal", "Lalə", "Murad", "Nərmin", "Samir", "Zəhra"]
    last = ["Məmmədova", "Əliyev", "Həsənova", "Quliyev", "İsmayılova", "Hüseynov", "Abbasova", "Kərimov"]
    gp = {"PED": (3600, 0.06, 45, 2.2), "NEO": (500, 0.55, 160, 3.0), "TTY": (1200, 0.10, 60, 1.6), "FIZ": (350, 0.0, 35, 3.5)}
    scale = {"Babək": 1.0, "Mərkəz": 0.72, "Medilux": 0.55}

    for bi, (branch, cfg) in enumerate(BRANCHES.items()):
        rng = np.random.default_rng(42 + bi)
        recs, yat, hk = [], [], 1000
        docs = {}
        for g, ds in cfg["groups"].items():
            if not ds:
                continue
            n_adm, p_stas, avg_amt, n_serv = gp.get(g, (900, 0.2, 80, 2.0))
            n_adm = int(n_adm * scale[branch] * rng.uniform(0.85, 1.15))
            pool = max(int(n_adm * 0.6), 10)
            pid = rng.integers(0, pool, n_adm) + bi * 100000 + GROUP_ORDER.index(g) * 10000
            for d in ds:
                docs[d] = [(f"{bi}{GROUP_ORDER.index(g)}{k:02d}", f"{rng.choice(first)} {rng.choice(last)}")
                           for k in range(int(rng.integers(2, 7)))]
            w = np.array([3.0] + [1.0] * (len(ds) - 1)); w /= w.sum()
            for i in range(n_adm):
                hk += 1
                dt = start + timedelta(days=int(rng.integers(0, days)), hours=int(rng.integers(8, 20)))
                tur = "Y" if rng.random() < p_stas else "A"
                main = ds[rng.choice(len(ds), p=w)]
                kind = rng.choice(["N", "S", "I", "K"], p=[0.55, 0.28, 0.07, 0.10])
