                            "S": (DEMO_SIG_CLASS[branch], rng.choice(DEMO_INSURERS)),
                            "I": (DEMO_ITS_CLASS[branch], "İcbari tibbi sığorta"),
                            "K": ("Korparativ", rng.choice(DEMO_CORPS))}[kind]
                iserv = None if rng.random() < 0.7 else main
                for s in range(1 + rng.poisson(n_serv)):
                    d = main if rng.random() < 0.88 else ds[rng.integers(0, len(ds))]
                    doc = docs[d][rng.integers(0, len(docs[d]))] if rng.random() > 0.03 else (None, None)
                    amt = round(float(rng.lognormal(np.log(avg_amt), 0.6)) * (1.15 if branch == "Mərkəz" else 1), 2)
                    if rng.random() < 0.003:
                        amt = -amt
                    h, k = (amt, 0.0) if kind == "N" else ((round(amt * 0.1, 2), round(amt * 0.9, 2))
                                                             if kind == "S" else (0.0, amt))
                    isv = rng.choice(ext_in) if rng.random() < 0.06 else iserv
                    recs.append((d, g, hk, int(pid[i]), tur, doc[0], doc[1], cls, h, k, dt, isv, "Xidmət", "Müayinə", kur))
                for _ in range(rng.poisson(0.9)):
                    e = ext_out[rng.integers(0, len(ext_out))]
                    amt = round(float(rng.lognormal(np.log(25), 0.5)), 2)
                    h, k = (amt, 0.0) if kind == "N" else (round(amt * .1, 2), round(amt * .9, 2))
                    recs.append((e[0], None, hk, int(pid[i]), tur, "L01", "Lab", cls, h, k, dt, main, e[1], e[2], kur))
                if tur == "Y":
