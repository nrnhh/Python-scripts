OPTIONAL_QUERIES = {"drug": None, "drug_hekim": "drug_hekim_alt", "missed": None, "org_xidmet": None, "klinik": None,
                    "hak": None, "hak_hekim": None}
FALLBACK_ONLY = {"drug_hekim_alt"}


def fetch_live(start, end_excl):
    import oracledb
    oracledb.init_oracle_client(lib_dir=ORACLE_CLIENT_DIR)
    password = os.environ.get("FONET_DB_PASS") or getpass.getpass(f"{DB_USER} üçün FONET parolu: ")
    params = {"start_dt": start, "end_dt": end_excl}

    data, status = {}, []
    for branch, cfg in BRANCHES.items():
        t0 = time.time()
        print(f"[{branch}] {cfg['dsn']} bazasına qoşulur...")
        notes = []
        try:
            out = {}
            use_kurum, hak = True, None
            with oracledb.connect(user=DB_USER, password=password, dsn=cfg["dsn"]) as conn:
                try:  # təşkilat adı sütunu bu filialın bazasında varmı?
                    run_query(conn, "SELECT T.HKURUMADI FROM fonethbys.V_IST_GENEL_HIZMET T WHERE ROWNUM = 1", {})
                except Exception:
                    use_kurum = False
                    notes.append(("kurum", "alt"))
                    print("    təşkilat adı sütunu yoxdur — ödəniş növü yalnız pasiyent sinfi üzrə təyin olunur")
                try:  # həkim qazancı view-u və onun həkim sütunu
                    cols = set(run_query(conn, "SELECT * FROM fonethbys.V_HAKEDIS_RAPOR WHERE ROWNUM = 1", {}).columns)
                    hak = {"code": next((c for c in HAK_CODE_CANDIDATES if c in cols), None),
                           "name": next((c for c in HAK_NAME_CANDIDATES if c in cols), None)}
                    if not hak["code"]:
                        notes.append(("hak_kod", "alt" if hak["name"] else "yox"))
                    print(f"    həkim qazancı: həkim sütunu = {hak['code'] or hak['name'] or 'tapılmadı'}")
                except Exception as he:
                    notes.append(("hak", "yox"))
                    print(f"    həkim qazancı view-u əlçatan deyil: {str(he).splitlines()[0]}")
            Q = build_queries(cfg, use_kurum=use_kurum, hak=hak)
            with oracledb.connect(user=DB_USER, password=password, dsn=cfg["dsn"]) as conn:
                for name, sql in Q.items():
                    if name in FALLBACK_ONLY:
                        continue
                    try:
                        out[name] = run_query(conn, sql, params)
                    except Exception as qe:
                        if name not in OPTIONAL_QUERIES:
                            raise
                        alt = OPTIONAL_QUERIES[name]
                        print(f"    {name:<10} XƏTA: {str(qe).splitlines()[0]}")
                        if alt:
                            try:
                                out[name] = run_query(conn, Q[alt], params)
                                notes.append((name, "alt"))
                                print(f"    {name:<10} ehtiyat üsulla alındı")
                                continue
                            except Exception as qe2:
                                print(f"    {name:<10} ehtiyat üsul da alınmadı: {str(qe2).splitlines()[0]}")
                        notes.append((name, "yox"))
                        continue
                    print(f"    {name:<10} {len(out[name]):>6} sətir")
            data[branch] = out
            status.append({"FILIAL": branch, "OK": True, "SANIYE": round(time.time() - t0, 1), "XETA": "",
                           "NOTES": notes})
            print(f"[{branch}] hazırdır ({time.time() - t0:.1f} san).")
        except Exception as e:  # əsas sorğu xətası — filial hesabata düşmür, nəzarət faylında ✖
            status.append({"FILIAL": branch, "OK": False, "SANIYE": round(time.time() - t0, 1), "XETA": str(e)[:300],
                           "NOTES": notes})
            print(f"[{branch}] XƏTA: {e}")
    return data, status


