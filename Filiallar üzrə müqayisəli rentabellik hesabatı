def unique_path(path):
    """Eyni adda fayl varsa (və ya Excel-də açıqdırsa) üzərinə yazmır: sonuna _2, _3 ... əlavə edir."""
    if not os.path.exists(path):
        return path
    base, ext = os.path.splitext(path)
    i = 2
    while os.path.exists(f"{base}_{i}{ext}"):
        i += 1
    return f"{base}_{i}{ext}"


def main():
    ap = argparse.ArgumentParser(description="Filiallar üzrə şöbə fəaliyyət və satış hesabatı")
    ap.add_argument("--start", help="Başlanğıc tarix (DD.MM.YYYY, daxil). Default: son tam günün 3 ay əvvəli + 1 gün")
    ap.add_argument("--end", help="Son tarix (DD.MM.YYYY, daxil). Default: dünən")
    ap.add_argument("--demo", action="store_true", help="Bazaya qoşulmadan nümunə məlumatla işlət")
    ap.add_argument("--out", default=".", help="Çıxış qovluğu")
    ap.add_argument("--bolme", help="Standart bölmələrdən seçim, məs: \"Pediatriya,Neonatologiya\" və ya \"1,3\"")
    ap.add_argument("--sobe", help="İstənilən şöbə(lər), məs: \"Reanimasiya; Kardiologiya\" — hər biri ayrıca bölmə olur")
    ap.add_argument("--sec", action="store_true", help="İşə salanda seçim menyusunu göstər")
    a = ap.parse_args()
    if a.sec:
        a.__dict__.update(interactive_selection())
    if a.bolme and a.sobe:
        sys.exit("--bolme və --sobe birlikdə istifadə olunmur.")
    if a.bolme:
        select_standard(a.bolme)
    elif a.sobe:
        select_custom(a.sobe, fetch_branch_names(a.demo))
    drop_empty_branches()
    print("Bölmələr: " + ", ".join(GROUP_LABEL[g] for g in GROUP_ORDER) + "  |  Filiallar: " + ", ".join(BRANCH_ORDER))

    today = datetime.combine(date.today(), datetime.min.time())
    end_incl = datetime.strptime(a.end, "%d.%m.%Y") if a.end else today - timedelta(days=1)
    start = (datetime.strptime(a.start, "%d.%m.%Y") if a.start
             else (pd.Timestamp(end_incl + timedelta(days=1)) - pd.DateOffset(months=DEFAULT_MONTHS)).to_pydatetime())
    end_excl = end_incl + timedelta(days=1)
    if end_incl < start:
        sys.exit("Son tarix başlanğıcdan əvvəl ola bilməz.")
    if end_incl.date() >= date.today():
        print(f"QEYD: dövrün son günü ({end_incl:%d.%m.%Y}) hələ bitməyib — həmin gün üzrə məlumat natamam olacaq.")

    data, status = demo_fetch(start, end_excl) if a.demo else fetch_live(start, end_excl)
    if not any(s["OK"] for s in status):
        sys.exit("Heç bir filial bazasına qoşulmaq mümkün olmadı — hesabat yaradılmadı.")

    model = build_model(data, status, start, end_incl)
    suffix = "_DEMO" if a.demo else ""
    if a.bolme or a.sobe:
        tag = "_".join(re.sub(r"[^\w]+", "", GROUP_LABEL[g])[:14] for g in GROUP_ORDER)[:50]
        suffix = f"_{tag}" + suffix
    os.makedirs(a.out, exist_ok=True)
    path = unique_path(os.path.join(a.out, f"Filiallar_Sobe_Fealiyyet_Hesabati_{start:%Y%m%d}-{end_incl:%Y%m%d}{suffix}.xlsx"))
    build_workbook(model, start, end_incl, status, path)
    ctrl = unique_path(path.replace(".xlsx", "_NEZARET.xlsx"))
    build_control_workbook(model, start, end_incl, ctrl)

    dq = model["dq"]
    bad = dq["NETICE"].str.startswith("✖").sum() if not dq.empty else 0
    warn = dq["NETICE"].str.startswith("⚠").sum() if not dq.empty else 0
    print(f"\nRəhbərlik hesabatı : {path}")
    print(f"Daxili nəzarət     : {ctrl}  (rəhbərliyə göndərilmir)")
    print(f"Yoxlamalar: {bad} xəta, {warn} diqqət" +
          (" — GÖNDƏRMƏZDƏN ƏVVƏL nəzarət faylına baxın!" if bad else " — rəqəmlər uyğundur."))
    for r in dq[dq["NETICE"].str[:1].isin(["✖", "⚠"])].itertuples():
        print(f"   {r.NETICE[:1]} {r.FILIAL}: {r.YOXLAMA} — {r.SERH}")


if __name__ == "__main__":
    main()
