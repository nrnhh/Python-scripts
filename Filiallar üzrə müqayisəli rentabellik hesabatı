        out.append(f"Ən böyük təşkilat: {o['KURUM']} ({o['FILIAL']}, {o['ODENIS_NOVU']}) — {fmt_az(o['TESKILAT_CEMI'])} AZN "
                   f"(xidmət + dərman); cəmi {org['KURUM'].nunique()} təşkilat üzrə satış olub.")
    hb = g[g["HEKIM_SAYI"] >= 2].sort_values("HEKIM_BASI_SATIS", ascending=False)
    if not hb.empty:
        h = hb.iloc[0]
        out.append(f"Həkim məhsuldarlığı: ən yüksək həkim başına satış — {h['FILIAL']} {h['QRUP_AD']} "
                   f"({fmt_az(h['HEKIM_BASI_SATIS'])} AZN/həkim, {fmt_az(h['HEKIM_BASI_QEBUL'], 1)} qəbul/həkim).")
    if not hek.empty:
        d = hek[hek["PERSKODU"] != "—"].sort_values("SATIS", ascending=False).iloc[0]
        out.append(f"Ən yüksək satışlı həkim: {d['PERSADI']} ({d['FILIAL']}, {d['SR_ADI']}) — "
                   f"{fmt_az(d['SATIS'])} AZN, {fmt_az(d['CEMI_QEBUL'])} qəbul.")
    if "DERMAN_GELIR" in tot and tot["DERMAN_GELIR"].sum() > 0:
        DG, DM = tot["DERMAN_GELIR"].sum(), tot["DERMAN_MAYA"].sum()
        CG = tot["CEMI_GELIR"].sum()
        mb = tot[tot["DERMAN_GELIR"] > 0].sort_values("MARJA_PAY")
        out.append(f"Dərman satışı {fmt_az(DG)} AZN — cəmi satışın {DG / CG:.0%}-i; orta marja "
                   f"{(DG - DM) / DG:.0%} (" + ", ".join(f"{r.FILIAL} {r.MARJA_PAY:.0%}" for r in mb.iloc[::-1].itertuples()) + ").")
        gq = g[(g["CEMI_QEBUL"] >= 50) & (g["DERMAN_XERC"] > 0)].sort_values("QEBUL_BASI_DERMAN", ascending=False)
        if not gq.empty:
            h = gq.iloc[0]
            out.append(f"Qəbul başına ən yüksək dərman xərci: {h['FILIAL']} — {h['QRUP_AD']} "
                       f"({fmt_az(h['QEBUL_BASI_DERMAN'], 2)} AZN/qəbul).")
        PK, SF = tot["PAKET_MAYA"].sum(), tot["SERFIYYAT"].sum()
        out.append(f"Ayrıca satışı olmayan dərman xərci: paketə daxil {fmt_az(PK)} AZN, şöbə daxili sərfiyyat {fmt_az(SF)} AZN "
                   f"— cəmi dərman xərcinin {(PK + SF) / tot['DERMAN_XERC'].sum():.0%}-i.")
        KM = tot["KORP_MENTEQE"].sum()
        if KM > 0:
            out.append(f"Korporativ məntəqələrə {fmt_az(KM)} AZN dərman çıxılıb — TTY xərcinə daxil edilməyib, "
                       f"ayrıca göstərilir.")
    return out


def style_chart(ch, title, ytitle=None, fmt="#,##0"):
    ch.title = title
    ch.roundedCorners = False
    ch.width, ch.height = 16.8, 8.6
    ch.legend.position = "b"
    ch.legend.overlay = False
    try:
        ch.title.overlay = False
    except AttributeError:
        pass
    ch.x_axis.delete = False
    ch.y_axis.delete = False
    ch.y_axis.numFmt = fmt
    ch.y_axis.majorGridlines.spPr = None
    if ytitle:
        ch.y_axis.title = ytitle
    return ch


def color_series(ch, colors):
    for s, c in zip(ch.series, colors):
        s.graphicalProperties.solidFill = c
        s.graphicalProperties.line.solidFill = c


def month_trends(m):
    """Son iki ay üzrə gündəlik orta dəyişmə (natamam aylar gündəlik ortalama ilə müqayisə olunur)."""
    ay = m["ay"]
    if ay.empty:
        return {}
    a = ay[ay["QRUP"] == "ALL"].groupby("AY").agg(SATIS=("SATIS", "sum"), QEBUL=("CEMI_QEBUL", "sum"),
                                                  GUN=("GUN", "max")).sort_index()
    a = a[a["GUN"] > 0]
    if len(a) < 2:
        return {}
    cur, prev = a.iloc[-1], a.iloc[-2]
    lbl = f"{AZ_MONTHS[a.index[-1].month - 1][:3]}/{AZ_MONTHS[a.index[-2].month - 1][:3]}"

    def ch(c, p):
        return (c / p - 1) if p else None
    return {
        "SATIS": (ch(cur.SATIS / cur.GUN, prev.SATIS / prev.GUN), f"{lbl}, gündəlik orta"),
        "QEBUL": (ch(cur.QEBUL / cur.GUN, prev.QEBUL / prev.GUN), f"{lbl}, gündəlik orta"),
        "CEK": (ch(cur.SATIS / cur.QEBUL, prev.SATIS / prev.QEBUL), lbl),
    }


