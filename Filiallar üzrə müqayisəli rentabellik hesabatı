def build_queries(cfg, use_kurum=True, hak=None):
    IN = sql_list(all_depts(cfg))
    KUR = "T.HKURUMADI" if use_kurum else None
    PAYX = pay_case("T.HSINIFADI", KUR)
    SIG = f"CASE WHEN {PAYX} = 'SIG' THEN NVL(T.HI_KTUTAR, 0) ELSE 0 END"
    ITS = f"CASE WHEN {PAYX} = 'ITS' THEN NVL(T.HI_KTUTAR, 0) ELSE 0 END"
    KORP = f"CASE WHEN {PAYX} = 'KORP' THEN NVL(T.HI_KTUTAR, 0) ELSE 0 END"
    G_T = group_case("T.SR_ADI", cfg)
    G_Y = group_case("Y.SERVISADI", cfg)
    G_IS = group_case("T.ISERVIS", cfg)
    Q = {}

    # --- A. Əsas göstəricilər: 3 səviyyədə (S=şöbə, Q=bölmə qrupu, F=filial cəmi) ------------------
    # COUNT(DISTINCT) hər səviyyədə AYRICA hesablanır — şöbə rəqəmlərini toplamaq səhv nəticə verirdi.
    Q["met"] = f"""
    WITH XB AS (
        SELECT /*+ MATERIALIZE */
               T.SR_ADI, {G_T} AS QRUP, T.HK_ID, T.HK_KAYITKODU, T.HK_HASTATURU, T.PERSKODU,
               {PAYX} AS PAY, NVL(T.HI_HTUTAR, 0) AS H_TUTAR, NVL(T.HI_KTUTAR, 0) AS K_TUTAR
        FROM fonethbys.V_IST_GENEL_HIZMET T
        WHERE {PERIOD_T}
          AND T.SR_ADI IN ({IN})
    ),
    XL AS (
        SELECT 'S' AS SEVIYYE, QRUP, CAST(SR_ADI AS VARCHAR2(200)) AS OBYEKT,
               HK_ID, HK_KAYITKODU, HK_HASTATURU, PERSKODU, PAY, H_TUTAR, K_TUTAR FROM XB
        UNION ALL
        SELECT 'Q', QRUP, CAST(QRUP AS VARCHAR2(200)),
               HK_ID, HK_KAYITKODU, HK_HASTATURU, PERSKODU, PAY, H_TUTAR, K_TUTAR FROM XB
        UNION ALL
        SELECT 'F', CAST('ALL' AS VARCHAR2(10)), CAST('ALL' AS VARCHAR2(200)),
               HK_ID, HK_KAYITKODU, HK_HASTATURU, PERSKODU, PAY, H_TUTAR, K_TUTAR FROM XB
    ),
    ADM AS (SELECT DISTINCT HK_ID, HK_KAYITKODU FROM XB),
    ILK AS (
        -- Pasiyentin (HK_KAYITKODU) filialdakı ilk aktiv müraciəti
        SELECT K.HK_KAYITKODU,
               MIN(K.HK_ID) KEEP (DENSE_RANK FIRST ORDER BY K.HK_MURACAATTAR, K.HK_ID) AS ILK_HK_ID
        FROM fonethbys.H_HASTAKAYIT K
        WHERE K.HK_DURUM = '+'
          AND K.HK_KAYITKODU IN (SELECT HK_KAYITKODU FROM ADM)
        GROUP BY K.HK_KAYITKODU
    ),
    ADM_FLAG AS (
        SELECT A.HK_ID,
               CASE WHEN I.ILK_HK_ID IS NULL OR I.ILK_HK_ID = A.HK_ID THEN 1 ELSE 0 END AS YENI
        FROM ADM A LEFT JOIN ILK I ON I.HK_KAYITKODU = A.HK_KAYITKODU
    ),
    MET AS (
        SELECT L.SEVIYYE, L.OBYEKT, MAX(L.QRUP) AS QRUP,
               COUNT(DISTINCT CASE WHEN L.HK_HASTATURU LIKE 'A%' THEN L.HK_ID END) AS AMB_QEBUL,
               COUNT(DISTINCT CASE WHEN L.HK_HASTATURU LIKE 'Y%' THEN L.HK_ID END) AS STAS_QEBUL,
               COUNT(DISTINCT L.HK_ID)                                      AS CEMI_QEBUL,
               COUNT(DISTINCT CASE WHEN F.YENI = 1 THEN L.HK_ID END)        AS YENI_QEBUL,
               COUNT(DISTINCT CASE WHEN F.YENI = 0 THEN L.HK_ID END)        AS TEKRAR_QEBUL,
               COUNT(DISTINCT L.HK_KAYITKODU)                               AS UNIKAL_PASIYENT,
               COUNT(DISTINCT L.PERSKODU)                                   AS HEKIM_SAYI,
               COUNT(*)                                                     AS XIDMET_SATIRI,
               SUM(L.H_TUTAR + L.K_TUTAR)                                   AS SATIS,
               SUM(L.H_TUTAR)                                               AS NAGD,
               SUM(CASE WHEN L.PAY = 'SIG' THEN L.K_TUTAR ELSE 0 END)   AS SIGORTA,
               SUM(CASE WHEN L.PAY = 'ITS' THEN L.K_TUTAR ELSE 0 END)   AS ITS,
               SUM(CASE WHEN L.PAY = 'KORP' THEN L.K_TUTAR ELSE 0 END)  AS KORPORATIV
        FROM XL L
        JOIN ADM_FLAG F ON F.HK_ID = L.HK_ID
        GROUP BY L.SEVIYYE, L.OBYEKT
    ),
    YB AS (
        SELECT /*+ MATERIALIZE */
               Y.SERVISADI AS SR_ADI, {G_Y} AS QRUP, Y.HK_ID,
               TRUNC(Y.TARIH) AS GIRIS, TRUNC(Y.CIKISTARIHI) AS CIKIS
        FROM fonethbys.V_YH_DEFTER Y
        WHERE Y.TARIH >= :start_dt AND Y.TARIH < :end_dt
          AND Y.SERVISADI IN ({IN})
    ),
    YL AS (
        SELECT 'S' AS SEVIYYE, CAST(SR_ADI AS VARCHAR2(200)) AS OBYEKT, HK_ID, GIRIS, CIKIS FROM YB
        UNION ALL SELECT 'Q', CAST(QRUP AS VARCHAR2(200)), HK_ID, GIRIS, CIKIS FROM YB
        UNION ALL SELECT 'F', CAST('ALL' AS VARCHAR2(200)), HK_ID, GIRIS, CIKIS FROM YB
    ),
    YK AS (
        -- Hər yatış kartı (HK_ID) hər səviyyədə 1 dəfə: şöbələrarası keçid (Reanimasiya → Stasionar) bir yatışdır
        SELECT SEVIYYE, OBYEKT, HK_ID, MIN(GIRIS) AS GIRIS, MAX(CIKIS) AS CIKIS,
               MAX(CASE WHEN CIKIS IS NULL THEN 1 ELSE 0 END) AS ACIQ
        FROM YL GROUP BY SEVIYYE, OBYEKT, HK_ID
    ),
    YAT AS (
        SELECT SEVIYYE, OBYEKT,
               COUNT(*)      AS HOSP_SAYI,
               SUM(1 - ACIQ) AS TAXIS_SAYI,
               SUM(ACIQ)     AS HELE_YATAN,
               -- Orta yatış yalnız evə yazılmış pasiyentlər üzrə; eyni gün çıxış = 1 çarpayı-günü
               AVG(CASE WHEN ACIQ = 0 THEN GREATEST(CIKIS - GIRIS, 1) END) AS ORTA_YATIS
        FROM YK GROUP BY SEVIYYE, OBYEKT
    )
    SELECT M.SEVIYYE, M.QRUP, M.OBYEKT,
           M.AMB_QEBUL, M.STAS_QEBUL, M.CEMI_QEBUL, M.YENI_QEBUL, M.TEKRAR_QEBUL, M.UNIKAL_PASIYENT,
           M.HEKIM_SAYI, M.XIDMET_SATIRI, M.SATIS, M.NAGD, M.SIGORTA, M.ITS, M.KORPORATIV,
           NVL(Y.HOSP_SAYI, 0) AS HOSP_SAYI, NVL(Y.TAXIS_SAYI, 0) AS TAXIS_SAYI,
           NVL(Y.HELE_YATAN, 0) AS HELE_YATAN, Y.ORTA_YATIS
    FROM MET M
    LEFT JOIN YAT Y ON Y.SEVIYYE = M.SEVIYYE AND Y.OBYEKT = M.OBYEKT
    """

    # --- B. Həkimlər (həkimi qeyd olunmayan sətirlər də ayrıca sətir kimi qalır — məbləğ itmir) ------
    Q["hekim"] = f"""
    SELECT T.SR_ADI, MAX({G_T}) AS QRUP, T.PERSKODU, MAX(T.PERSADI) AS PERSADI,
           COUNT(DISTINCT T.HK_ID) AS CEMI_QEBUL, COUNT(DISTINCT T.HK_KAYITKODU) AS UNIKAL_PASIYENT,
           COUNT(*) AS XIDMET_SATIRI,
           SUM({AMT}) AS SATIS, SUM({NAGD}) AS NAGD, SUM({SIG}) AS SIGORTA, SUM({ITS}) AS ITS,
           SUM({KORP}) AS KORPORATIV
    FROM fonethbys.V_IST_GENEL_HIZMET T
    WHERE {PERIOD_T}
      AND T.SR_ADI IN ({IN})
    GROUP BY T.SR_ADI, T.PERSKODU
    """

    # --- C. Aylıq dinamika (qrup + filial cəmi; distinct sayı GROUPING SETS ilə düzgün) -------------
    Q["ay"] = f"""
    SELECT CASE WHEN GROUPING(QRUP) = 1 THEN 'ALL' ELSE QRUP END AS QRUP, AY,
           COUNT(DISTINCT HK_ID) AS CEMI_QEBUL, SUM(MEBLEG) AS SATIS
    FROM (
        SELECT {G_T} AS QRUP, TRUNC(T.HI_TARIH, 'MM') AS AY, T.HK_ID, {AMT} AS MEBLEG
        FROM fonethbys.V_IST_GENEL_HIZMET T
        WHERE {PERIOD_T}
          AND T.SR_ADI IN ({IN})
    )
    GROUP BY GROUPING SETS ((QRUP, AY), (AY))
    """

    # --- D. Göndərilən yönləndirmələr: yalnız hesabatdan KƏNAR icraçı şöbələrə -----------------------
    # (Pediatriya → PEYVƏND kimi daxili keçidlər onsuz da İcmal vərəqindədir; burada təkrar sayılmır)
    Q["geden"] = f"""
    SELECT T.ISERVIS AS GONDEREN_SOBE, MAX({G_IS}) AS QRUP, T.SR_ADI AS ICRACI_SOBE,
           T.ITU_ADI, T.IT_ADI,
           COUNT(DISTINCT T.HK_ID) AS CEMI_QEBUL, COUNT(*) AS XIDMET_SATIRI,
           SUM({AMT}) AS SATIS, SUM({NAGD}) AS NAGD, SUM({SIG}) AS SIGORTA, SUM({ITS}) AS ITS,
           SUM({KORP}) AS KORPORATIV
    FROM fonethbys.V_IST_GENEL_HIZMET T
    WHERE {PERIOD_T}
      AND T.ISERVIS IN ({IN})
      AND NVL(T.SR_ADI, '-') NOT IN ({IN})
    GROUP BY T.ISERVIS, T.SR_ADI, T.ITU_ADI, T.IT_ADI
    """

    # --- E. Daxil olan yönləndirmələr: yalnız göndərəni QEYD OLUNMUŞ, kənar şöbələrdən ----------------
    # (ISERVIS boş olan birbaşa müraciətlər əvvəl "yönləndirmə" kimi sayılırdı — indi çıxarılıb,
    #  payı Məlumat Keyfiyyəti vərəqində göstərilir)
    Q["gelen"] = f"""
    SELECT T.ISERVIS AS GONDEREN_SOBE, T.SR_ADI AS QEBUL_EDEN_SOBE, MAX({G_T}) AS QRUP, T.ITU_ADI,
           COUNT(DISTINCT T.HK_ID) AS CEMI_QEBUL, COUNT(*) AS XIDMET_SATIRI, SUM({AMT}) AS SATIS
    FROM fonethbys.V_IST_GENEL_HIZMET T
    WHERE {PERIOD_T}
      AND T.SR_ADI IN ({IN})
      AND T.ISERVIS IS NOT NULL
      AND T.ISERVIS NOT IN ({IN})
    GROUP BY T.ISERVIS, T.SR_ADI, T.ITU_ADI
    """

    # --- F. Məlumat keyfiyyəti — müstəqil yoxlama sorğusu --------------------------------------------
    Q["dq"] = f"""
    SELECT COUNT(*) AS SATIR, SUM({AMT}) AS SATIS,
           SUM(CASE WHEN T.PERSKODU IS NULL THEN 1 ELSE 0 END)        AS HEKIMSIZ_SATIR,
           SUM(CASE WHEN T.PERSKODU IS NULL THEN {AMT} ELSE 0 END)    AS HEKIMSIZ_SATIS,
           SUM(CASE WHEN T.ISERVIS IS NULL THEN 1 ELSE 0 END)         AS ISERVIS_BOS,
           SUM(CASE WHEN {AMT} < 0 THEN 1 ELSE 0 END)                 AS MENFI_SATIR,
           SUM(CASE WHEN {AMT} < 0 THEN {AMT} ELSE 0 END)             AS MENFI_MEBLEG,
           SUM(CASE WHEN {AMT} = 0 THEN 1 ELSE 0 END)                 AS SIFIR_SATIR,
           MAX(T.HI_TARIH)                                            AS SON_TARIX
    FROM fonethbys.V_IST_GENEL_HIZMET T
    WHERE {PERIOD_T}
      AND T.SR_ADI IN ({IN})
    """

    likes = " OR ".join(f"UPPER(T.SR_ADI) LIKE '%{p}%'" for p in MISSED_DEPT_PATTERNS)
    nots = " ".join(f"AND UPPER(T.SR_ADI) NOT LIKE '%{p}%'" for p in MISSED_DEPT_EXCLUDE)
    Q["missed"] = f"""
    SELECT T.SR_ADI, COUNT(DISTINCT T.HK_ID) AS CEMI_QEBUL, SUM({AMT}) AS SATIS
    FROM fonethbys.V_IST_GENEL_HIZMET T
    WHERE {PERIOD_T}
      AND T.SR_ADI NOT IN ({IN})
      AND ({likes})
      {nots}
    GROUP BY T.SR_ADI
    """
    # --- G. Dərman və material çıxışları (aqreqat, dərman adı səviyyəsində) ---------------------------
    # Növ 1-2: pasiyentə (istəyən şöbəyə yazılır) · 3: şöbə deposundan digər çıxış · 4-5: şöbəyə təchizat
    # Pasiyentin adı (növ 1-2 üçün çıxış yeri) heç vaxt çəkilmir.
    INX = sql_list(drug_names(cfg))
    # Ödəniş növü: 'Ücretli' -> nağd; 'Sigortalı' -> pasiyentin sinfi (xidmət statistikasından) və ya təşkilat adı
    PAYD = (f"CASE WHEN T.FORMTYPE NOT IN (1, 2) THEN NULL "
            f"WHEN UPPER(NVL(T.ODEMETURU, '-')) LIKE '%CRET%' THEN 'NAGD' "
            f"ELSE {pay_case('S.HSINIFADI', 'T.ILACGRUPADI')} END")
    Q["drug"] = f"""
    WITH S AS (
        SELECT H.HK_ID, MAX(H.HSINIFADI) AS HSINIFADI
        FROM fonethbys.V_IST_GENEL_HIZMET H
        WHERE H.HI_TARIH >= :start_dt AND H.HI_TARIH < :end_dt
        GROUP BY H.HK_ID
    ),
    D AS (
        SELECT T.FORMTYPE, T.HSERVISADI, T.DEPOADI,
               CASE WHEN T.FORMTYPE IN (1, 2) THEN NULL ELSE T.CIKISBIRIMADI END AS CIKIS_YERI,
               T.PAKET_DURUMU, T.SNLMALZEMEADI AS DERMAN_AD, T.SNLBIRIMADI AS BIRIM,
               {PAYD} AS PAY,
               CASE WHEN T.FORMTYPE IN (1, 2) AND UPPER(NVL(T.ODEMETURU, '-')) NOT LIKE '%CRET%'
                    THEN NVL(T.ILACGRUPADI, '—') END AS KURUM,
               T.MIKTAR, T.SNLTUTAR, T.SNLALISTUTAR
        FROM fonethbys.v_stok_list_cikisfisdetay T
        LEFT JOIN S ON S.HK_ID = T.HASTA_HKID
        WHERE T.TARIH >= :start_dt AND T.TARIH < :end_dt
          AND T.FORMTYPE IN (1, 2, 3, 4, 5)
          AND (T.HSERVISADI IN ({INX}) OR T.DEPOADI IN ({INX})
               OR (T.FORMTYPE NOT IN (1, 2) AND T.CIKISBIRIMADI IN ({INX})))
    )
    SELECT FORMTYPE, HSERVISADI, DEPOADI, CIKIS_YERI, PAKET_DURUMU, DERMAN_AD, BIRIM, PAY, KURUM,
           COUNT(*) AS SATIR, SUM(NVL(MIKTAR, 0)) AS MIQDAR,
           SUM(NVL(SNLTUTAR, 0)) AS SATIS, SUM(NVL(SNLALISTUTAR, 0)) AS MAYA
    FROM D
    GROUP BY FORMTYPE, HSERVISADI, DEPOADI, CIKIS_YERI, PAKET_DURUMU, DERMAN_AD, BIRIM, PAY, KURUM
    """

    # --- K. Həkim qazancı (hakediş): 1 = icra edən, 2 = göndərən; şöbə = icra edilən xidmətin şöbəsi -----
    if hak:
        HSUM = ("SUM(CASE WHEN TO_CHAR(T.HAKEDISTURU) = '1' THEN NVL(T.HAKTUTAR, 0) ELSE 0 END) AS HK_YAPAN, "
                "SUM(CASE WHEN TO_CHAR(T.HAKEDISTURU) = '2' THEN NVL(T.HAKTUTAR, 0) ELSE 0 END) AS HK_GONDEREN")
        HW = f"T.HI_TARIH >= :start_dt AND T.HI_TARIH < :end_dt AND T.SR_ADI IN ({IN})"
        Q["hak"] = f"SELECT T.SR_ADI, {HSUM} FROM fonethbys.V_HAKEDIS_RAPOR T WHERE {HW} GROUP BY T.SR_ADI"
        dc, dn = hak.get("code"), hak.get("name")
        if dc:
            nm = f"MAX(T.{dn})" if dn else "CAST(NULL AS VARCHAR2(200))"
            Q["hak_hekim"] = (f"SELECT T.SR_ADI, TO_CHAR(T.{dc}) AS PERSKODU, {nm} AS HDOKTORADI, {HSUM} "
                              f"FROM fonethbys.V_HAKEDIS_RAPOR T WHERE {HW} GROUP BY T.SR_ADI, TO_CHAR(T.{dc})")
        elif dn:
            Q["hak_hekim"] = (f"SELECT T.SR_ADI, CAST(NULL AS VARCHAR2(50)) AS PERSKODU, T.{dn} AS HDOKTORADI, {HSUM} "
                              f"FROM fonethbys.V_HAKEDIS_RAPOR T WHERE {HW} GROUP BY T.SR_ADI, T.{dn}")

    # --- J. Dövrdə xidməti olan bütün şöbələr (dərman ötürməsinin hədəfini avtomatik tanımaq üçün) -----
    Q["klinik"] = f"""
    SELECT DISTINCT T.SR_ADI FROM fonethbys.V_IST_GENEL_HIZMET T WHERE {PERIOD_T}
    """

    # --- I. Təşkilatlar üzrə xidmət satışı (qurum payı olan bütün təşkilatlar) ----------------------
    KCOL = "T.HKURUMADI" if use_kurum else "T.HSINIFADI"
    Q["org_xidmet"] = f"""
    SELECT PAY, KURUM, COUNT(DISTINCT HK_ID) AS CEMI_QEBUL, COUNT(DISTINCT HK_KAYITKODU) AS UNIKAL_PASIYENT,
           SUM(K) AS TESKILAT_XIDMET, SUM(H) AS PASIYENT_XIDMET
    FROM (
        SELECT {PAYX} AS PAY, NVL({KCOL}, '—') AS KURUM, T.HK_ID, T.HK_KAYITKODU,
               NVL(T.HI_KTUTAR, 0) AS K, NVL(T.HI_HTUTAR, 0) AS H
        FROM fonethbys.V_IST_GENEL_HIZMET T
        WHERE {PERIOD_T}
          AND T.SR_ADI IN ({IN})
          AND NVL(T.HI_KTUTAR, 0) <> 0
    )
    GROUP BY PAY, KURUM
    """

    # --- H. Həkim üzrə təyin olunan dərman (həkim kodu xidmət statistikasındakı kodla eynidir) -------
    Q["drug_hekim"] = f"""
    SELECT T.HSERVISADI AS SR_ADI, T.OZELKOD5 AS PERSKODU, MAX(T.HDOKTORADI) AS HDOKTORADI, T.PAKET_DURUMU,
           SUM(NVL(T.SNLTUTAR, 0)) AS SATIS, SUM(NVL(T.SNLALISTUTAR, 0)) AS MAYA
    FROM fonethbys.v_stok_list_cikisfisdetay T
    WHERE T.TARIH >= :start_dt AND T.TARIH < :end_dt
      AND T.FORMTYPE IN (1, 2)
      AND T.HSERVISADI IN ({IN})
    GROUP BY T.HSERVISADI, T.OZELKOD5, T.PAKET_DURUMU
    """
    # Ehtiyat variant: view-da həkim kodu (OZELKOD5) yoxdursa — həkim adı ilə, Python-da xidmət həkiminə bağlanır
    Q["drug_hekim_alt"] = f"""
    SELECT T.HSERVISADI AS SR_ADI, CAST(NULL AS VARCHAR2(50)) AS PERSKODU, T.HDOKTORADI, T.PAKET_DURUMU,
           SUM(NVL(T.SNLTUTAR, 0)) AS SATIS, SUM(NVL(T.SNLALISTUTAR, 0)) AS MAYA
    FROM fonethbys.v_stok_list_cikisfisdetay T
    WHERE T.TARIH >= :start_dt AND T.TARIH < :end_dt
      AND T.FORMTYPE IN (1, 2)
      AND T.HSERVISADI IN ({IN})
    GROUP BY T.HSERVISADI, T.HDOKTORADI, T.PAKET_DURUMU
    """
    return Q


