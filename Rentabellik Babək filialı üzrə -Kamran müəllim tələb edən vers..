               ('="Ümumi marja "&TEXT($C$9,"0.0%")&"; həkim payı "&TEXT($K$9,"0.0%")&"; qalıq borc "&TEXT($G$9,"#,##0")&" AZN"',
                f"Ümumi marja {sf(T['dov'], T['hes']):.1%}; həkim payı {sf(T['hk'], T['hes']):.1%}; qalıq borc {T['qal']:,.0f} AZN")]
        for i, (fml, val) in enumerate(ins):
            r = c0 + 7 + i
            ws.set_row(r, 30)
