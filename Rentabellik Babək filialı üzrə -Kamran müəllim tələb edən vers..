NUM_COLS = ["XID_XESTE", "XID_TESK", "DERMAN_SATIS", "DERMAN_ALIS",
            "HK_YAPAN", "HK_GONDEREN", "AVANS", "NEGD", "QAYT"]


def build_registry(label, xid, der, hak, yat, pat, mapper, asof):
    mapper.learn(list(xid["SOBE_MENBE"]) + list(hak["SOBE_MENBE"]) + list(der["SOBE_MENBE"]) + list(yat["SOBE_MENBE"]))
    xid = xid.copy(); der = der.copy(); hak = hak.copy(); yat = yat.copy()
    xid["SOBE"] = [mapper.map(n, "Xidmət") for n in xid["SOBE_MENBE"]]
    der["SOBE"] = [mapper.map(n, "Depo") for n in der["SOBE_MENBE"]]
    hak["SOBE"] = [mapper.map(n, "Hakediş") for n in hak["SOBE_MENBE"]]
    yat["SOBE"] = [mapper.map(n, "Yatış") for n in yat["SOBE_MENBE"]]

    keys = ["HK_ID", "SOBE"]
    xg = xid.groupby(keys, as_index=False).agg(
        ILK=("ILK_TARIX", "min"), SON=("SON_TARIX", "max"),
        XID_XESTE=("XID_XESTE", "sum"), XID_TESK=("XID_TESK", "sum"))
    dg = der.groupby(keys, as_index=False).agg(DERMAN_SATIS=("DERMAN_SATIS", "sum"), DERMAN_ALIS=("DERMAN_ALIS", "sum"))
    hg = hak.groupby(keys, as_index=False).agg(HK_YAPAN=("HK_YAPAN", "sum"), HK_GONDEREN=("HK_GONDEREN", "sum"))
    yg = yat.groupby(keys, as_index=False).agg(YATIS=("YATIS_TARIXI", "min"), NEQL=("NEQL_TARIXI", "max"))

    reg = xg.merge(dg, on=keys, how="outer").merge(hg, on=keys, how="outer").merge(yg, on=keys, how="left")
    for c in ["ILK", "SON", "YATIS", "NEQL"]:
        if c not in reg: reg[c] = pd.NaT
        reg[c] = pd.to_datetime(reg[c])
    for c in ["XID_XESTE", "XID_TESK", "DERMAN_SATIS", "DERMAN_ALIS", "HK_YAPAN", "HK_GONDEREN"]:
        reg[c] = reg[c].fillna(0)

    # ödənişlərin (kumulyativ) şöbələr arasında mütənasib bölüşdürülməsi
    reg["_H"] = reg[["XID_XESTE", "XID_TESK", "DERMAN_SATIS"]].sum(axis=1)
    tot = reg.groupby("HK_ID")["_H"].transform("sum")
    cnt = reg.groupby("HK_ID")["_H"].transform("size")
    reg["_share"] = (reg["_H"] / tot).where(tot != 0, 1.0 / cnt)

    pay = pat[["HK_ID", "AVANS_K", "NEGD_K", "QAYT_K"]].rename(
        columns={"AVANS_K": "AVANS", "NEGD_K": "NEGD", "QAYT_K": "QAYT"})
    reg = reg.merge(pay, on="HK_ID", how="left")
    for c in ["AVANS", "NEGD", "QAYT"]:
        reg[c] = reg[c].fillna(0) * reg["_share"]

    # ödənişi olub, heç bir xidmət/dərmanı olmayan xəstələr
    orphan = pay[~pay["HK_ID"].isin(reg["HK_ID"])]
    orphan = orphan[(orphan[["AVANS", "NEGD", "QAYT"]].abs().sum(axis=1)) > 0].copy()
    if len(orphan):
        orphan["SOBE"] = "Bölüşdürülməyib"
        reg = pd.concat([reg, orphan], ignore_index=True)
    reg = reg.drop(columns=["_H", "_share"])
    for c in NUM_COLS:
        reg[c] = reg[c].fillna(0)

    # xəstə atributları
    attr = pat[["HK_ID", "KOD", "HASTA_TURU", "HSINIF", "MURACIET", "CIXIS"]].drop_duplicates("HK_ID")
    reg = reg.merge(attr, on="HK_ID", how="left")
    reg["KOD"] = reg["KOD"].fillna(reg["HK_ID"].map(lambda x: f"ID{int(x)}"))
    reg["HASTA_TURU"] = reg["HASTA_TURU"].fillna("")
    reg["STATUS"] = reg["HSINIF"].map({1: "Ödənişli", 2: "Sığortalı"}).fillna(
        reg["HSINIF"].map(lambda v: "" if pd.isna(v) else "Digər"))
    for c in ["MURACIET", "CIXIS"]:
        reg[c] = pd.to_datetime(reg[c])
    reg.insert(0, "AY", label)

    # yatış günü: (nəql tarixi, yoxsa çıxış tarixi, yoxsa hesabat tarixi) − yatış tarixi; minimum 1; ambulatorda boş
    end = reg["NEQL"].fillna(reg["CIXIS"]).fillna(pd.Timestamp(asof))
    gun = (end.dt.normalize() - reg["YATIS"].dt.normalize()).dt.days
    reg["YATIS_GUN"] = gun.clip(lower=1).where(reg["YATIS"].notna())

    # hesablanan sütunlar (Excel-də formul kimi yazılır, burada nəzarət üçün)
    reg["XID_CEMI"] = reg["XID_XESTE"] + reg["XID_TESK"]
    reg["HESABLANMIS"] = reg["XID_CEMI"] + reg["DERMAN_SATIS"]
    reg["ODENILMIS"] = reg["AVANS"] + reg["NEGD"] - reg["QAYT"]
    reg["QALIQ"] = reg["HESABLANMIS"] - reg["ODENILMIS"]
    reg["HK_CEMI"] = reg["HK_YAPAN"] + reg["HK_GONDEREN"]
    reg["DOVRIYYE"] = reg["HESABLANMIS"] - reg["DERMAN_ALIS"] - reg["HK_CEMI"]
    reg = reg.sort_values(["SOBE", "KOD"]).reset_index(drop=True)
    # unikal xəstə sayı üçün: hər HK_ID-nin ilk sətri = 1 (distinct HK_ID)
    reg["UNIKAL"] = (~reg.duplicated("HK_ID")).astype(int)
    return reg


def build_derman_ay(label, df, mapper):
    """Şöbə icmalı üçün: dərman işlənmə tarixinə görə (depo -> şöbə)."""
    cols = ["AY", "SOBE", "DERMAN_SATIS", "DERMAN_ALIS"]
    if df.empty:
        return pd.DataFrame(columns=cols)
    df = df.copy()
    df["SOBE"] = [mapper.map(n, "Depo") for n in df["SOBE_MENBE"]]
    g = df.groupby("SOBE", as_index=False).agg(DERMAN_SATIS=("DERMAN_SATIS", "sum"), DERMAN_ALIS=("DERMAN_ALIS", "sum"))
    g.insert(0, "AY", label)
    return g[cols]


def build_patient_sheet(label, pat):
    p = pat.copy()
    p.insert(0, "AY", label)
    p["STATUS"] = p["HSINIF"].map({1: "Ödənişli", 2: "Sığortalı"}).fillna("Digər")
    p["BORC_K"] = p["AVANS_K"] + p["NEGD_K"] - (p["XID_K"] + p["DERMAN_K"] + p["QAYT_K"])
    # yalnız əməliyyatı və ya ödənişi olan xəstələr
    act = p[["AVANS_K", "NEGD_K", "XID_K", "DERMAN_K", "QAYT_K"]].abs().sum(axis=1) > 0
    return p[act].reset_index(drop=True)


