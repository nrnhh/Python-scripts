    ws.merge_range(r_dother, 0, r_dother, 2, "Digər (depo / bölüşdürülməyən)", ot_t)
    ws.write_blank(r_dother, 3, None, ot_n)
    for col, key in (("E", "hes"), ("F", "da"), ("G", "hk"), ("K", "od")):
        ci = ord(col) - 65
        rng = f"{col}{r_d0+1}:{col}{r_d1+1}" if nd else f"{col}1:{col}1"
