        ws.write_formula(r, 6, f'=SUMIFS({R("HK_CEMI")},{R("SOBE")},$A{x},{R("AY")},{HELP})', td_n, v["hk"])
        ws.write_formula(r, 7, f"=E{x}-F{x}-G{x}", td_n, v["dov"])
        ws.write_formula(r, 8, f"=IFERROR(H{x}/E{x},0)", td_p, sf(v["dov"], v["hes"]))
        ws.write_formula(r, 9, f"=IFERROR(H{x}/$H${tx},0)", td_p, sf(v["dov"], T["dov"]))
        ws.write_formula(r, 10, f'=SUMIFS({R("ODENILMIS")},{R("SOBE")},$A{x},{R("AY")},{HELP})', td_n, v["od"])
        ws.write_formula(r, 11, f"=E{x}-K{x}", td_n, v["qal"])
    # "Digər" sətri: cəmi − şöbələrin cəmi
    xo = r_dother + 1
    sums = {k: sum(dv[s][k] for s in deps) for k in ("hes", "da", "hk", "dov", "od", "qal")}
