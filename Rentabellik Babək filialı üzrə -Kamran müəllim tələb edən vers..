    ot_n = F(italic=True, border=1, border_color=bc, font_color="#595959", num_format="#,##0;[Red]-#,##0")
    ot_p = F(italic=True, border=1, border_color=bc, font_color="#595959", num_format="0.0%;[Red]-0.0%")
    f_ins = F(font_size=10, text_wrap=True, valign="vcenter", indent=1, bg_color="#F7F9FC", border=1, border_color=bc)
    f_note = F(font_size=9, font_color="#404040", text_wrap=True, valign="top", indent=1)

    # ---------- keş dəyərləri (Excel açılanda formullar yenidən hesablanır) ----------
    def agg(rg, dg):
        xid = float(rg["XID_CEMI"].sum()); ds = float(dg["DERMAN_SATIS"].sum()); da = float(dg["DERMAN_ALIS"].sum())
        hk = float(rg["HK_CEMI"].sum()); od = float(rg["ODENILMIS"].sum()); hes = xid + ds
        return dict(pat=int(rg["UNIKAL"].sum()), rows=len(rg), xid=xid, ds=ds, hes=hes, da=da, hk=hk, od=od,
                    dov=hes - da - hk, qal=hes - od)
    sf = lambda a, b: a / b if b else 0.0
    T = agg(reg, derm)
    mon = {m: agg(reg[reg["AY"] == m], derm[derm["AY"] == m]) for m in aylar}
    deps = sorted((set(reg["SOBE"]) | set(derm["SOBE"])) - NOT_DEPT)
    dv = {s: agg(reg[reg["SOBE"] == s], derm[derm["SOBE"] == s]) for s in deps}
    deps.sort(key=lambda s: -dv[s]["dov"])
    nd, nm = len(deps), len(aylar)

    # ---------- yerləşmə ----------
    r_mbar, r_mhead = 10, 11
