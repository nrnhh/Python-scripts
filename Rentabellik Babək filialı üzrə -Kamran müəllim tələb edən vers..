def _to_end(col):
    return f"{col} < :d3"


# --- borc hesabatındakı alt-sorğuların eyni məntiqi (kumulyativ, :d3-ə qədər) ---
def _avans(c):
    return ("(SELECT SUM(v.TUTAR) FROM FONETHBYSADM.VZN_GIRISLER_DETAY v "
            "JOIN FONETHBYSADM.VZN_GIRISLER v1 ON v.FISID = v1.ID "
            f"WHERE v1.HK_ID = t.HK_ID AND {c('v1.TARIH')})")


def _negd(c):
    return ("(SELECT SUM(h.TUTAR) FROM FONETHBYSADM.VZN_TAHSILAT h1 "
            "JOIN FONETHBYSADM.VZN_TAHSILAT_ALT h ON h.FIS_ID = h1.ID "
            "WHERE h1.HKID = t.HK_ID AND COALESCE(h.IADEDURUM, 'H') = 'H' "
            "AND NOT EXISTS (SELECT 1 FROM FONETHBYSADM.VZN_AVANSHARCAMA h2 "
            "WHERE h2.TAHSILAT_ID = h1.ID AND h2.TAHSILAT_ID IS NOT NULL) "
            f"AND {c('h1.TARIH')})")


def _xid(c):
    return ("(SELECT SUM(j.HI_MIKTAR * CASE WHEN j.HI_ODTURU = 'Sigortalı' THEN j.HI_KFIYAT ELSE j.HI_HFIYAT END) "
            f"FROM FONETHBYS.H_HASTAKAYIT_ALT j WHERE j.HI_KAYITID = t.HK_ID AND {c('j.HI_TARIH')})")


def _derman(c):
    return ("(SELECT ROUND(SUM(y.MIKTAR * y.FIYAT), 2) FROM FONETHBYS.STOK_CIKISDETAY y "
            f"WHERE y.HASTA_HKID = t.HK_ID AND {c('y.TARIH')})")


def _avansdan(c):
    return ("(SELECT SUM(a.TUTAR) FROM FONETHBYSADM.VZN_AVANSHARCAMA a "
            f"WHERE a.HK_ID = t.HK_ID AND {c('a.ETAR')})")


def _qayt(c):
    return ("(SELECT SUM(yy.ODENEN_TUTAR) FROM FONETHBYSADM.VZN_ODEMELER_DETAY yy "
            f"WHERE yy.ilgi_fisid = t.HK_ID AND yy.ODEME_TURU = 41 AND {c('yy.TARIH')})")


def build_patient_sql():
    z = lambda s: f"COALESCE({s}, 0)"
    return f"""
SELECT t.HK_ID,
       t.hk_kodu AS KOD,
       t.hk_hastaturu AS HASTA_TURU,
       t.hk_HSINIFID AS HSINIF,
       t.HK_MURACAATTAR AS MURACIET,
       t.HK_CIKISTARIHI AS CIXIS,
       {z(_avans(_to_end))}      AS AVANS_K,
       {z(_negd(_to_end))}       AS NEGD_K,
       {z(_xid(_to_end))}        AS XID_K,
       {z(_derman(_to_end))}     AS DERMAN_K,
       {z(_avansdan(_to_end))}   AS AVANSDAN_K,
       {z(_qayt(_to_end))}       AS QAYT_K
FROM FONETHBYS.H_HASTAKAYIT t
WHERE t.Hk_Durum = '+'
  AND t.HK_MURACAATTAR >= :d1 AND t.HK_MURACAATTAR < :d2
"""


# ============================================================================
#  ŞÖBƏ ADLARININ BİRLƏŞDİRİLMƏSİ (servis adı / depo adı -> şöbə)
# ============================================================================
SUFFIX_RE = re.compile(r"\s+(teserrufat|təsərrüfat|tes\.?)\s*$", re.I)
SOBE_WORD_RE = re.compile(r"\s+(şöbəsi|şöbə|sobesi|sobe)\s*$", re.I)
NOT_SOBE_KEYWORDS = ("envanter", "cihaz", "deposit")
NOT_SOBE_LABEL = "Depo (şöbəyə aid deyil)"


def _key(name):
    n = str(name).strip()
    n = SUFFIX_RE.sub("", n)
    n = SOBE_WORD_RE.sub("", n)
    return n.casefold()


class SobeMapper:
    def __init__(self, manual=None):
        self.manual = manual or {}
        self.display = {}     # key -> göstərilən ad
        self.log = {}         # (menbe_ad, növ) -> (şöbə, üsul)

    def learn(self, names):
        """Servis adları (təsərrüfat/depo olmayan) göstərilən ad kimi üstünlük alır."""
        for n in names:
            if pd.isna(n):
                continue
            n = str(n).strip()
            if SUFFIX_RE.search(n):
                continue
            self.display.setdefault(_key(n), n)

    def map(self, name, kind):
        if pd.isna(name) or str(name).strip() == "":
            res, how = "Təyin olunmayıb", "boş"
        else:
            n = str(name).strip()
            if n in self.manual:
                res, how = self.manual[n], "əl ilə"
            elif any(k in n.casefold() for k in NOT_SOBE_KEYWORDS):
                res, how = NOT_SOBE_LABEL, "avtomatik"
            else:
                k = _key(n)
                res, how = self.display.get(k, SUFFIX_RE.sub("", n).strip()), "avtomatik"
        self.log[(str(name), kind)] = (res, how)
        return res


def load_mapping(path):
    if path and os.path.exists(path):
        df = pd.read_csv(path, sep=";", dtype=str, encoding="utf-8-sig")
        return dict(zip(df["menbe_ad"].str.strip(), df["sobe"].str.strip()))
    return {}


