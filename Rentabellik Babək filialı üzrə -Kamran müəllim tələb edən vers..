    ws.write_formula(r_dother, 11, f"=E{xo}-K{xo}", ot_n, oth["qal"])
    # CƏMİ (KPI kartlarına bərabərdir)
    ws.merge_range(r_dtot, 0, r_dtot, 2, "CƏMİ", tt_t)
    for ci, f_, val, fm in ((3, "=A6", T["pat"], tt_n), (4, "=G6", T["hes"], tt_n), (5, "=I6", T["da"], tt_n),
