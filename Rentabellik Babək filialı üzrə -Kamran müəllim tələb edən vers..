    # ---------- şöbələr üzrə cədvəl ----------
    ws.set_row(r_dbar, 22)
    ws.merge_range(r_dbar, 0, r_dbar, 11, "ŞÖBƏLƏR ÜZRƏ NƏTİCƏ (dövriyyəyə görə sıralanıb)", sect)
    ws.set_row(r_dhead, 32)
    ws.merge_range(r_dhead, 0, r_dhead, 2, "Şöbə", th)
    for c, h in enumerate(["Xəstə sayı", "Cəmi hesablanmış", "Dərman alış", "Həkim qazancı", "Dövriyyə (xalis)",
                           "Marja", "Dövriyyədə pay", "Ödənilmiş", "Qalıq borc"], start=3):
