                   "values": [SN, r_m0, 7, r_mtot - 1, 7], "line": {"color": NAVY, "width": 2.5},
                   "marker": {"type": "circle", "size": 6, "fill": {"color": NAVY}, "border": {"color": NAVY}}})
    ch1.combine(ln)
    ch1.set_title({"name": "Aylıq dinamika (AZN)", "name_font": {"name": "Arial", "size": 11, "bold": True}})
    ch1.set_legend({"position": "bottom", "font": {"name": "Arial", "size": 9}})
    ch1.set_y_axis({"num_format": "#,##0", "num_font": {"name": "Arial", "size": 8}, "major_gridlines": {"visible": True, "line": {"color": "#E0E0E0"}}})
    ch1.set_x_axis({"num_font": {"name": "Arial", "size": 8}})
    ch1.set_size({"width": 555, "height": 320})
    ws.insert_chart(r_chart, 0, ch1, {"x_offset": 2, "y_offset": 6})
    if nd:
        n10 = min(10, nd)
        ch2 = wb.add_chart({"type": "bar"})
        ch2.add_series({"name": "Dövriyyə (xalis)", "categories": [SN, r_d0, 0, r_d0 + n10 - 1, 0],
                        "values": [SN, r_d0, 7, r_d0 + n10 - 1, 7], "fill": {"color": BLUE}, "gap": 50,
                        "data_labels": {"value": True, "num_format": "#,##0", "font": {"name": "Arial", "size": 8}}})
        ch2.set_title({"name": f"Dövriyyə üzrə ilk {n10} şöbə (AZN)", "name_font": {"name": "Arial", "size": 11, "bold": True}})
        ch2.set_legend({"none": True})
        ch2.set_y_axis({"reverse": True, "num_font": {"name": "Arial", "size": 8}})
        ch2.set_x_axis({"num_format": "#,##0", "num_font": {"name": "Arial", "size": 8}, "major_gridlines": {"visible": True, "line": {"color": "#E0E0E0"}}})
        ch2.set_size({"width": 555, "height": 320})
        ws.insert_chart(r_chart, 6, ch2, {"x_offset": 8, "y_offset": 6})

    # ---------- gəlir tərkibi + müşahidələr ----------
    ws.set_row(r_kbar, 22)
    ws.merge_range(r_kbar, 0, r_kbar, 11, "GƏLİR TƏRKİBİ VƏ ƏSAS MÜŞAHİDƏLƏR", sect)
    c0 = r_k0
    ws.merge_range(c0, 0, c0, 2, "Gəlir tərkibi", th); ws.write(c0, 3, "Məbləğ", th); ws.write(c0, 4, "Pay", th)
    comp = [("Xidmət – xəstə məbləği", f'=SUMIFS({R("XID_XESTE")},{R("AY")},{HELP})', float(reg["XID_XESTE"].sum())),
            ("Xidmət – təşkilat məbləği", f'=SUMIFS({R("XID_TESK")},{R("AY")},{HELP})', float(reg["XID_TESK"].sum())),
            ("Dərman satışı", "=E6", T["ds"])]
    ctot = sum(v for *_a, v in comp); xt = c0 + 5
    for i, (lab, fml, val) in enumerate(comp):
        r = c0 + 1 + i
        ws.merge_range(r, 0, r, 2, lab, td_t)
        ws.write_formula(r, 3, fml, td_n, val)
        ws.write_formula(r, 4, f"=IFERROR(D{r+1}/D${xt-0},0)", td_p, sf(val, ctot))
    ws.merge_range(c0 + 4, 0, c0 + 4, 2, "Cəmi", tt_t)
    ws.write_formula(c0 + 4, 3, f"=SUM(D{c0+2}:D{c0+4})", tt_n, ctot)
    ws.write_formula(c0 + 4, 4, f"=IFERROR(D{c0+5}/D{c0+5},0)", tt_p, 1.0 if ctot else 0.0)
    for i in range(3):   # pay formulunun məxrəci: cəmi sətri
        r = c0 + 1 + i
        ws.write_formula(r, 4, f"=IFERROR(D{r+1}/D${c0+5},0)", td_p, sf(comp[i][2], ctot))
    ch3 = wb.add_chart({"type": "doughnut"})
    ch3.add_series({"name": "Gəlir tərkibi", "categories": [SN, c0 + 1, 0, c0 + 3, 0], "values": [SN, c0 + 1, 3, c0 + 3, 3],
                    "data_labels": {"percentage": True, "font": {"name": "Arial", "size": 9, "bold": True, "color": "#FFFFFF"}},
                    "points": [{"fill": {"color": NAVY}}, {"fill": {"color": "#5B9BD5"}}, {"fill": {"color": "#ED7D31"}}]})
    ch3.set_hole_size(50)
    ch3.set_title({"name": "Gəlir tərkibi", "name_font": {"name": "Arial", "size": 11, "bold": True}})
    ch3.set_legend({"position": "right", "font": {"name": "Arial", "size": 9}})
    ch3.set_size({"width": 555, "height": 300})
    ws.insert_chart(c0, 6, ch3, {"x_offset": 8, "y_offset": 2})
    ws.merge_range(c0 + 6, 0, c0 + 6, 5, "Əsas müşahidələr", th)
    if nd:
        d0x, d1x = r_d0 + 1, r_d1 + 1
        rngH, rngA, rngD = f"$H${d0x}:$H${d1x}", f"$A${d0x}:$A${d1x}", f"$D${d0x}:$D${d1x}"
        topd = deps[0]; topn = max(deps, key=lambda s: dv[s]["rows"])
        ins = [(f'="Ən yüksək dövriyyə: "&INDEX({rngA},MATCH(MAX({rngH}),{rngH},0))&" — "&TEXT(MAX({rngH}),"#,##0")&" AZN"',
                f"Ən yüksək dövriyyə: {topd} — {dv[topd]['dov']:,.0f} AZN"),
               (f'="Ən çox xəstə: "&INDEX({rngA},MATCH(MAX({rngD}),{rngD},0))&" — "&TEXT(MAX({rngD}),"#,##0")&" xəstə"',
