        ws.write_formula(r_dtot, ci, f_, fm, val)
    ws.write_formula(r_dtot, 8, f"=IFERROR(H{tx}/E{tx},0)", tt_p, sf(T["dov"], T["hes"]))
    ws.write_formula(r_dtot, 9, f"=SUM(J{r_d0+1}:J{r_dother+1})", tt_p, 1.0 if T["dov"] else 0.0)
    if nd:
