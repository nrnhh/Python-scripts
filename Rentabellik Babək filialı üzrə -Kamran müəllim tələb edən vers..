            wz.write(i, 0, a, F(bold=True, border=1, valign="top")); wz.write(i, 1, b, F(border=1, text_wrap=True, valign="top"))
        xw.sheets["Rəhbərlik icmalı"] = SH["Rəhbərlik icmalı"]
        write_exec_sheet(wb, SH["Rəhbərlik icmalı"], F, R, DR, reg, derm, src_ay, aylar, asof)
        SH["Rəhbərlik icmalı"].activate(); SH["Rəhbərlik icmalı"].set_first_sheet()


