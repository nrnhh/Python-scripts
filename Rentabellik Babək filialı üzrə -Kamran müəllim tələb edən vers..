    r_dhead = r_dbar + 1; r_d0 = r_dhead + 1; r_d1 = r_d0 + nd - 1
    r_dother = r_d0 + nd; r_dtot = r_dother + 1
    r_nbar = r_dtot + 2

    ws.hide_gridlines(2)
    ws.set_column(0, 11, 13)
    ws.set_column(13, 13, 10, None, {"hidden": True})
    ws.set_tab_color(NAVY)

    # ---------- başlıq ----------
    ws.set_row(0, 38); ws.set_row(1, 20); ws.set_row(2, 26)
    ws.merge_range(0, 0, 0, 11, "BABƏK FİLİALI — ŞÖBƏLƏR ÜZRƏ MALİYYƏ PERFORMANS HESABATI", f_title)
    ws.merge_range(1, 0, 1, 11, f"Məlumat tarixi: {asof:%d.%m.%Y}     |     Məbləğlər AZN ilə     |     "
                                f"Xəstələr müraciət ayına görə qruplaşdırılıb", f_sub)
    ws.merge_range(2, 0, 2, 1, "Hesabat ayı (seçin):", f_sel_l)
    ws.write(2, 2, ALL, f_sel)
    ws.data_validation(2, 2, 2, 2, {"validate": "list", "source": src_ay})
    ws.merge_range(2, 3, 2, 11, "Ayı dəyişdikdə göstəricilər, tərkib qrafiki və şöbə cədvəli yenilənir. Aylıq dinamika həmişə bütün ayları göstərir.", f_hint)
    ws.write_formula(2, 13, '=IF($C$3="Hamısı","*",$C$3)', None, "*")

    # ---------- KPI kartları ----------
    kcols = ["A", "C", "E", "G", "I", "K"]
    row1 = [("XƏSTƏ SAYI", f'=SUMIFS({R("UNIKAL")},{R("AY")},{HELP})', T["pat"], t_int),
            ("XİDMƏT CƏMİ", f'=SUMIFS({R("XID_CEMI")},{R("AY")},{HELP})', T["xid"], t_int),
            ("DƏRMAN SATIŞI", f'=SUMIFS({DR("C")},{DR("A")},{HELP})', T["ds"], t_int),
            ("CƏMİ HESABLANMIŞ", "=C6+E6", T["hes"], t_int),
            ("DƏRMAN ALIŞ (MAYA)", f'=SUMIFS({DR("D")},{DR("A")},{HELP})', T["da"], t_int),
            ("HƏKİM QAZANCI", f'=SUMIFS({R("HK_CEMI")},{R("AY")},{HELP})', T["hk"], t_int)]
    row2 = [("DÖVRİYYƏ (XALİS)", "=G6-I6-K6", T["dov"], t_int),
            ("DÖVRİYYƏ MARJASI", "=IFERROR(A9/G6,0)", sf(T["dov"], T["hes"]), t_pct),
            ("ÖDƏNİLMİŞ MƏBLƏĞ", f'=SUMIFS({R("ODENILMIS")},{R("AY")},{HELP})', T["od"], t_int),
            ("QALIQ BORC", "=G6-E9", T["qal"], t_int),
            ("XƏSTƏ BAŞINA ORTA", "=IFERROR(G6/A6,0)", sf(T["hes"], T["pat"]), t_int),
            ("HƏKİM PAYI", "=IFERROR(K6/G6,0)", sf(T["hk"], T["hes"]), t_pct)]
    for (rl, rv), tiles in (((4, 5), row1), ((7, 8), row2)):
        ws.set_row(rl, 20); ws.set_row(rv, 38)
        for k, (lab, fml, val, fmt) in enumerate(tiles):
            c = 2 * k
            ws.merge_range(rl, c, rl, c + 1, lab, t_lab)
            ws.merge_range(rv, c, rv, c + 1, "", fmt)
            ws.write_formula(rv, c, fml, fmt, val)
    ws.set_row(6, 8)

    # ---------- aylıq dinamika ----------
    ws.set_row(r_mbar, 22)
    ws.merge_range(r_mbar, 0, r_mbar, 11, "AYLIQ DİNAMİKA", sect)
    heads = ["Ay", "Xəstə sayı", "Xidmət", "Dərman satış", "Cəmi hesablanmış", "Dərman alış", "Həkim qazancı",
             "Dövriyyə (xalis)", "Marja", "Ödənilmiş", "Qalıq borc", "Xəstə başına orta"]
    ws.set_row(r_mhead, 32)
    for c, h in enumerate(heads): ws.write(r_mhead, c, h, th)
    for i, m in enumerate(aylar):
        r = r_m0 + i; x = r + 1; v = mon[m]
        ws.write(r, 0, m, td_c)
        ws.write_formula(r, 1, f'=SUMIFS({R("UNIKAL")},{R("AY")},$A{x})', td_n, v["pat"])
        ws.write_formula(r, 2, f'=SUMIFS({R("XID_CEMI")},{R("AY")},$A{x})', td_n, v["xid"])
        ws.write_formula(r, 3, f'=SUMIFS({DR("C")},{DR("A")},$A{x})', td_n, v["ds"])
        ws.write_formula(r, 4, f"=C{x}+D{x}", td_n, v["hes"])
        ws.write_formula(r, 5, f'=SUMIFS({DR("D")},{DR("A")},$A{x})', td_n, v["da"])
        ws.write_formula(r, 6, f'=SUMIFS({R("HK_CEMI")},{R("AY")},$A{x})', td_n, v["hk"])
        ws.write_formula(r, 7, f"=E{x}-F{x}-G{x}", td_n, v["dov"])
        ws.write_formula(r, 8, f"=IFERROR(H{x}/E{x},0)", td_p, sf(v["dov"], v["hes"]))
        ws.write_formula(r, 9, f'=SUMIFS({R("ODENILMIS")},{R("AY")},$A{x})', td_n, v["od"])
        ws.write_formula(r, 10, f"=E{x}-J{x}", td_n, v["qal"])
        ws.write_formula(r, 11, f"=IFERROR(E{x}/B{x},0)", td_n, sf(v["hes"], v["pat"]))
    x = r_mtot + 1; a, b = r_m0 + 1, r_mtot
    ws.write(r_mtot, 0, "CƏMİ", tt_t)
    tv = dict(B=T["pat"], C=T["xid"], D=T["ds"], E=T["hes"], F=T["da"], G=T["hk"], H=T["dov"], J=T["od"], K=T["qal"])
    for col, val in tv.items():
        ci = ord(col) - 65
        ws.write_formula(r_mtot, ci, f"=SUM({col}{a}:{col}{b})", tt_n, val)
    ws.write_formula(r_mtot, 8, f"=IFERROR(H{x}/E{x},0)", tt_p, sf(T["dov"], T["hes"]))
    ws.write_formula(r_mtot, 11, f"=IFERROR(E{x}/B{x},0)", tt_n, sf(T["hes"], T["pat"]))

    # ---------- qrafiklər ----------
    ws.set_row(r_cbar, 22)
    ws.merge_range(r_cbar, 0, r_cbar, 11, "DİNAMİKA VƏ ŞÖBƏ REYTİNQİ", sect)
