def month_ranges(start, end):
    y, m = map(int, start.split("-")); ye, me = map(int, end.split("-"))
    out = []
    while (y, m) <= (ye, me):
        d1 = date(y, m, 1)
        y2, m2 = (y + 1, 1) if m == 12 else (y, m + 1)
        out.append((f"{y:04d}-{m:02d}", d1, date(y2, m2, 1)))
        y, m = y2, m2
    return out


def fetch_month(conn, d1, d2, d3):
    allp = {"d1": d1, "d2": d2, "d3": d3}

    def q(sql):   # yalnız SQL-də istifadə olunan bind-ləri ötür
        return pd.read_sql(sql, conn, params={k: v for k, v in allp.items() if f":{k}" in sql})
    return q(SQL_XIDMET), q(SQL_DERMAN), q(SQL_HAKEDIS), q(SQL_YATIS), q(build_patient_sql()), q(SQL_DERMAN_AY)


def demo_month(label, d1, seed=7):
    import numpy as np
    rng = np.random.default_rng(seed)
    sr = ["Reanimasiya Şöbəsi", "Pediatriya Reanimasiya", "Cərrahiyyə Şöbəsi", "Terapiya Şöbəsi", "Ambulator Qəbul"]
    depo = ["Reanimasiya Şöbəsi", "Reanimasiya Teserrufat", "Pediatriya Reanimasiya", "Pediatriya Reanimasiya Tes.",
            "Cərrahiyyə Şöbəsi", "Terapiya Şöbəsi", "Reanimasiya Cihaz Ve Envanter Deposu"]
    ids = list(range(1000, 1060))
    ts = lambda: pd.Timestamp(d1) + pd.Timedelta(days=int(rng.integers(0, 40)))
    xr, dr, hr, yr = [], [], [], []
    for h in ids:
        for s in rng.choice(sr, size=int(rng.integers(1, 3)), replace=False):
            a, b = ts(), ts()
            xr.append(dict(HK_ID=h, SOBE_MENBE=s, ILK_TARIX=min(a, b), SON_TARIX=max(a, b),
                           XID_XESTE=round(rng.uniform(0, 900), 2), XID_TESK=round(rng.uniform(0, 600) * (h % 3 == 0), 2)))
            hr.append(dict(HK_ID=h, SOBE_MENBE=s, HK_YAPAN=round(rng.uniform(0, 150), 2), HK_GONDEREN=round(rng.uniform(0, 40), 2)))
            if h % 2:
                yr.append(dict(HK_ID=h, SOBE_MENBE=s, YATIS_TARIXI=min(a, b), NEQL_TARIXI=max(a, b)))
        for d in rng.choice(depo, size=int(rng.integers(0, 3)), replace=False):
            v = round(rng.uniform(5, 400), 2)
            dr.append(dict(HK_ID=h, SOBE_MENBE=d, DERMAN_SATIS=v, DERMAN_ALIS=round(v * 0.65, 2)))
    xid, der, hak, yat = pd.DataFrame(xr), pd.DataFrame(dr), pd.DataFrame(hr), pd.DataFrame(yr)
    pr = []
    for h in ids + [2001, 2002]:
        xs = float(xid.loc[xid.HK_ID == h, ["XID_XESTE", "XID_TESK"]].sum().sum())
        ds = float(der.loc[der.HK_ID == h, "DERMAN_SATIS"].sum())
        av = round(rng.uniform(0, 500), 2) if h % 2 else 0.0
        ng = round((xs + ds) * rng.uniform(0.2, 0.9), 2)
        pr.append(dict(HK_ID=h, KOD=f"GG{h}", HASTA_TURU=("Y-Yatan" if h % 2 else "A-Ayaktan"), HSINIF=int(rng.choice([1, 2])),
                       MURACIET=pd.Timestamp(d1) + pd.Timedelta(days=int(rng.integers(0, 28))),
                       CIXIS=pd.NaT if h % 4 == 0 else pd.Timestamp(d1) + pd.Timedelta(days=30),
                       AVANS_K=av, NEGD_K=ng, XID_K=xs, DERMAN_K=ds, AVANSDAN_K=0.0, QAYT_K=0.0))
    dfay = der.groupby("SOBE_MENBE", as_index=False)[["DERMAN_SATIS", "DERMAN_ALIS"]].sum()
    return xid, der, hak, yat, pd.DataFrame(pr), dfay


def unique_name(base):
    if not os.path.exists(base): return base
    stem, ext = os.path.splitext(base); i = 1
    while os.path.exists(f"{stem}_{i}{ext}"): i += 1
    return f"{stem}_{i}{ext}"


def main():
    ap = argparse.ArgumentParser()
    today = date.today()
    # defolt: cari ilin yanvarından bu günə qədər (arqumentsiz işlədəndə bütün il)
    ap.add_argument("--from", dest="start", default=f"{today.year}-01")
    ap.add_argument("--to", dest="end", default=None)
    ap.add_argument("--asof", default=None, help="YYYY-MM-DD: bu tarixə qədər (daxil) olan əməliyyatlar; defolt: bu gün")
    ap.add_argument("--demo", action="store_true")
    ap.add_argument("--mapping", default="sobe_mapping.csv")
    ap.add_argument("--out", default=".")
    a = ap.parse_args()
    a.end = a.end or today.strftime("%Y-%m")   # defolt: cari ay (gələcək aylar avtomatik atılır)
    asof = date.fromisoformat(a.asof) if a.asof else today
    d3 = asof + timedelta(days=1)

    mapper = SobeMapper(load_mapping(a.mapping))
    regs, pats, ders = [], [], []
    conn = None

    if not a.demo:
        import oracledb
        cdir = os.environ.get("ORACLE_CLIENT_DIR", INSTANT_CLIENT_DIR)
        if cdir and os.path.exists(cdir):
            try:
                oracledb.init_oracle_client(lib_dir=cdir)
            except Exception as e:
                print("Oracle Client xəbərdarlığı:", e)

        user = os.environ.get("DB_USER", DB_USER)
        pw   = os.environ.get("DB_PASS", DB_PASS)
        dsn  = os.environ.get("DB_DSN", DB_DSN)
        conn = oracledb.connect(user=user, password=pw, dsn=dsn)

    try:
        for label, d1, d2 in month_ranges(a.start, a.end):
            if d1 > asof:
                print(f"→ {label} atlandı (hesabat tarixindən sonradır)")
                continue
            print(f"→ {label} (müraciət ayı) emal edilir...")
            xid, der, hak, yat, pat, dfay = demo_month(label, d1) if a.demo else fetch_month(conn, d1, d2, d3)
            print(f"   {label}: xəstə={len(pat)}, xidmət sətri={len(xid)}, dərman(xəstə)={len(der)}, "
                  f"hakediş={len(hak)}, dərman(işlənmə)={len(dfay)}")
            if pat.empty and dfay.empty:
                print(f"   {label}: məlumat yoxdur, atlandı")
                continue
            mapper.learn(sum((list(f["SOBE_MENBE"]) for f in (xid, der, hak, yat, dfay)), []))
            regs.append(build_registry(label, xid, der, hak, yat, pat, mapper, asof))
            ders.append(build_derman_ay(label, dfay, mapper))
            pats.append(build_patient_sheet(label, pat))
    finally:
        if conn:
            conn.close()

    reg_df = pd.concat(regs, ignore_index=True)
    pat_df = pd.concat(pats, ignore_index=True)
    derm_df = pd.concat(ders, ignore_index=True)
    if reg_df.empty:
        sys.exit("Seçilmiş dövr üçün məlumat tapılmadı.")

    os.makedirs(a.out, exist_ok=True)
    fname = f"sobe_maliyye_reyestri_{a.start}" + (f"_{a.end}" if a.end != a.start else "") + (".DEMO" if a.demo else "") + ".xlsx"
    out_path = unique_name(os.path.join(a.out, fname))

    print(f"→ Hesabata düşən aylar: {', '.join(sorted(reg_df['AY'].unique()))}")
    print("→ Excel faylı yazılır...")
    write_workbook(out_path, reg_df, pat_df, derm_df, mapper, asof)
    print(f"✓ Hazırdır: {out_path}")


if __name__ == "__main__":
    main()
