def compute_stats(df: pd.DataFrame, hist: pd.DataFrame, report_day: date) -> dict:
    st: dict = {}
    st["total_ops"] = len(df)
    st["total_amount"] = float(df["Məbləğ"].sum()) if len(df) else 0.0
    st["patients"] = int(df["FİN"].fillna(df["Protokol no"]).nunique()) if len(df) else 0
    st["visits"] = int(df["Protokol no"].nunique()) if len(df) else 0

    # 7 günlük trend (boş günlər 0 kimi sayılır)
    days = [report_day - timedelta(days=i) for i in range(1, TREND_DAYS + 1)]
    if len(hist):
        daily = hist.groupby("gun").agg(cnt=("Məbləğ", "size"), amt=("Məbləğ", "sum")).reindex(days, fill_value=0)
    else:
        daily = pd.DataFrame({"cnt": 0, "amt": 0.0}, index=days)
    st["avg_cnt"] = float(daily["cnt"].mean())
    st["avg_amt"] = float(daily["amt"].mean())
    st["trend_days"] = [(d, int(daily.loc[d, "cnt"]), float(daily.loc[d, "amt"])) for d in reversed(days)]

    if not len(df):
        return st

    for lvl, key in ((LVL_HIGH, "high"), (LVL_MED, "med"), (LVL_LOW, "low"), (LVL_OK, "ok")):
        sub = df[df["Risk səviyyəsi"] == lvl]
        st[f"{key}_cnt"], st[f"{key}_amt"] = len(sub), float(sub["Məbləğ"].sum())

    paid = df[df["Ödəniş növü"] == PAID]
    st["paid_cnt"], st["paid_amt"] = len(paid), float(paid["Məbləğ"].sum())
    st["ins_cnt"], st["ins_amt"] = len(df) - len(paid), st["total_amount"] - st["paid_amt"]

    hc = df.groupby("saat").size()
    st["hour_counts"] = hc.reindex(range(24), fill_value=0)
    st["peak_hour"], st["peak_count"] = int(hc.idxmax()), int(hc.max())

    st["unknown"] = df[df["Silən / Ləğv edən"] == UNKNOWN_USER]
    st["self_late"] = df[df["ozu_sildi"] & (df["ferq_deqiqe"] >= DELAY_HOUR)]
    st["off_hours"] = df[df["is_saatindan_kenar"]]
    st["anomaly"] = df[df["ferq_deqiqe"] < 0]

    per_proto = df.groupby(["Protokol no", "Xəstə"]).agg(n=("Məbləğ", "size"), amt=("Məbləğ", "sum"))
    st["repeat_protocols"] = per_proto[per_proto["n"] >= 3].sort_values("amt", ascending=False).reset_index()

    st["top_services"] = (
        df.groupby("Xidmət adı").agg(n=("Məbləğ", "size"), amt=("Məbləğ", "sum"))
        .sort_values(["n", "amt"], ascending=False).head(5).reset_index()
    )

    st["users"] = (
        df.groupby("Silən / Ləğv edən")
        .agg(
            cnt=("Məbləğ", "size"),
            high=("Risk səviyyəsi", lambda s: int((s == LVL_HIGH).sum())),
            med=("Risk səviyyəsi", lambda s: int((s == LVL_MED).sum())),
            self_late=("ozu_sildi", "sum"),
            avg_delay=("ferq_deqiqe", "median"),
            amt=("Məbləğ", "sum"),
            max_score=("Risk balı", "max"),
        )
        .sort_values(["high", "amt"], ascending=False)
        .reset_index()
    )
    # özü sildiyi — yalnız 1 saatdan gec olanlar
    late_self = st["self_late"].groupby("Silən / Ləğv edən").size()
    st["users"]["self_late"] = st["users"]["Silən / Ləğv edən"].map(late_self).fillna(0).astype(int)

    st["biggest"] = df.loc[df["Məbləğ"].idxmax()]
    return st


def pct_change(cur: float, avg: float) -> float | None:
    return None if avg <= 0 else (cur - avg) / avg * 100


def build_insights(df: pd.DataFrame, st: dict) -> list[str]:
    """Rəqəmlərdən avtomatik, insan dilində əsas müşahidələr."""
    e = html.escape
    out: list[str] = []

    ch = pct_change(st["total_ops"], st["avg_cnt"])
    if ch is not None and abs(ch) >= 20:
        word = "yüksəkdir" if ch > 0 else "aşağıdır"
        out.append(f"Silinmə sayı son {TREND_DAYS} günün ortalamasından (<b>{st['avg_cnt']:.1f}</b>) "
                   f"<b>{abs(ch):.0f}% {word}</b>.")

    if st["high_cnt"]:
        share = st["high_amt"] / st["total_amount"] * 100 if st["total_amount"] else 0
        out.append(f"Ümumi məbləğin <b>{share:.0f}%-i ({money(st['high_amt'])})</b> cəmi "
                   f"<b>{st['high_cnt']} yüksək riskli</b> əməliyyatda cəmlənib.")

    users = st["users"]
    if len(users) > 1:
        top = users.sort_values("cnt", ascending=False).iloc[0]
        share = top["cnt"] / st["total_ops"] * 100
        if share >= 40:
            out.append(f"Əməliyyatların <b>{share:.0f}%-i</b> bir əməkdaşın — <b>{e(str(top['Silən / Ləğv edən']))}</b> "
                       f"— adına düşür ({int(top['cnt'])} əməliyyat, {money(top['amt'])}).")

    if len(st["self_late"]):
        out.append(f"<b>{len(st['self_late'])} xidmət</b> onu əlavə edən əməkdaşın <b>özü tərəfindən 1 saatdan gec</b> "
                   f"silinib ({money(st['self_late']['Məbləğ'].sum())}) — vəzifə bölgüsü nəzarəti tövsiyə olunur.")

    if len(st["off_hours"]):
        out.append(f"<b>{len(st['off_hours'])} əməliyyat</b> iş saatından kənar "
                   f"({WORK_END:02d}:00–{WORK_START:02d}:00) aparılıb ({money(st['off_hours']['Məbləğ'].sum())}).")

    rp = st["repeat_protocols"]
    if len(rp):
        r0 = rp.iloc[0]
        out.append(f"<b>{len(rp)} protokolda</b> 3 və daha çox xidmət silinib (paket/vizit ləğvi). Ən böyüyü: "
                   f"#{e(str(r0['Protokol no']))} — {int(r0['n'])} xidmət, {money(r0['amt'])}.")

    if len(st["anomaly"]):
        out.append(f"<b>{len(st['anomaly'])} qeyddə</b> silinmə tarixi yaradılma tarixindən əvvəldir — məlumat bütövlüyü yoxlanmalıdır.")

    b = st["biggest"]
    out.append(f"Ən böyük tək əməliyyat: <b>{e(str(b['Xidmət adı']))}</b> — {money(b['Məbləğ'])} "
               f"(protokol #{e(str(b['Protokol no']))}, icraçı: {e(str(b['Silən / Ləğv edən']))}).")

    if not st["high_cnt"] and not len(st["self_late"]) and not len(st["unknown"]):
        out.insert(0, "Kritik risk siqnalı aşkarlanmayıb — əməliyyatların əksəriyyəti operativ düzəlişlərdir.")
    return out[:7]


