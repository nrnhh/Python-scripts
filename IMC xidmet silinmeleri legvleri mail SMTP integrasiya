NAVY, BLUE = "102A43", "1E3A8A"
F_TITLE = Font(name="Calibri", size=14, bold=True, color="FFFFFF")
F_HEAD = Font(name="Calibri", size=11, bold=True, color="FFFFFF")
F_BODY = Font(name="Calibri", size=10, color="1E293B")
F_BOLD = Font(name="Calibri", size=10, bold=True, color="1E293B")
F_TOTAL = Font(name="Calibri", size=11, bold=True, color=BLUE)
FILL = lambda c: PatternFill(start_color=c, end_color=c, fill_type="solid")  # noqa: E731
THIN = Side(border_style="thin", color="CBD5E1")
BORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)
CENTER = Alignment(horizontal="center", vertical="center", wrap_text=True)
LEFT = Alignment(horizontal="left", vertical="center")
RIGHT = Alignment(horizontal="right", vertical="center")
MONEY_FMT = '#,##0.00 "₼"'
LEVEL_STYLE = {
    LVL_HIGH: (FILL("FEE2E2"), Font(name="Calibri", size=10, bold=True, color="991B1B")),
    LVL_MED: (FILL("FEF3C7"), Font(name="Calibri", size=10, bold=True, color="92400E")),
    LVL_LOW: (FILL("E0F2FE"), Font(name="Calibri", size=10, color="075985")),
    LVL_OK: (FILL("ECFDF5"), Font(name="Calibri", size=10, color="065F46")),
}

DETAIL_COLS = [
    # (sütun, en, düzləndirmə, format)
    ("Risk balı", 9, CENTER, "0"),
    ("Risk səviyyəsi", 15, CENTER, None),
    ("Protokol no", 13, CENTER, None),
    ("FİN", 11, CENTER, None),
    ("Xəstə", 24, LEFT, None),
    ("Ödəniş növü", 12, CENTER, None),
    ("Qurum", 22, LEFT, None),
    ("Xidmət adı", 34, LEFT, None),
    ("Say", 7, CENTER, "#,##0"),
    ("Qiymət", 12, RIGHT, MONEY_FMT),
    ("Məbləğ", 13, RIGHT, MONEY_FMT),
    ("Yaradılma tarixi", 16, CENTER, None),
    ("Əlavə edən", 22, LEFT, None),
    ("Əməliyyat", 19, CENTER, None),
    ("Əməliyyat tarixi", 16, CENTER, None),
    ("Gecikmə müddəti", 15, CENTER, None),
    ("Silən / Ləğv edən", 22, LEFT, None),
    ("Risk səbəbi", 48, LEFT, None),
]


def _title(ws, text: str, ncols: int, sub: str | None = None) -> None:
    ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=ncols)
    c = ws.cell(row=1, column=1, value=text)
    c.font, c.fill, c.alignment = F_TITLE, FILL(NAVY), CENTER
    ws.row_dimensions[1].height = 30
    if sub:
        ws.merge_cells(start_row=2, start_column=1, end_row=2, end_column=ncols)
        s = ws.cell(row=2, column=1, value=sub)
        s.font = Font(name="Calibri", size=9, italic=True, color="64748B")
        s.alignment = LEFT


def _header(ws, row: int, headers: list[str]) -> None:
    ws.row_dimensions[row].height = 26
    for i, h in enumerate(headers, start=1):
        c = ws.cell(row=row, column=i, value=h)
        c.font, c.fill, c.alignment, c.border = F_HEAD, FILL(BLUE), CENTER, BORDER


def _write_detail_sheet(ws, df: pd.DataFrame, report_date: str) -> None:
    names = [c[0] for c in DETAIL_COLS]
    n = len(names)
    _title(ws, f"SİLİNƏN VƏ LƏĞV EDİLƏN XİDMƏTLƏR — DETALLAR ({report_date})", n,
           "Risk balına görə sıralanıb. Cəmi sətri filtrə uyğun yenilənir (SUBTOTAL).")
    hdr = 3
    _header(ws, hdr, names)

    data = df.sort_values(["Risk balı", "raw_emeliyyat"], ascending=[False, False])[names]
    zebra = FILL("F8FAFC")
    lvl_idx = names.index("Risk səviyyəsi") + 1
    for r_off, row in enumerate(data.itertuples(index=False), start=1):
        r = hdr + r_off
        for c_idx, (val, (_, _, align, fmt)) in enumerate(zip(row, DETAIL_COLS), start=1):
            cell = ws.cell(row=r, column=c_idx, value=val)
            cell.font, cell.border, cell.alignment = F_BODY, BORDER, align
            if fmt:
                cell.number_format = fmt
            if r_off % 2 == 0:
                cell.fill = zebra
        fill, font = LEVEL_STYLE[row[lvl_idx - 1]]
        lc = ws.cell(row=r, column=lvl_idx)
        lc.fill, lc.font = fill, font

    first, last = hdr + 1, hdr + len(data)
    total = last + 1
    ws.row_dimensions[total].height = 24
    for c_idx in range(1, n + 1):
        c = ws.cell(row=total, column=c_idx)
        c.fill, c.font = FILL("EFF6FF"), F_TOTAL
        c.border = Border(top=Side(border_style="medium", color=BLUE),
                          bottom=Side(border_style="double", color=BLUE), left=THIN, right=THIN)
    ws.cell(row=total, column=1, value="CƏMİ").alignment = CENTER
    pc = names.index("Protokol no") + 1
    ws.cell(row=total, column=pc,
            value=f'=SUBTOTAL(103,{get_column_letter(pc)}{first}:{get_column_letter(pc)}{last})&" əməliyyat"'
            ).alignment = CENTER
    for col_name, fmt in (("Say", "#,##0"), ("Məbləğ", MONEY_FMT)):
        ci = names.index(col_name) + 1
        L = get_column_letter(ci)
        c = ws.cell(row=total, column=ci, value=f"=SUBTOTAL(109,{L}{first}:{L}{last})")
        c.number_format, c.alignment = fmt, RIGHT if col_name == "Məbləğ" else CENTER

    for i, (_, width, _, _) in enumerate(DETAIL_COLS, start=1):
        ws.column_dimensions[get_column_letter(i)].width = width
    sc = get_column_letter(names.index("Risk balı") + 1)
    ws.conditional_formatting.add(f"{sc}{first}:{sc}{last}",
                                  DataBarRule(start_type="num", start_value=0, end_type="num", end_value=100,
                                              color="F87171", showValue=True))
    ws.freeze_panes = ws.cell(row=hdr + 1, column=names.index("Xəstə") + 1)
    ws.auto_filter.ref = f"A{hdr}:{get_column_letter(n)}{last}"
    ws.sheet_view.zoomScale = 90
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth, ws.page_setup.fitToHeight = 1, 0
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    ws.print_title_rows = f"{hdr}:{hdr}"


def _write_users_sheet(ws, st: dict, report_date: str) -> None:
    headers = ["Əməkdaş", "Cəmi əməliyyat", "Yüksək risk", "Orta risk", "Özü sildiyi (1 saat+)",
               "Median gecikmə", "Maks. risk balı", "Məbləğ"]
    _title(ws, f"İSTİFADƏÇİLƏR ÜZRƏ İCMAL ({report_date})", len(headers))
    _header(ws, 3, headers)
    for i, r in enumerate(st["users"].itertuples(index=False), start=4):
        vals = [r[0], r.cnt, r.high or None, r.med or None, r.self_late or None,
                format_duration(r.avg_delay), r.max_score, r.amt]
        for c_idx, v in enumerate(vals, start=1):
            c = ws.cell(row=i, column=c_idx, value=v)
            c.font, c.border = F_BODY, BORDER
            c.alignment = LEFT if c_idx == 1 else (RIGHT if c_idx == 8 else CENTER)
        ws.cell(row=i, column=8).number_format = MONEY_FMT
        if r.high:
            ws.cell(row=i, column=3).font = Font(name="Calibri", size=10, bold=True, color="B91C1C")
        if r[0] == UNKNOWN_USER:
            ws.cell(row=i, column=1).font = Font(name="Calibri", size=10, bold=True, color="BE123C")
    for i, w in enumerate([28, 15, 13, 11, 20, 16, 15, 15], start=1):
        ws.column_dimensions[get_column_letter(i)].width = w
    ws.freeze_panes = "B4"


def _write_summary_sheet(ws, df: pd.DataFrame, st: dict, report_date: str) -> None:
    _title(ws, f"RİSK HESABATI — İCMAL ({report_date})", 6,
           f"Tərtib olunub: {datetime.now():%d.%m.%Y %H:%M}")
    for i, w in enumerate([30, 16, 18, 4, 14, 14], start=1):
        ws.column_dimensions[get_column_letter(i)].width = w

    def kv_block(start_row: int, title: str, rows: list[tuple]) -> int:
        _header(ws, start_row, [title, "Say", "Məbləğ"])
        for i, (k, cnt, amt) in enumerate(rows, start=start_row + 1):
            ws.cell(row=i, column=1, value=k).font = F_BOLD
            ws.cell(row=i, column=2, value=cnt).alignment = CENTER
            m = ws.cell(row=i, column=3, value=amt)
            m.number_format, m.alignment = MONEY_FMT, RIGHT
            for c in range(1, 4):
                ws.cell(row=i, column=c).border = BORDER
            if k in LEVEL_STYLE:
                ws.cell(row=i, column=1).fill, ws.cell(row=i, column=1).font = LEVEL_STYLE[k]
        return start_row + len(rows) + 2

    ch_cnt = pct_change(st["total_ops"], st["avg_cnt"])
    r = kv_block(3, "Əsas göstəricilər", [
        ("Cəmi əməliyyat", st["total_ops"], st["total_amount"]),
        (f"{TREND_DAYS} günlük ortalama", round(st["avg_cnt"], 1), st["avg_amt"]),
        ("Ortalamadan fərq", f"{ch_cnt:+.0f}%" if ch_cnt is not None else "—", None),
        ("Unikal pasiyent / vizit", f"{st['patients']} / {st['visits']}", None),
        ("Ödənişli", st["paid_cnt"], st["paid_amt"]),
        ("Sığortalı", st["ins_cnt"], st["ins_amt"]),
    ])
    r = kv_block(r, "Risk səviyyəsi", [
        (LVL_HIGH, st["high_cnt"], st["high_amt"]), (LVL_MED, st["med_cnt"], st["med_amt"]),
        (LVL_LOW, st["low_cnt"], st["low_amt"]), (LVL_OK, st["ok_cnt"], st["ok_amt"]),
    ])
    r = kv_block(r, "Nəzarət siqnalları", [
        ("Özü əlavə edib, 1 saat+ sonra özü silib", len(st["self_late"]), float(st["self_late"]["Məbləğ"].sum())),
        ("İcraçı naməlum", len(st["unknown"]), float(st["unknown"]["Məbləğ"].sum())),
        ("İş saatından kənar", len(st["off_hours"]), float(st["off_hours"]["Məbləğ"].sum())),
        ("Tarix anomaliyası", len(st["anomaly"]), float(st["anomaly"]["Məbləğ"].sum())),
    ])

    # Saatlıq paylanma + qrafik (E-F sütunları)
    _hdr_cells = [("Saat", 5), ("Əməliyyat", 6)]
    for txt, col in _hdr_cells:
        c = ws.cell(row=3, column=col, value=txt)
        c.font, c.fill, c.alignment, c.border = F_HEAD, FILL(BLUE), CENTER, BORDER
    for h in range(24):
        ws.cell(row=4 + h, column=5, value=f"{h:02d}:00").alignment = CENTER
        ws.cell(row=4 + h, column=6, value=int(st["hour_counts"][h])).alignment = CENTER
        for col in (5, 6):
            ws.cell(row=4 + h, column=col).border = BORDER
    chart = BarChart()
    chart.title = "Saatlar üzrə əməliyyatlar"
    chart.y_axis.title, chart.x_axis.title = "Say", "Saat"
    chart.legend = None
    chart.add_data(Reference(ws, min_col=6, min_row=3, max_row=27), titles_from_data=True)
    chart.set_categories(Reference(ws, min_col=5, min_row=4, max_row=27))
    chart.series[0].graphicalProperties.solidFill = "1E3A8A"
    chart.height, chart.width = 7.5, 16
    ws.add_chart(chart, "H3")

    # 7 günlük trend
    _header(ws, r, ["Tarix (trend)", "Əməliyyat", "Məbləğ"])
    for i, (d, cnt, amt) in enumerate(st["trend_days"] + [(None, st["total_ops"], st["total_amount"])], start=r + 1):
        ws.cell(row=i, column=1, value=d.strftime("%d.%m.%Y") if d else f"{report_date} (hesabat günü)")
        ws.cell(row=i, column=2, value=cnt).alignment = CENTER
        m = ws.cell(row=i, column=3, value=amt)
        m.number_format, m.alignment = MONEY_FMT, RIGHT
        for c in range(1, 4):
            ws.cell(row=i, column=c).border = BORDER
        if d is None:
            for c in range(1, 4):
                ws.cell(row=i, column=c).font = F_BOLD
                ws.cell(row=i, column=c).fill = FILL("EFF6FF")
    ws.sheet_view.showGridLines = False


def build_excel(df: pd.DataFrame, st: dict, report_date: str) -> bytes:
    wb = Workbook()
    _write_summary_sheet(wb.active, df, st, report_date)
    wb.active.title = "İcmal"
    _write_detail_sheet(wb.create_sheet("Detallar"), df, report_date)
    _write_users_sheet(wb.create_sheet("İstifadəçilər"), st, report_date)
    wb.properties.creator = SENDER_NAME
    wb.properties.title = f"Silinən xidmətlər risk hesabatı {report_date}"
    buf = io.BytesIO()
    wb.save(buf)
    return buf.getvalue()


