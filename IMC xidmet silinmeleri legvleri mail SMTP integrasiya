def format_duration(mins: float) -> str:
    if pd.isna(mins):
        return "—"
    if mins < 0:
        return "⚠ mənfi"
    mins = int(mins)
    if mins < 60:
        return f"{mins} dəq"
    hours, rem_m = divmod(mins, 60)
    if hours < 24:
        return f"{hours} saat {rem_m} dəq" if rem_m else f"{hours} saat"
    days, rem_h = divmod(hours, 24)
    return f"{days} gün {rem_h} saat" if rem_h else f"{days} gün"


def money(x: float) -> str:
    return f"{x:,.2f} ₼"


def score_row(r) -> tuple[int, str]:
    """
    Şəffaf, bal əsaslı risk modeli (0–100). Köhnə qaydalarla tam uyğundur:
      ≥1 gün + ödənişli / ≥100 ₼           → YÜKSƏK
      ≥1 gün, və ya ≥1 saat + ödənişli + ≥50 ₼ → ORTA
      ≥1 saat                              → AŞAĞI
    üstəlik yeni siqnallar: özü əlavə edib özü silib, naməlum icraçı, iş saatından kənar, tarix anomaliyası.
    """
    mins, amount, paid = r["ferq_deqiqe"], r["Məbləğ"], r["Ödəniş növü"] == PAID
    score, why = 0, []

    if mins >= DELAY_DAY:
        score += 45; why.append(f"{format_duration(mins)} sonra silinib")
    elif mins >= DELAY_HOUR:
        score += 15; why.append(f"{format_duration(mins)} sonra silinib")

    if mins >= DELAY_HOUR:
        if paid:
            score += 20; why.append("ödənişli xidmət")
        if amount >= AMOUNT_HIGH:
            score += 25; why.append(f"yüksək məbləğ (≥{AMOUNT_HIGH} ₼)")
        elif amount >= AMOUNT_MED:
            score += 10; why.append(f"orta məbləğ (≥{AMOUNT_MED} ₼)")
        if r["ozu_sildi"]:
            score += 15; why.append("əlavə edən özü silib")

    if r["Silən / Ləğv edən"] == UNKNOWN_USER:
        score += 15; why.append("icraçı naməlum")
    if r["is_saatindan_kenar"]:
        score += 10; why.append("iş saatından kənar")
    if mins < 0:
        score += 10; why.append("tarix anomaliyası")

    return min(score, 100), "; ".join(why) if why else "—"


def level_for(score: int) -> str:
    if score >= SCORE_HIGH:
        return LVL_HIGH
    if score >= SCORE_MED:
        return LVL_MED
    if score >= SCORE_LOW:
        return LVL_LOW
    return LVL_OK


def enrich_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    if df.empty:
        return df
    df = df.copy()
    df["Say"] = pd.to_numeric(df["Say"], errors="coerce").fillna(0)
    df["Qiymət"] = pd.to_numeric(df["Qiymət"], errors="coerce").fillna(0.0)
    # Say boşdursa/0-dırsa 1 kimi qəbul edilir ki, məbləğ itməsin
    df["Məbləğ"] = df["Qiymət"] * df["Say"].where(df["Say"] > 0, 1)
    df["ferq_deqiqe"] = pd.to_numeric(df["ferq_deqiqe"], errors="coerce").fillna(0.0)
    df["raw_emeliyyat"] = pd.to_datetime(df["raw_emeliyyat"])
    df["gun"] = df["raw_emeliyyat"].dt.date
    df["saat"] = df["raw_emeliyyat"].dt.hour
    df["is_saatindan_kenar"] = (df["saat"] < WORK_START) | (df["saat"] >= WORK_END)
    df["ozu_sildi"] = df["ekul_uid"].notna() & (df["ekul_uid"] == df["dkul_uid"])
    df["Xəstə"] = df["Xəstə"].fillna("").replace("", "—")
    df["Gecikmə müddəti"] = df["ferq_deqiqe"].apply(format_duration)

    scored = df.apply(score_row, axis=1, result_type="expand")
    df["Risk balı"] = scored[0].astype(int)
    df["Risk səbəbi"] = scored[1]
    df["Risk səviyyəsi"] = df["Risk balı"].apply(level_for)
    return df


