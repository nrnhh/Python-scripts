def _h3(num: int, text: str, color: str = "#1e3a8a", bar: str = "#1d4ed8") -> str:
    return (f'<h3 style="color:{color}; font-size:15px; margin:26px 0 10px 0; border-left:4px solid {bar}; '
            f'padding-left:10px; font-family:{FONT};">{num}. {text}</h3>')


def _trend_html(cur: float, avg: float, fmt) -> str:
    ch = pct_change(cur, avg)
    if ch is None:
        return '<span style="color:#94a3b8;">ortalama yoxdur</span>'
    if abs(ch) < 5:
        arrow, color = "≈", "#64748b"
    elif ch > 0:
        arrow, color = "▲", "#dc2626"
    else:
        arrow, color = "▼", "#16a34a"
    return (f'<span style="color:{color}; font-weight:700;">{arrow} {abs(ch):.0f}%</span>'
            f'<span style="color:#94a3b8;"> · ort. {fmt(avg)}</span>')


def _kpi_tile(label: str, value: str, sub: str, accent: str) -> str:
