def run(report_day: date, dry_run: bool, demo: bool, receivers: list[str]) -> None:
    report_date = report_day.strftime("%d.%m.%Y")
    start = datetime.combine(report_day - timedelta(days=TREND_DAYS), datetime.min.time())
    end = datetime.combine(report_day + timedelta(days=1), datetime.min.time())

    logging.info(f"Hesabat günü: {report_date} | trend aralığı: {start:%d.%m} – {report_day:%d.%m} | "
                 f"{'DEMO' if demo else 'FONET'}{' | DRY-RUN' if dry_run else ''}")

    raw = demo_data(report_day) if demo else fetch_data(start, end)
    full = enrich_dataframe(raw)
    if full.empty:
        df, hist = full, full
    else:
        df = full[full["gun"] == report_day].reset_index(drop=True)
        hist = full[full["gun"] != report_day]

    st = compute_stats(df, hist, report_day)
    html_body = build_executive_html(df, st, report_date)
    xlsx = build_excel(df, st, report_date) if len(df) else None
    xlsx_name = f"Risk_Analizi_Silinen_Xidmetler_{report_day:%Y-%m-%d}.xlsx"

    if len(df):
        logging.info(f"{len(df)} əməliyyat | {money(st['total_amount'])} | yüksək: {st['high_cnt']} | orta: {st['med_cnt']}")
    else:
        logging.info("Hesabat günündə silinmə yoxdur.")

    if dry_run:
        os.makedirs(OUT_DIR, exist_ok=True)
        html_path = os.path.join(OUT_DIR, f"preview_{report_day:%Y-%m-%d}.html")
        with open(html_path, "w", encoding="utf-8") as f:
            f.write(html_body)
        logging.info(f"HTML önizləmə: {html_path}")
        if xlsx:
            with open(os.path.join(OUT_DIR, xlsx_name), "wb") as f:
                f.write(xlsx)
            logging.info(f"Excel: {os.path.join(OUT_DIR, xlsx_name)}")
        return

    msg = EmailMessage()
    msg["Subject"] = f"IMC filialı üzrə ({report_date}) xidmət silinməsi və ləğv hesabatı — Risk analizləri ilə birlikdə"
    msg["From"] = formataddr((SENDER_NAME, SENDER_EMAIL))
    msg["To"] = ", ".join(receivers)
    if CC_EMAIL:
        msg["Cc"] = ", ".join(CC_EMAIL)
    msg["Date"] = formatdate(localtime=True)
    msg["Message-ID"] = make_msgid(domain=SENDER_EMAIL.split("@")[-1])
    msg.set_content(
        f"Hörmətli Rəhbərlik,\n\n{report_date} tarixində baş vermiş xidmət silinmələri və ləğv əməliyyatları üzrə "
        f"risk hesabatı əlavə olunur.\n\n"
        + (f"Cəmi: {st['total_ops']} əməliyyat, {money(st['total_amount'])}\n"
           f"Yüksək risk: {st['high_cnt']} | Orta risk: {st['med_cnt']}\n" if len(df) else "Silinmə qeydə alınmayıb.\n")
    )
    msg.add_alternative(html_body, subtype="html")
    if xlsx:
        msg.add_attachment(xlsx, maintype="application",
                           subtype="vnd.openxmlformats-officedocument.spreadsheetml.sheet", filename=xlsx_name)

    logging.info("SMTP serverə qoşulur...")
    smtp_send(msg)
    logging.info(f"Risk məruzəsi göndərildi ({report_date}) -> {', '.join(receivers + CC_EMAIL)}")


# ═══════════════════════════════════════════════════════════════════
#  CƏDVƏL — hər gün SEND_HOUR:SEND_MINUTE (Bakı vaxtı) dünən üzrə hesabat
# ═══════════════════════════════════════════════════════════════════
def baku_now() -> datetime:
    return datetime.now(TIMEZONE)


def read_last_sent() -> date | None:
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            return datetime.strptime(f.read().strip(), "%Y-%m-%d").date()
    except (OSError, ValueError):
        return None


def write_last_sent(d: date) -> None:
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(d.isoformat())
    os.replace(tmp, STATE_FILE)


def run_scheduler() -> None:
    """
    Daimi işləyən rejim (systemd service üçün).
    • Hər gün 12:00-da dünən üzrə hesabat göndərilir.
    • Servis 12:00-dan sonra yenidən başladılarsa və həmin günün hesabatı hələ
      göndərilməyibsə, dərhal göndərilir. Artıq göndərilibsə, təkrar getmir (.last_sent).
    • Xəta olarsa RETRY_EVERY_MIN dəqiqədən bir, gündə ən çox MAX_DAILY_ATTEMPTS dəfə cəhd edilir;
      son cəhd də uğursuz olarsa ALERT_EMAIL-ə xəta bildirişi gedir.
    """
    logging.info(f"Planlayıcı işə düşdü: hər gün {SEND_HOUR:02d}:{SEND_MINUTE:02d} (Asia/Baku) -> "
                 f"{', '.join(RECEIVER_EMAIL)}")
    attempts: dict[date, int] = {}
    next_try: datetime | None = None
    announced: date | None = None

    while True:
        now = baku_now()
        report_day = now.date() - timedelta(days=1)
        send_at = now.replace(hour=SEND_HOUR, minute=SEND_MINUTE, second=0, microsecond=0)
        done = read_last_sent() == report_day
        tries = attempts.get(report_day, 0)

        if (not done and now >= send_at and tries < MAX_DAILY_ATTEMPTS
                and (next_try is None or now >= next_try)):
            attempts[report_day] = tries + 1
            logging.info(f"Göndəriş cəhdi {tries + 1}/{MAX_DAILY_ATTEMPTS} — hesabat günü {report_day:%d.%m.%Y}")
            try:
                run(report_day, dry_run=False, demo=False, receivers=RECEIVER_EMAIL)
                write_last_sent(report_day)
                next_try = None
            except Exception as err:  # noqa: BLE001
                logging.error(f"Göndəriş uğursuz oldu: {err}", exc_info=True)
                if tries + 1 >= MAX_DAILY_ATTEMPTS:
                    send_failure_alert(report_day.strftime("%d.%m.%Y"), err)
                    next_try = None
                else:
                    next_try = baku_now() + timedelta(minutes=RETRY_EVERY_MIN)
                    logging.info(f"Növbəti cəhd: {next_try:%H:%M}")
            continue

        # Növbəti göndəriş vaxtını bir dəfə loga yaz
        nxt = send_at if now < send_at else send_at + timedelta(days=1)
        if announced != nxt.date():
            logging.info(f"Növbəti hesabat: {nxt:%d.%m.%Y %H:%M} ({(nxt - timedelta(days=1)):%d.%m.%Y} üzrə)")
            announced = nxt.date()

        # Uzun yuxu əvəzinə ən çox 60 san — saat dəyişikliyi / server yuxusu təhlükəsiz olsun
        target = next_try if (next_try and not done) else nxt
        time.sleep(max(1.0, min(60.0, (target - baku_now()).total_seconds())))


def main() -> int:
    p = argparse.ArgumentParser(description="FONET silinən/ləğv edilən xidmətlər üzrə risk məruzəsi")
    p.add_argument("--once", action="store_true", help="Planlayıcısız, dərhal bir dəfə göndər (dünən üzrə)")
    p.add_argument("--date", help="Hesabat günü (YYYY-MM-DD) — dərhal bir dəfə göndərir")
    p.add_argument("--dry-run", action="store_true", help="Email göndərmə, ./out/ qovluğuna yaz")
    p.add_argument("--demo", action="store_true", help="Bazaya qoşulma, nümunə məlumat istifadə et")
    p.add_argument("--to", help="Alıcıları müvəqqəti əvəzlə (vergüllə)")
    args = p.parse_args()

    setup_logging()

    # Heç bir parametr yoxdursa — daimi planlayıcı rejimi (systemd)
    if not (args.once or args.date or args.dry_run or args.demo or args.to):
        try:
            run_scheduler()
        except KeyboardInterrupt:
            logging.info("Planlayıcı dayandırıldı.")
        return 0

    report_day = (datetime.strptime(args.date, "%Y-%m-%d").date() if args.date
                  else baku_now().date() - timedelta(days=1))
    receivers = [x.strip() for x in args.to.split(",")] if args.to else RECEIVER_EMAIL

    try:
        run(report_day, args.dry_run, args.demo, receivers)
        return 0
    except Exception as err:  # noqa: BLE001
        logging.error(f"Xəta baş verdi: {err}", exc_info=True)
        if not args.dry_run:
            send_failure_alert(report_day.strftime("%d.%m.%Y"), err)
        return 1


if __name__ == "__main__":
    sys.exit(main())
