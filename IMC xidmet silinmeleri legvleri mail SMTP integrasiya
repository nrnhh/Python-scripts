      <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
             style="background:#ffffff; border:1px solid #e2e8f0; border-top:3px solid {accent}; border-radius:6px;">
        <tr><td style="padding:12px 12px 4px; font-size:11px; color:#64748b; font-weight:700; text-transform:uppercase; letter-spacing:.4px;">{label}</td></tr>
        <tr><td style="padding:0 12px; font-size:20px; font-weight:800; color:#0f172a; white-space:nowrap;">{value}</td></tr>
        <tr><td style="padding:4px 12px 12px; font-size:11px;">{sub}</td></tr>
      </table>
    </td>"""


def _hour_bars(st: dict) -> str:
    hc = st["hour_counts"]
    active = [h for h in range(24) if hc[h] > 0]
    if not active:
        return ""
    mx = max(hc)
    rows = ""
    for h in range(min(active), max(active) + 1):
        n = int(hc[h])
        w = max(round(n / mx * 100), 1) if n else 0
        off = h < WORK_START or h >= WORK_END
        color = "#d97706" if h == st["peak_hour"] else ("#e11d48" if off else "#3b82f6")
        bar = (f'<table width="100%" cellpadding="0" cellspacing="0" role="presentation"><tr>'
               f'<td width="{w}%" height="12" bgcolor="{color}" style="background:{color}; border-radius:3px; font-size:0; line-height:0;">&nbsp;</td>'
               f'<td style="font-size:0;">&nbsp;</td></tr></table>') if n else ""
        rows += (f'<tr><td width="52" style="font-size:11px; color:#64748b; padding:2px 6px 2px 0;">{h:02d}:00</td>'
                 f'<td style="padding:2px 0;">{bar}</td>'
                 f'<td width="34" align="right" style="font-size:11px; color:#334155; font-weight:700; padding:2px 0 2px 6px;">{n or ""}</td></tr>')
    legend = ('<span style="color:#d97706;">■</span> pik saat &nbsp; '
              '<span style="color:#e11d48;">■</span> iş saatından kənar &nbsp; '
              '<span style="color:#3b82f6;">■</span> iş saatı')
    return (f'<table width="100%" cellpadding="0" cellspacing="0" role="presentation">{rows}</table>'
            f'<div style="font-size:11px; color:#64748b; margin-top:6px;">{legend}</div>')


def _risk_cards(sub: pd.DataFrame, limit: int, border: str, badge_bg: str, badge_fg: str) -> str:
    e = html.escape
    sub = sub.sort_values("Risk balı", ascending=False)
    grouped = (
        sub.groupby(["Protokol no", "Xəstə", "Ödəniş növü", "Qurum", "Silən / Ləğv edən"], dropna=False, sort=False)
        .agg(
            n=("Xidmət adı", "count"),
            svc=("Xidmət adı", lambda s: ", ".join(list(dict.fromkeys(s))[:3]) + (" …" if s.nunique() > 3 else "")),
            max_delay=("ferq_deqiqe", "max"),
            amt=("Məbləğ", "sum"),
            score=("Risk balı", "max"),
            why=("Risk səbəbi", "first"),
        )
        .sort_values(["score", "amt"], ascending=False)
        .reset_index()
    )
    out = ""
    for _, r in grouped.head(limit).iterrows():
        label = PAID if r["Ödəniş növü"] == PAID else f"Sığortalı · {r['Qurum']}"
        out += f"""
        <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
               style="margin-bottom:8px; background:#ffffff; border:1px solid #e2e8f0; border-left:4px solid {border}; border-radius:6px;">
          <tr>
            <td style="padding:10px 14px 2px; font-size:13.5px; color:#0f172a;">
              <b>Protokol #{e(str(r['Protokol no']))}</b> — {e(str(r['Xəstə']))}
              <span style="background:{badge_bg}; color:{badge_fg}; padding:2px 7px; border-radius:4px; font-size:11px; font-weight:700; white-space:nowrap;">{e(label)}</span>
            </td>
            <td align="right" valign="top" style="padding:10px 14px 2px; font-size:14px; font-weight:800; color:#0f172a; white-space:nowrap;">{money(r['amt'])}</td>
          </tr>
          <tr><td colspan="2" style="padding:3px 14px 10px; font-size:12px; color:#475569; line-height:1.55;">
              <b>{int(r['n'])} xidmət</b> ({e(str(r['svc']))}) • Gecikmə: <b>{format_duration(r['max_delay'])}</b>
              • İcraçı: <b>{e(str(r['Silən / Ləğv edən']))}</b> • Bal: <b style="color:{border};">{int(r['score'])}</b><br>
              <span style="color:#94a3b8;">Səbəb: {e(str(r['why']))}</span>
          </td></tr>
        </table>"""
    rest = len(grouped) - limit
    if rest > 0:
        out += f'<div style="font-size:12px; color:#64748b; margin:2px 0 4px;">+ daha {rest} protokol — tam siyahı Excel-in <b>Detallar</b> vərəqindədir.</div>'
    return out


